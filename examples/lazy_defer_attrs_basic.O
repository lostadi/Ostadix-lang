#!/usr/bin/env O
# STEP-3.5: the {lazy} and {defer} block attributes.
#
# Both capture a block's body as a thunk instead of executing it. They
# differ on caching:
#   {lazy}  — cache-safe inline backends only (html, markdown, latex, text);
#             cached by fingerprint; auto-forces on splice
#   {defer} — any backend; never cached; errors on splice (must now() first)
#
# {lazy} is a cache-safety contract, not a purity claim about a source
# language. Shim-backed backends (nix, sql, haskell, ocaml, webassembly,
# python, …) run arbitrary programs against external state the fingerprint
# does not capture, so the runtime rejects `lang{lazy}` for them and
# suggests `lang{defer}` instead.
#
# Compare with `nix_expr^` which is its own typed lazy rung in the Nix
# pipeline (returns ONixExpr, feeds into instantiate/realise). The generic
# {lazy}/{defer} mechanism produces a Request[Eval] whose forced result is
# whatever evaluation returned — an OInt, OList, OStr, etc.
#
# This example DOES NOT force anything (no shim subprocess is spawned). It
# just constructs three thunks and uses the third as the document's final
# value, which the runtime prints via Debug. On a machine with Python
# installed, you can replace the final expression with
#   now($py_defer)
# to actually fire the shim.

let txt_lazy = text{lazy}^( 1 + 2 + 3 )_text{lazy}
# txt_lazy : Request[Eval{lang=text, cacheable=true}]
# Nothing has executed; txt_lazy is the unforced thunk. text is an inline
# representation handler assembled deterministically by the runtime itself,
# so caching its result is sound.

let md_lazy = markdown{lazy}^( **rendered** later )_markdown{lazy}
# md_lazy : Request[Eval{lang=markdown, cacheable=true}]
# markdown is a cache-safe inline backend in the registry, so {lazy} is
# valid here.

let py_defer = python{defer}^( import time; time.time() )_python{defer}
# py_defer : Request[Eval{lang=python, cacheable=false}]
# python is impure (clock, IO, mutable state), so {defer} is the right
# attribute — every force re-runs and produces a fresh value.
# The same applies to nix: `nix{defer}^( ... )_nix{defer}` defers a raw Nix
# evaluation without caching; `nix{lazy}` is rejected because current Nix
# execution can observe filesystem/environment state.

# The document's last expression is the {defer} request itself, which the
# runtime prints via Debug. Three Request values constructed, none forced.
$py_defer

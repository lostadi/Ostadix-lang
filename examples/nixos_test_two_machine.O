#!/usr/bin/env O
# Milestone F — two-machine NixOS test (server + client) inside an O-lang script.
#
# Run: cargo run -- examples/nixos_test_two_machine.O
#
# The client VM fetches a page from the server VM over the virtual network.
# Results are rendered as HTML.

let lab = nixos_test^({
  name = "o-nixos-two-machine";
  nodes.server = { pkgs, ... }: {
    networking.firewall.allowedTCPPorts = [ 80 ];
    services.nginx = {
      enable = true;
      # Explicit vhost required: bare `enable = true` yields no listen sockets
      # on current nixpkgs (empty virtualHosts), so cross-VM curl gets exit 7.
      virtualHosts.localhost = {
        default = true;
        locations."/".return = "200 'Welcome to nginx'";
      };
    };
  };

  nodes.client = { pkgs, ... }: {
    environment.systemPackages = [ pkgs.curl ];
  };

  testScript = ''
    start_all()
    server.wait_for_unit("nginx.service")
    server.wait_for_open_port(80)
    result = client.wait_until_succeeds("curl -sf http://server/")
    assert "nginx" in result.lower(), f"unexpected page: {result!r}"
  '';
})_nixos_test

html^(
<!doctype html>
<html>
  <body>
    <h1>Two-machine NixOS test</h1>
    <section>
      $lab
    </section>
  </body>
</html>
)_html

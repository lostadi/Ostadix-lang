#!/usr/bin/env O
# Milestone E — single-machine NixOS test inside an O-lang script.
#
# Run: cargo run -- examples/nixos_test.O
#
# Requirements: Nix with KVM/QEMU (or software emulation).
# The nixos_test^(...)_nixos_test block builds a real NixOS VM, boots it,
# runs the testScript assertions, and returns structured results.

let lab = nixos_test^({
  name = "o-nixos-basic";
  nodes.machine = { pkgs, ... }: {
    environment.systemPackages = [ pkgs.curl ];
    services.nginx = {
      enable = true;
      # Current nixpkgs does not materialize the documented default vhost when
      # only `enable = true` is set — without an explicit virtualHost nginx
      # starts with no listen sockets and curl fails (exit 7).
      virtualHosts.localhost = {
        default = true;
        locations."/".return = "200 'Welcome to nginx'";
      };
    };
  };

  testScript = ''
    machine.start()
    machine.wait_for_unit("nginx.service")
    machine.wait_for_open_port(80)
    machine.succeed("curl -sf http://127.0.0.1 | grep -i nginx")
  '';
})_nixos_test

html^(
<!doctype html>
<html>
  <body>
    <h1>NixOS test result</h1>
    <p>Success: $lab</p>
  </body>
</html>
)_html

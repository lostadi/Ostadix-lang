static mut ARENA_STORAGE: [u64; 16] = [0; 16];
static mut ARENA_BYTES: [u8; 4096] = [0; 4096];
static mut ARENA_NODES: [u64; 1536] = [0; 1536];
static mut ARENA_EDGES: [u64; 128] = [0; 128];
static mut DECODED_STORAGE: [u64; 16] = [0; 16];
static mut DECODED_BYTES: [u8; 4096] = [0; 4096];
static mut DECODED_NODES: [u64; 1536] = [0; 1536];
static mut DECODED_EDGES: [u64; 128] = [0; 128];
static mut TEMP_STORAGE: [u64; 16] = [0; 16];
static mut TEMP_BYTES: [u8; 4096] = [0; 4096];
static mut TEMP_NODES: [u64; 1536] = [0; 1536];
static mut TEMP_EDGES: [u64; 512] = [0; 512];
static mut SECOND_TEMP_STORAGE: [u64; 16] = [0; 16];
static mut SECOND_TEMP_BYTES: [u8; 4096] = [0; 4096];
static mut SECOND_TEMP_NODES: [u64; 1536] = [0; 1536];
static mut SECOND_TEMP_EDGES: [u64; 128] = [0; 128];
static mut SECOND_OUTPUT_STORAGE: [u64; 16] = [0; 16];

module kernel::m3_live;

use runtime::address_space::create_native_for_owner;
use runtime::address_space::destroy as destroy_address_space;
use runtime::address_space::dynamic_protections_hold;
use runtime::address_space::isolation_physical;
use runtime::address_space::native_stack_top_for;
use runtime::address_space::root_cr3;

use runtime::capability::OBJECT_DEBUG;
use runtime::capability::OBJECT_ENDPOINT;
use runtime::capability::RIGHT_DEBUG_WRITE;
use runtime::capability::RIGHT_ENDPOINT_CANCEL;
use runtime::capability::RIGHT_ENDPOINT_RECEIVE;
use runtime::capability::RIGHT_ENDPOINT_SEND;
use runtime::domain::child_refs as domain_child_refs;
use runtime::domain::create_domain;
use runtime::domain::destroy_domain;

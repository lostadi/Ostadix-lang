module kernel::main;

use kernel::m1::start as start_m1;
use kernel::m2::start as start_m2;
use kernel::m3::start as start_m3;
use kernel::m3_live::start as start_m3_live;
use kernel::m4::start as start_m4;
use kernel::m5::start as start_m5;
use kernel::m5_semantics::start as start_m5_semantics;
use kernel::m6::start as start_m6;
use kernel::m6b_semantics::start as start_m6b_semantics;
use kernel::kernel_world_semantics::start as start_kernel_world_semantics;
use runtime::capability::init as capabilities_init;
use runtime::capability::close_in_cspace;
use runtime::capability::install_in_cspace;
use runtime::capability::OBJECT_DEBUG;
use runtime::capability::OBJECT_PAGE_POOL;
use runtime::capability::RIGHT_DEBUG_WRITE;
use runtime::capability::RIGHT_PAGE_ALLOC;
use runtime::capability::RIGHT_TRANSFER;
use runtime::address_space::allows;
use runtime::address_space::install_bootstrap as install_address_space;
use runtime::address_space::root_cr3;
use runtime::address_space::VM_EXEC;
use runtime::address_space::VM_READ;
use runtime::address_space::VM_STACK;
use runtime::address_space::VM_USER;
use runtime::address_space::VM_WRITE;
use runtime::domain::init as domains_init;
use runtime::domain::DOMAIN_NATIVE_0;
use runtime::interrupts::init as interrupts_init;
use runtime::pages::init as pages_init;
use runtime::pages::invariants_hold as page_invariants_hold;
use runtime::pages::test_exhaustion_and_reclaim;
use runtime::pages::test_injected_failure;
use runtime::pages::test_stale_and_double_free;
use runtime::pages::test_zero_reuse;
use runtime::memory_object::init as memory_objects_init;
use runtime::memory_object::self_test as memory_objects_self_test;
use runtime::memory_object::set_quota as set_memory_quota;
use runtime::mapping::init as mappings_init;
use runtime::mapping::invariants_hold as mapping_invariants_hold;
use runtime::endpoint::init as endpoints_init;
use runtime::cap_transfer::init as cap_transfers_init;
use runtime::ipc_wait::init as ipc_waits_init;
use runtime::process::init as processes_init;
use runtime::process::install as install_process;
use runtime::process::activate_bootstrap;
use runtime::serial::init as serial_init;
use runtime::serial::write;
use runtime::scheduler::init as scheduler_init;
use runtime::trap::configure_probe;
use runtime::user::entry_for_probe;
use runtime::user_memory::COPY_FAULT;
use runtime::user_memory::valid_entry;
use runtime::user_memory::valid_stack_top;
use runtime::user_memory::USER_IMAGE_START;
use runtime::user_memory::USER_STACK_GUARD_START;
use runtime::user_memory::USER_STACK_START;
use runtime::user_memory::USER_STACK_TOP;

extern "sysv64" fn ocore_syscall_init() -> void;
extern "sysv64" fn ocore_kernel_stack_top() -> usize;
extern "sysv64" fn ocore_current_cr3() -> usize;
extern "sysv64" fn ocore_boot_protection_check() -> u64;
extern "sysv64" fn ocore_boot_probe_mode() -> u64;
extern "sysv64" fn ocore_copy_from_user(
    destination: *mut u8,
    source: *const u8,
    length: usize
) -> u64;
extern "sysv64" fn ocore_copy_to_user(
    destination: *mut u8,
    source: *const u8,
    length: usize
) -> u64;
extern "sysv64" fn ocore_enter_user(
    entry: usize,
    stack: usize,
    arg0: u64
) -> never;

static START_MESSAGE: [u8; 29] = b"O-core kernel: serial online\n";
static PAGE_MESSAGE: [u8; 23] = b"page allocator: online\n";
static CAP_MESSAGE: [u8; 19] = b"capability: online\n";
static ADDRESS_SPACE_MESSAGE: [u8; 22] = b"address space: online\n";
static COPY_MESSAGE: [u8; 28] = b"user copy faults: recovered\n";
static ENTRY_MESSAGE: [u8; 30] = b"entry state: CPU-local online\n";
static PROBE_MESSAGE: [u8; 22] = b"M02 probe: armed CPL3\n";
static PROTECTION_MESSAGE: [u8; 29] = b"page protections: W^X online\n";
static FRAME_RECLAIM_MESSAGE: [u8; 25] = b"M03 frames: reclaim PASS\n";
static FRAME_ZERO_MESSAGE: [u8; 28] = b"M03 frames: zero-reuse PASS\n";
static FRAME_STALE_MESSAGE: [u8; 37] = b"M03 frames: stale-double-free denied\n";
static FRAME_FAILURE_MESSAGE: [u8; 43] = b"M03 frames: injected-failure rollback PASS\n";
static MEMORY_OBJECT_MESSAGE: [u8; 42] = b"M03 memory objects: typed-generation PASS\n";
static mut COPY_PROBE: [u8; 8] = [0; 8];

const NATIVE_CSPACE: usize = 0;
const SELF_TEST_CSPACE: usize = 3;

// The linked negative CPL3 probe takes this address without reading it and
// passes the address to SYS_DEBUG_WRITE. Correct user-range validation rejects
// it before serial::write can dereference the supervisor mapping.
@export
@no_mangle
pub static OCORE_KERNEL_ONLY_MARKER: [u8; 22] = b"KERNEL POINTER LEAKED\n";

unsafe fn fail_closed() -> never {
    disable_interrupts();
    loop {
        halt();
    }
}

@export
@no_mangle
@link_section(".text.kernel")
pub unsafe fn kernel_main(multiboot_info: usize) -> never {
    serial_init();
    write((&START_MESSAGE[0]), 29);
    if ocore_boot_protection_check() != 1 {
        fail_closed();
    }
    write((&PROTECTION_MESSAGE[0]), 29);
    let probe_mode: u64 = ocore_boot_probe_mode();

    // This fixed QEMU bootstrap window is mapped supervisor RW/NX and excludes
    // both the kernel image and linked user regions. General firmware memory
    // discovery and arbitrary reservation remain outside this bounded slice.
    if pages_init(0x00400000, 0x01000000) == 0
        || pages_init(0x00400000, 0x01000000) != 0
        || !page_invariants_hold() {
        fail_closed();
    }
    write((&PAGE_MESSAGE[0]), 23);
    if probe_mode == 0 {
        if test_exhaustion_and_reclaim() == 0 {
            fail_closed();
        }
        write((&FRAME_RECLAIM_MESSAGE[0]), 25);
        if test_zero_reuse() == 0 {
            fail_closed();
        }
        write((&FRAME_ZERO_MESSAGE[0]), 28);
        if test_stale_and_double_free() == 0 {
            fail_closed();
        }
        write((&FRAME_STALE_MESSAGE[0]), 37);
        if test_injected_failure() == 0 {
            fail_closed();
        }
        write((&FRAME_FAILURE_MESSAGE[0]), 43);
    }

    let domain_handle: u64 = domains_init();
    if domain_handle != DOMAIN_NATIVE_0 {
        fail_closed();
    }
    if processes_init() == 0 || processes_init() != 0 {
        fail_closed();
    }
    scheduler_init();
    if capabilities_init() == 0 || capabilities_init() != 0 {
        fail_closed();
    }
    if memory_objects_init() == 0 || memory_objects_init() != 0 {
        fail_closed();
    }
    if mappings_init() == 0
        || mappings_init() != 0
        || !mapping_invariants_hold() {
        fail_closed();
    }
    if endpoints_init() == 0
        || endpoints_init() != 0
        || cap_transfers_init() == 0
        || cap_transfers_init() != 0
        || ipc_waits_init() == 0
        || ipc_waits_init() != 0 {
        fail_closed();
    }
    if probe_mode == 0 {
        if memory_objects_self_test(SELF_TEST_CSPACE) == 0 {
            fail_closed();
        }
        write((&MEMORY_OBJECT_MESSAGE[0]), 42);
    }
    if set_memory_quota(NATIVE_CSPACE, 2) == 0 {
        fail_closed();
    }

    let active_cr3: usize = ocore_current_cr3();
    let address_space_id: u64 = install_address_space(active_cr3);
    if address_space_id == 0 || root_cr3(address_space_id) != active_cr3 {
        fail_closed();
    }
    if !allows(
        address_space_id,
        USER_IMAGE_START,
        1,
        VM_USER | VM_READ | VM_EXEC
    ) || allows(
        address_space_id,
        USER_IMAGE_START,
        1,
        VM_USER | VM_WRITE
    ) || !allows(
        address_space_id,
        USER_STACK_START,
        1,
        VM_USER | VM_READ | VM_WRITE | VM_STACK
    ) || allows(
        address_space_id,
        USER_STACK_START,
        1,
        VM_USER | VM_EXEC
    ) || allows(
        address_space_id,
        USER_STACK_GUARD_START,
        1,
        VM_USER | VM_READ
    ) || allows(
        address_space_id,
        0x011ffff8,
        16,
        VM_USER | VM_READ
    ) || allows(
        address_space_id,
        USER_IMAGE_START,
        0xffffffffffffffff,
        VM_USER | VM_READ
    ) {
        fail_closed();
    }
    write((&ADDRESS_SPACE_MESSAGE[0]), 22);

    // Modes 10 and 11 are the bounded Milestone 1 lifecycle boots. They use
    // the pinned bootstrap CR3 only as the no-process management context and
    // install their own generation-safe process, CSpace, and address-space
    // identities before entering CPL3.
    if probe_mode == 10 || probe_mode == 11 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        ocore_syscall_init();
        start_m1(probe_mode, domain_handle);
    }
    if probe_mode == 12 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        ocore_syscall_init();
        start_m2(probe_mode, domain_handle);
    }
    if probe_mode == 13 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        ocore_syscall_init();
        start_m3(probe_mode, domain_handle);
    }
    if probe_mode == 14 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        ocore_syscall_init();
        start_m3_live(probe_mode, domain_handle);
    }
    if probe_mode == 15 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        ocore_syscall_init();
        start_m4(probe_mode, domain_handle);
    }
    if probe_mode == 16 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        ocore_syscall_init();
        start_m5(probe_mode, domain_handle);
    }
    if probe_mode == 17 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        start_m5_semantics(probe_mode);
    }
    if probe_mode == 18 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        ocore_syscall_init();
        start_m6(probe_mode, domain_handle);
    }
    if probe_mode == 19 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        start_m6b_semantics(probe_mode, domain_handle, address_space_id);
    }
    if probe_mode == 24 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        ocore_syscall_init();
        start_m6(probe_mode, domain_handle);
    }
    if probe_mode == 25 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        ocore_syscall_init();
        start_m6(probe_mode, domain_handle);
    }
    if probe_mode == 20 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        start_kernel_world_semantics(probe_mode);
    }
    if probe_mode == 21 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        start_kernel_world_semantics(probe_mode);
    }
    if probe_mode == 22 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        start_kernel_world_semantics(probe_mode);
    }
    if probe_mode == 23 {
        if configure_probe(probe_mode) == 0 {
            fail_closed();
        }
        interrupts_init();
        start_kernel_world_semantics(probe_mode);
    }

    let kernel_stack_top: usize = ocore_kernel_stack_top();
    if configure_probe(probe_mode) == 0 {
        fail_closed();
    }
    let user_entry: usize = entry_for_probe(probe_mode);
    if !valid_entry(user_entry) || !valid_stack_top(USER_STACK_TOP) {
        fail_closed();
    }
    if install_process(
        0,
        1,
        DOMAIN_NATIVE_0,
        address_space_id,
        NATIVE_CSPACE,
        kernel_stack_top,
        user_entry,
        USER_STACK_TOP
    ) == 0 {
        fail_closed();
    }

    let report_capability: u64 = install_in_cspace(
        NATIVE_CSPACE,
        1,
        1,
        OBJECT_DEBUG,
        RIGHT_DEBUG_WRITE
    );
    let stale_probe_capability: u64 = install_in_cspace(
        NATIVE_CSPACE,
        2,
        2,
        OBJECT_DEBUG,
        RIGHT_DEBUG_WRITE
    );
    if stale_probe_capability != 0x0000_0001_0000_0002 {
        fail_closed();
    }
    if close_in_cspace(NATIVE_CSPACE, stale_probe_capability) == 0 {
        fail_closed();
    }
    // Reuse the same slot with a new generation before CPL3 starts. The user
    // probe presents the old generation while the replacement is live, which
    // distinguishes stale-handle rejection from an empty-slot check.
    let replacement_capability: u64 = install_in_cspace(
        NATIVE_CSPACE,
        2,
        3,
        OBJECT_DEBUG,
        RIGHT_DEBUG_WRITE
    );
    let wrong_rights_capability: u64 = install_in_cspace(
        NATIVE_CSPACE,
        3,
        4,
        OBJECT_DEBUG,
        RIGHT_TRANSFER
    );
    let wrong_type_capability: u64 = install_in_cspace(
        NATIVE_CSPACE,
        4,
        5,
        OBJECT_PAGE_POOL,
        RIGHT_PAGE_ALLOC
    );
    let close_probe_capability: u64 = install_in_cspace(
        NATIVE_CSPACE,
        5,
        6,
        OBJECT_DEBUG,
        RIGHT_DEBUG_WRITE
    );
    if report_capability == 0
        || replacement_capability != 0x0000_0002_0000_0002
        || wrong_rights_capability != 0x0000_0001_0000_0003
        || wrong_type_capability != 0x0000_0001_0000_0004
        || close_probe_capability != 0x0000_0001_0000_0005 {
        fail_closed();
    }
    // The process becomes current only after its immutable PCB and cspace are
    // complete, so no syscall can observe a partially initialized identity.
    if activate_bootstrap(0) == 0 {
        fail_closed();
    }
    // A second activation would imply switching PCB/CSpace state without the
    // matching CR3, TSS, and entry-stack transaction, so it must be rejected.
    if activate_bootstrap(0) != 0 {
        fail_closed();
    }
    write((&CAP_MESSAGE[0]), 19);

    interrupts_init();
    ocore_syscall_init();

    let copy_from_result: u64 = ocore_copy_from_user(
        (&mut COPY_PROBE[0]),
        USER_STACK_GUARD_START as *const u8,
        1
    );
    let copy_to_result: u64 = ocore_copy_to_user(
        USER_STACK_GUARD_START as *mut u8,
        (&COPY_PROBE[0]),
        1
    );
    if copy_from_result != COPY_FAULT || copy_to_result != COPY_FAULT {
        fail_closed();
    }
    write((&COPY_MESSAGE[0]), 28);
    write((&ENTRY_MESSAGE[0]), 30);
    if probe_mode != 0 {
        write((&PROBE_MESSAGE[0]), 22);
    }

    ocore_enter_user(user_entry, USER_STACK_TOP, report_capability);
}

extern "sysv64" fn ocore_kernel_world_record_start() -> usize;
extern "sysv64" fn ocore_kernel_world_record_end() -> usize;

unsafe fn fail_closed() -> never {
    disable_interrupts();
    loop {
        halt();
    }
}

unsafe fn record_text_equals(
    address: usize,
    length: usize,
    expected: *const u8,
    expected_length: usize
) -> bool {
    if address == 0 || expected as usize == 0 || length != expected_length {
        return false;
    }
    let mut byte: usize = 0;
    while byte < length {
        if volatile_load((address + byte) as *const u8)
            != volatile_load(expected + byte) {
            return false;
        }
        byte += 1;
    }
    return true;
}

unsafe fn record_requirement_equals(
    ordinal: usize,
    expected: *const u8,
    expected_length: usize
) -> bool {
    return record_text_equals(
        record_requirement_address(ordinal),
        record_requirement_length(ordinal),
        expected,
        expected_length
    );
}

// Mode 21 is AMD SVM/NPT-specific. The exact hash-pinned record that produced
// the admitted world must name that backend contract; the prior fixture named
// VMX even though no VMX executor exists. A hash or requirement count alone is
// insufficient, so this check compares every retained byte.
unsafe fn record_matches_svm_npt_backend() -> bool {
    return record_execution() == EXECUTION_HARDWARE_VIRTUALIZED
        && record_requirement_count() == 2
        && record_requirement_equals(0, (&REQUIREMENT_NPT[0]), 3)
        && record_requirement_equals(1, (&REQUIREMENT_SVM[0]), 3)
        && !record_requirement_equals(0, (&REQUIREMENT_VMX[0]), 3)
        && !record_requirement_equals(1, (&REQUIREMENT_VMX[0]), 3);
}

unsafe fn build_noncanonical_record(source: *const u8) -> bool {
    if source as usize == 0 { return false; }
    let mut byte: usize = 0;
    while byte < RECORD_LENGTH {
        NONCANONICAL_RECORD[byte] = volatile_load(source + byte);
        byte += 1;
    }
    byte = 0;
    while byte < 11 {
        if NONCANONICAL_RECORD[RECORD_LENGTH - 11 + byte]
            != CANONICAL_RIGHTS_TAIL[byte] {
            return false;
        }
        NONCANONICAL_RECORD[RECORD_LENGTH - 11 + byte] =
            NONCANONICAL_RIGHTS_TAIL[byte];
        byte += 1;
    }
    return true;
}

unsafe fn begin_from_record() -> u64 {
    return begin_admission(
        record_package_digest_word(0),
        record_package_digest_word(1),
        record_package_digest_word(2),
        record_package_digest_word(3),
        record_manifest_digest_word(0),
        record_manifest_digest_word(1),
        record_manifest_digest_word(2),
        record_manifest_digest_word(3),
        record_integration(),
        record_execution(),
        record_firmware(),
        record_world_id(),
        record_world_id(),
        record_version_id(),
        record_architecture_id(),
        record_profile_id(),
        record_health_id(),
        record_health_timeout(),
        record_restart_policy(),
        record_min_vcpus() as usize,
        record_max_vcpus() as usize,
        record_min_memory_mib(),
        record_max_memory_mib(),
        record_max_outstanding(),
        record_max_requests_per_generation(),
        record_max_shared_bytes(),
        record_max_devices() as usize,
        record_export_count(),
        record_request_count()
    );
}

unsafe fn define_from_record(admission: u64) -> bool {
    let mut ordinal: usize = 0;
    while ordinal < record_export_count() {
        if define_admission_export(
            admission,
            ordinal,
            record_export_name(ordinal),
            record_export_plane(ordinal),
            record_export_protocol(ordinal),
            record_export_authority_address(ordinal) as *const u8,
            record_export_authority_length(ordinal)
        ) != 1 {
            return false;
        }
        ordinal += 1;
    }
    ordinal = 0;
    while ordinal < record_request_count() {
        if define_admission_request(
            admission,
            ordinal,
            record_request_kind_address(ordinal) as *const u8,
            record_request_kind_length(ordinal),
            record_request_purpose_address(ordinal) as *const u8,
            record_request_purpose_length(ordinal),
            record_request_rights(ordinal)
        ) != 1 {
            return false;
        }
        ordinal += 1;
    }
    return true;
}

unsafe fn define_wrong_authority_from_record(admission: u64) -> bool {
    let mut ordinal: usize = 0;
    while ordinal < record_export_count() {
        let mut authority: *const u8 =
            record_export_authority_address(ordinal) as *const u8;
        let mut authority_length: usize =
            record_export_authority_length(ordinal);
        if record_export_plane(ordinal) == EXPORT_PLANE_DEVICE {
            authority = (&POLICY_DEVICE_AUDIO[0]);
            authority_length = 12;
        }
        if define_admission_export(
            admission,
            ordinal,
            record_export_name(ordinal),
            record_export_plane(ordinal),
            record_export_protocol(ordinal),
            authority,
            authority_length
        ) != 1 {
            return false;
        }
        ordinal += 1;
    }
    ordinal = 0;
    while ordinal < record_request_count() {
        // Cross-kind rights must fail without mutating the staged request.
        let mut invalid_rights: u64 = RIGHT_DEVICE_RESET;
        if ordinal == 0 {
            invalid_rights = RIGHT_VM_RUN;
        }
        if define_admission_request(
            admission,
            ordinal,
            record_request_kind_address(ordinal) as *const u8,
            record_request_kind_length(ordinal),
            record_request_purpose_address(ordinal) as *const u8,
            record_request_purpose_length(ordinal),
            invalid_rights
        ) != 0 {
            return false;
        }
        if define_admission_request(
            admission,
            ordinal,
            record_request_kind_address(ordinal) as *const u8,
            record_request_kind_length(ordinal),
            record_request_purpose_address(ordinal) as *const u8,
            record_request_purpose_length(ordinal),
            record_request_rights(ordinal)
        ) != 1 {
            return false;
        }
        ordinal += 1;
    }
    return true;
}

unsafe fn admitted_authority_matches_record(
    world: u64,
    ordinal: usize
) -> bool {
    let length: usize = record_export_authority_length(ordinal);
    if admitted_export_authority_id_at(world, ordinal)
            != record_export_authority(ordinal)
        || admitted_export_authority_length_at(world, ordinal) != length {
        return false;
    }
    let mut byte: usize = 0;
    while byte < length {
        if admitted_export_authority_byte_at(world, ordinal, byte)
            != volatile_load(
                (record_export_authority_address(ordinal) + byte)
                    as *const u8
            ) as u64 {
            return false;
        }
        byte += 1;
    }
    return true;
}

unsafe fn register_fixture_device_policy() -> bool {
    return register_policy(
        PACKAGE_SHA_0,
        PACKAGE_SHA_1,
        PACKAGE_SHA_2,
        PACKAGE_SHA_3,
        (&POLICY_DEVICE_NET[0]),
        10,
        (&POLICY_RESETTABLE_NETWORK[0]),
        33,
        RIGHT_DEVICE_RESET
    ) == 1;
}

unsafe fn register_fixture_vm_policy() -> bool {
    return register_policy(
        PACKAGE_SHA_0,
        PACKAGE_SHA_1,
        PACKAGE_SHA_2,
        PACKAGE_SHA_3,
        (&POLICY_VM_MACHINE[0]),
        10,
        (&POLICY_CONTAINED_GUEST[0]),
        25,
        RIGHT_VM_RUN | RIGHT_VM_STOP
    ) == 1;
}

unsafe fn record_matches_fixture_policy() -> bool {
    return record_request_count() == 2
        && record_text_equals(
            record_request_kind_address(0),
            record_request_kind_length(0),
            (&POLICY_DEVICE_NET[0]),
            10
        )
        && record_text_equals(
            record_request_purpose_address(0),
            record_request_purpose_length(0),
            (&POLICY_RESETTABLE_NETWORK[0]),
            33
        )
        && record_request_rights(0) == RIGHT_DEVICE_RESET
        && record_text_equals(
            record_request_kind_address(1),
            record_request_kind_length(1),
            (&POLICY_VM_MACHINE[0]),
            10
        )
        && record_text_equals(
            record_request_purpose_address(1),
            record_request_purpose_length(1),
            (&POLICY_CONTAINED_GUEST[0]),
            25
        )
        && record_request_rights(1) == (RIGHT_VM_RUN | RIGHT_VM_STOP);
}

unsafe fn admit_unrelated_world() -> u64 {
    if register_policy(
        UNRELATED_DIGEST_0,
        UNRELATED_DIGEST_1,
        UNRELATED_DIGEST_2,
        UNRELATED_DIGEST_3,
        (&POLICY_VM_MACHINE[0]),
        10,
        (&UNRELATED_VM_PURPOSE[0]),
        25,
        RIGHT_VM_RUN
    ) != 1 {
        return 0;
    }
    let world: u64 = begin_admission(
        UNRELATED_DIGEST_0,
        UNRELATED_DIGEST_1,
        UNRELATED_DIGEST_2,
        UNRELATED_DIGEST_3,
        UNRELATED_MANIFEST_0,
        UNRELATED_MANIFEST_1,
        UNRELATED_MANIFEST_2,
        UNRELATED_MANIFEST_3,
        INTEGRATION_BINARY_CONTAINED,
        EXECUTION_HARDWARE_VIRTUALIZED,
        FIRMWARE_UEFI,
        0x9301,
        0x9301,
        1,
        record_architecture_id(),
        record_profile_id(),
        record_health_id(),
        1000,
        RESTART_NEVER,
        1,
        1,
        1,
        2,
        1,
        2,
        4096,
        0,
        1,
        1
    );
    if world == 0
        || define_admission_export(
            world,
            0,
            0x9401,
            EXPORT_PLANE_ABI,
            0x9402,
            0 as *const u8,
            0
        ) != 1
        || define_admission_request(
            world,
            0,
            (&POLICY_VM_MACHINE[0]),
            10,
            (&UNRELATED_VM_PURPOSE[0]),
            25,
            RIGHT_VM_RUN
        ) != 1
        || seal_admission(world) != world {
        return 0;
    }
    return world;
}

unsafe fn run_live_boot_service(
    primary_world: u64,
    primary_vm: u64,
    primary_vcpu: u64,
    primary_page: u64,
    unrelated_world: u64,
    unrelated_vm: u64,
    unrelated_vcpu: u64,
    unrelated_page: u64,
    primary_owner: u64,
    unrelated_owner: u64,
    baseline_frames: usize
) -> never {
    if live_boot_init() != 1
        || admitted_restart_policy(primary_world) != RESTART_ON_FAILURE
        || record_restart_policy() != RESTART_ON_FAILURE
        || admitted_restart_policy(unrelated_world) != RESTART_NEVER {
        fail_closed();
    }

    let mut primary_export: usize = admitted_export_count(primary_world);
    let mut ordinal: usize = 0;
    while ordinal < admitted_export_count(primary_world) {
        if admitted_export_plane_at(primary_world, ordinal)
            == EXPORT_PLANE_DEVICE {
            primary_export = ordinal;
        }
        ordinal += 1;
    }
    if primary_export >= admitted_export_count(primary_world)
        || admitted_export_count(unrelated_world) != 1
        || admitted_export_plane_at(unrelated_world, 0)
            != EXPORT_PLANE_ABI {
        fail_closed();
    }
    let primary_name: u64 =
        admitted_export_name_at(primary_world, primary_export);
    let primary_protocol: u64 =
        admitted_export_protocol_at(primary_world, primary_export);
    let unrelated_name: u64 = admitted_export_name_at(unrelated_world, 0);
    let unrelated_protocol: u64 =
        admitted_export_protocol_at(unrelated_world, 0);
    let mut result_capability: u64 = 0;

    // A configured VM is bound to its exact admitted world generation. The
    // supervisor rejects cross-world staging before any state is installed.
    if stage_live_boot(
        primary_world,
        unrelated_vm,
        primary_owner
    ) != 0 {
        fail_closed();
    }
    let primary_boot: u64 =
        stage_live_boot(primary_world, primary_vm, primary_owner);
    let unrelated_boot: u64 =
        stage_live_boot(unrelated_world, unrelated_vm, unrelated_owner);
    if primary_boot == 0
        || unrelated_boot == 0
        || primary_boot == unrelated_boot
        || live_boot_generation(primary_boot) != 1
        || live_boot_generation(unrelated_boot) != 1
        || live_stage_count() != 2
        || live_boot_count() != 2
        || lookup_live_export(
            primary_name,
            primary_protocol,
            primary_owner,
            RIGHT_KERNEL_WORLD_STATUS,
            (&mut result_capability)
        ) != 0
        || result_capability != 0 {
        fail_closed();
    }
    write((&LIVE_STAGED_MESSAGE[0]), 50);

    if start_live_boot(primary_boot) != 1
        || start_live_boot(unrelated_boot) != 1
        || live_start_count() != 2
        || publish_live_export(
            primary_boot,
            primary_export,
            (&mut result_capability)
        ) != 0
        || result_capability != 0
        || record_live_health(
            primary_boot,
            admitted_health_protocol(primary_world) ^ 1
        ) != 0
        || record_live_health(
            primary_boot,
            admitted_health_protocol(primary_world)
        ) != 1
        || record_live_health(
            unrelated_boot,
            admitted_health_protocol(unrelated_world)
        ) != 1
        || live_health_count() != 2 {
        fail_closed();
    }

    let mut primary_capability: u64 = 0;
    let primary_binding: u64 = publish_live_export(
        primary_boot,
        primary_export,
        (&mut primary_capability)
    );
    let mut unrelated_capability: u64 = 0;
    let unrelated_binding: u64 = publish_live_export(
        unrelated_boot,
        0,
        (&mut unrelated_capability)
    );
    result_capability = 0;
    if primary_binding == 0
        || unrelated_binding == 0
        || primary_capability == 0
        || unrelated_capability == 0
        || !live_binding_is_live(primary_binding)
        || !live_binding_is_live(unrelated_binding)
        || live_publication_count() != 2
        || live_service_count() != 2
        || lookup_live_export(
            primary_name,
            primary_protocol,
            primary_owner,
            RIGHT_KERNEL_WORLD_STATUS
                | RIGHT_KERNEL_WORLD_RESET_REQUEST,
            (&mut result_capability)
        ) != 1
        || result_capability != primary_capability
        || lookup_live_export(
            primary_name,
            primary_protocol ^ 1,
            primary_owner,
            RIGHT_KERNEL_WORLD_STATUS,
            (&mut result_capability)
        ) != 0
        || result_capability != 0
        || lookup_live_export(
            unrelated_name,
            unrelated_protocol,
            unrelated_owner,
            RIGHT_KERNEL_WORLD_RESET_REQUEST,
            (&mut result_capability)
        ) != 0
        || result_capability != 0 {
        fail_closed();
    }
    write((&LIVE_HEALTH_MESSAGE[0]), 57);

    let forged_primary_capability: u64 =
        primary_capability + 0x0000_0001_0000_0000;
    if live_status(primary_owner, primary_capability) != 1
        || live_status(unrelated_owner, unrelated_capability) != 1
        || request_live_reset(primary_owner, primary_capability) != 1
        || request_live_reset(unrelated_owner, unrelated_capability) != 0
        || live_status(primary_owner, forged_primary_capability) != 0
        || live_reset_count() != 1 {
        fail_closed();
    }
    write((&LIVE_CAPABILITY_MESSAGE[0]), 47);

    let withdrawals_before_failure: u64 = live_withdrawal_count();
    if fail_live_boot(primary_boot) != 1
        || live_failure_count() != 1
        || live_binding_is_live(primary_binding)
        || live_status(primary_owner, primary_capability) != 0
        || lookup_live_export(
            primary_name,
            primary_protocol,
            primary_owner,
            RIGHT_KERNEL_WORLD_STATUS,
            (&mut result_capability)
        ) != 0
        || result_capability != 0
        || vm_is_current(primary_vm)
        || vcpu_is_current(primary_vcpu)
        || guest_page_is_current(primary_page)
        || !world_is_current(primary_world)
        || !pending_restart(primary_world)
        || !has_live_terminal(primary_world)
        || live_withdrawal_count() != withdrawals_before_failure + 1
        || last_failure_withdrawal_event() == 0
        || last_failure_vm_revoke_event()
            <= last_failure_withdrawal_event()
        || live_boot_count() != 1
        || live_service_count() != 1
        || pending_restart_count() != 1
        || quota_used(PRIMARY_OWNER_SLOT) != 0
        || quota_used(UNRELATED_OWNER_SLOT) != 1
        || free_frames() + 1 != baseline_frames {
        fail_closed();
    }
    write((&LIVE_FAILURE_MESSAGE[0]), 58);

    if !live_binding_is_live(unrelated_binding)
        || live_status(unrelated_owner, unrelated_capability) != 1
        || !vm_is_current(unrelated_vm)
        || !vcpu_is_current(unrelated_vcpu)
        || !guest_page_is_current(unrelated_page)
        || !world_is_current(unrelated_world) {
        fail_closed();
    }
    write((&LIVE_UNRELATED_MESSAGE[0]), 57);

    let replacement_vm: u64 =
        create_vm(primary_world, primary_owner, 1, 1);
    let replacement_vcpu: u64 = create_vcpu(replacement_vm, 0);
    let replacement_page: u64 =
        attach_guest_page(replacement_vm, 0x10000);
    if replacement_vm == 0
        || replacement_vcpu == 0
        || replacement_page == 0
        || seal_configuration(replacement_vm) != 1
        || vm_state(replacement_vm) != VM_STATE_CONFIGURED
        || free_frames() + 2 != baseline_frames
        || quota_used(PRIMARY_OWNER_SLOT) != 1
        // Uninstall must not revoke admission underneath an un-staged
        // replacement graph. The terminal ticket and graph remain usable.
        || uninstall_live_world(primary_world) != 0
        || !world_is_current(primary_world)
        || !vm_is_current(replacement_vm)
        || !has_live_terminal(primary_world)
        // A failure ticket cannot be bypassed through the initial start path.
        || stage_live_boot(
            primary_world,
            replacement_vm,
            primary_owner
        ) != 0 {
        fail_closed();
    }
    write((&LIVE_POLICY_MESSAGE[0]), 53);

    let replacement_boot: u64 = restart_after_failure(
        primary_world,
        replacement_vm,
        primary_owner
    );
    if replacement_boot == 0
        || live_boot_generation(replacement_boot) != 2
        || pending_restart(primary_world)
        || has_live_terminal(primary_world)
        || live_restart_count() != 1
        || live_stage_count() != 3
        || start_live_boot(replacement_boot) != 1
        || record_live_health(
            replacement_boot,
            admitted_health_protocol(primary_world)
        ) != 1 {
        fail_closed();
    }
    let mut replacement_capability: u64 = 0;
    let replacement_binding: u64 = publish_live_export(
        replacement_boot,
        primary_export,
        (&mut replacement_capability)
    );
    result_capability = 0;
    if replacement_binding == 0
        || replacement_binding == primary_binding
        || replacement_capability == 0
        || replacement_capability == primary_capability
        || live_binding_is_live(primary_binding)
        || !live_binding_is_live(replacement_binding)
        || live_status(primary_owner, primary_capability) != 0
        || live_status(primary_owner, replacement_capability) != 2
        || request_live_reset(
            primary_owner,
            replacement_capability
        ) != 1
        || lookup_live_export(
            primary_name,
            primary_protocol,
            primary_owner,
            RIGHT_KERNEL_WORLD_STATUS,
            (&mut result_capability)
        ) != 1
        || result_capability != replacement_capability
        || live_reset_count() != 2
        || live_start_count() != 3
        || live_health_count() != 3
        || live_publication_count() != 3 {
        fail_closed();
    }

    // The generic cap-close syscall routes through this same registry-aware
    // transition. Closing a client cap cannot orphan SERVICE_LIVE metadata or
    // block subsequent stop/reclamation.
    if close_live_export(
        primary_owner,
        replacement_capability
    ) != 1
        || live_binding_is_live(replacement_binding)
        || live_status(primary_owner, replacement_capability) != 0
        || live_service_count() != 1
        || lookup_live_export(
            primary_name,
            primary_protocol,
            primary_owner,
            RIGHT_KERNEL_WORLD_STATUS,
            (&mut result_capability)
        ) != 0
        || result_capability != 0 {
        fail_closed();
    }
    let mut final_primary_capability: u64 = 0;
    let final_primary_binding: u64 = publish_live_export(
        replacement_boot,
        primary_export,
        (&mut final_primary_capability)
    );
    if final_primary_binding == 0
        || final_primary_binding == replacement_binding
        || final_primary_capability == 0
        || final_primary_capability == replacement_capability
        || !live_binding_is_live(final_primary_binding)
        || live_status(primary_owner, final_primary_capability) != 2
        || live_publication_count() != 4 {
        fail_closed();
    }
    write((&LIVE_RESTART_MESSAGE[0]), 52);

    // Explicit stop creates a terminal tombstone, so the initial-stage API
    // cannot reinterpret a stopped on-failure provider as a fresh start.
    if stop_live_boot(replacement_boot) != 1
        || live_stop_count() != 1
        || !has_live_terminal(primary_world)
        || pending_restart(primary_world)
        || uninstall_live_world(primary_world) != 1
        || world_is_current(primary_world)
        || vm_is_current(replacement_vm)
        || vcpu_is_current(replacement_vcpu)
        || guest_page_is_current(replacement_page)
        || quota_used(PRIMARY_OWNER_SLOT) != 0
        || free_frames() + 1 != baseline_frames {
        fail_closed();
    }

    // A RESTART_NEVER failure also leaves a terminal tombstone. It cannot be
    // consumed as a restart and must be explicitly abandoned before uninstall.
    if fail_live_boot(unrelated_boot) != 1
        || pending_restart(unrelated_world)
        || !has_live_terminal(unrelated_world)
        || restart_after_failure(
            unrelated_world,
            unrelated_vm,
            unrelated_owner
        ) != 0
        || uninstall_live_world(unrelated_world) != 1
        || world_is_current(unrelated_world)
        || vm_is_current(unrelated_vm)
        || vcpu_is_current(unrelated_vcpu)
        || guest_page_is_current(unrelated_page)
        || live_boot_count() != 0
        || live_service_count() != 0
        || pending_restart_count() != 0
        || active_vm_count() != 0
        || active_vcpu_count() != 0
        || active_guest_page_count() != 0
        || current_world_count() != 0
        || quota_used(PRIMARY_OWNER_SLOT) != 0
        || quota_used(UNRELATED_OWNER_SLOT) != 0
        || free_frames() != baseline_frames
        || live_failure_count() != 2
        || live_withdrawal_count() != 4
        || live_denial_count() < 10
        || !record_invariants_hold()
        || !admission_invariants_hold()
        || !vm_invariants_hold()
        || !live_boot_invariants_hold() {
        fail_closed();
    }
    write((&LIVE_COMPLETE_MESSAGE[0]), 51);

    let tick_before: u64 = ticks();
    enable_interrupts();
    while ticks() == tick_before {
        halt();
    }
    write((&POST_LIVE_TIMER_MESSAGE[0]), 35);
    loop {
        halt();
    }
}

pub unsafe fn start(mode: u64) -> never {
    if mode != MODE_KERNEL_WORLD_OBJECTS
        && mode != MODE_KERNEL_WORLD_EXECUTION
        && mode != MODE_KERNEL_WORLD_LIVE {
        fail_closed();
    }
    disable_interrupts();
    let record_start: usize = ocore_kernel_world_record_start();
    let record_end: usize = ocore_kernel_world_record_end();
    if record_start == 0
        || record_end <= record_start
        || record_end - record_start != RECORD_LENGTH
        || sha256_selftest() != 1
        || record_canonical_order_selftest() != 1
        || !build_noncanonical_record(record_start as *const u8)
        || record_init() != 1
        || parse_record(
            record_start as *const u8,
            RECORD_LENGTH,
            RECORD_SHA_0 ^ 1,
            RECORD_SHA_1,
            RECORD_SHA_2,
            RECORD_SHA_3
        ) != 0
        // This variant has a correct independently pinned SHA but reverses
        // only the final [run, stop] vector. Structural parsing must deny it.
        || parse_record(
            (&NONCANONICAL_RECORD[0]),
            RECORD_LENGTH,
            NONCANONICAL_SHA_0,
            NONCANONICAL_SHA_1,
            NONCANONICAL_SHA_2,
            NONCANONICAL_SHA_3
        ) != 0
        || parse_record(
            record_start as *const u8,
            RECORD_LENGTH,
            RECORD_SHA_0,
            RECORD_SHA_1,
            RECORD_SHA_2,
            RECORD_SHA_3
        ) != 1
        || record_denied_count() != 2
        || record_accepted_count() != 1
        || record_package_digest_word(0) != PACKAGE_SHA_0
        || record_package_digest_word(1) != PACKAGE_SHA_1
        || record_package_digest_word(2) != PACKAGE_SHA_2
        || record_package_digest_word(3) != PACKAGE_SHA_3
        || record_manifest_digest_word(0) != MANIFEST_SHA_0
        || record_manifest_digest_word(1) != MANIFEST_SHA_1
        || record_manifest_digest_word(2) != MANIFEST_SHA_2
        || record_manifest_digest_word(3) != MANIFEST_SHA_3
        || !record_matches_svm_npt_backend()
        || !record_invariants_hold() {
        fail_closed();
    }
    write((&RECORD_MESSAGE[0]), 59);
    write((&REQUIREMENT_MESSAGE[0]), 43);

    if admission_init() != 1
        || !record_matches_fixture_policy()
        || !register_fixture_device_policy()
        || register_policy(
            PACKAGE_SHA_0,
            PACKAGE_SHA_1,
            PACKAGE_SHA_2,
            PACKAGE_SHA_3,
            (&POLICY_VM_MACHINE[0]),
            10,
            (&POLICY_WRONG_PURPOSE[0]),
            25,
            RIGHT_VM_RUN | RIGHT_VM_STOP
        ) != 1 {
        fail_closed();
    }
    let denied: u64 = begin_from_record();
    if denied == 0
        || !define_from_record(denied)
        || seal_admission(denied) != 0
        || abort_admission(denied) != 1
        || world_is_current(denied)
        // Device policy was exact. The denial above is therefore the
        // one-byte VM-purpose mismatch, not an unrelated absent rule.
        || !register_fixture_vm_policy() {
        fail_closed();
    }
    let wrong_authority: u64 = begin_from_record();
    if wrong_authority == 0
        || wrong_authority == denied
        || !define_wrong_authority_from_record(wrong_authority)
        // `device.audio` is syntactically a device request kind but is not the
        // exact admitted `device.net` authority. Metadata cannot bridge it.
        || seal_admission(wrong_authority) != 0
        || abort_admission(wrong_authority) != 1
        || world_is_current(wrong_authority) {
        fail_closed();
    }
    let primary_world: u64 = begin_from_record();
    if primary_world == 0
        || primary_world == denied
        || primary_world == wrong_authority
        || !define_from_record(primary_world)
        || seal_admission(primary_world) != primary_world
        || world_state(primary_world) != WORLD_STATE_ADMITTED
        || world_generation(primary_world) == 0
        || admitted_package_digest_word(primary_world, 0) != PACKAGE_SHA_0
        || admission_begin_count() != 3
        || admission_seal_count() != 1
        || admission_denial_count() < 4 {
        fail_closed();
    }
    let mut ordinal: usize = 0;
    while ordinal < record_request_count() {
        if request_grant_at(primary_world, ordinal)
            != record_request_rights(ordinal) {
            fail_closed();
        }
        ordinal += 1;
    }
    ordinal = 0;
    while ordinal < record_export_count() {
        if !admitted_authority_matches_record(primary_world, ordinal) {
            fail_closed();
        }
        ordinal += 1;
    }
    write((&POLICY_MESSAGE[0]), 59);
    write((&AUTHORITY_MESSAGE[0]), 47);

    let unrelated_world: u64 = admit_unrelated_world();
    let primary_owner: u64 = cspace_handle_for_slot(PRIMARY_OWNER_SLOT);
    let unrelated_owner: u64 = cspace_handle_for_slot(UNRELATED_OWNER_SLOT);
    if unrelated_world == 0
        || primary_owner == 0
        || unrelated_owner == 0
        || set_quota_for_owner(primary_owner, 4) != 1
        || set_quota_for_owner(unrelated_owner, 1) != 1
        || vm_init() != 1 {
        fail_closed();
    }
    let baseline_frames: usize = free_frames();
    // The VM allows a fifth page while the owner quota allows only four, so
    // the final attachment denial is specifically the memory-object quota.
    let primary_vm: u64 = create_vm(primary_world, primary_owner, 2, 5);
    if primary_vm == 0 || create_vcpu(primary_vm, 1) != 0 {
        fail_closed();
    }
    let primary_vcpu_zero: u64 = create_vcpu(primary_vm, 0);
    let primary_vcpu_one: u64 = create_vcpu(primary_vm, 1);
    if primary_vcpu_zero == 0
        || primary_vcpu_one == 0
        || create_vcpu(primary_vm, 0) != 0
        || create_vcpu(primary_vm, 2) != 0 {
        fail_closed();
    }
    let primary_page_zero: u64 = attach_guest_page(primary_vm, 0);
    let primary_page_one: u64 = attach_guest_page(primary_vm, 0x1000);
    let primary_page_two: u64 = attach_guest_page(primary_vm, 0x2000);
    let primary_page_three: u64 = attach_guest_page(primary_vm, 0x3000);
    if primary_page_zero == 0
        || primary_page_one == 0
        || primary_page_two == 0
        || primary_page_three == 0
        || guest_page_memory_object(primary_page_zero) == 0
        || attach_guest_page(primary_vm, 1) != 0
        || attach_guest_page(primary_vm, 0) != 0
        || attach_guest_page(primary_vm, 0x4000) != 0
        || seal_configuration(primary_vm) != 1
        || vm_state(primary_vm) != VM_STATE_CONFIGURED
        || world_state(primary_world) != WORLD_STATE_ADMITTED
        || vm_vcpu_count(primary_vm) != 2
        || vm_guest_page_count(primary_vm) != 4
        || quota_used(PRIMARY_OWNER_SLOT) != 4
        || free_frames() + 4 != baseline_frames
        || vm_denial_count() < 5 {
        fail_closed();
    }
    write((&OBJECT_MESSAGE[0]), 47);
    if mode == MODE_KERNEL_WORLD_OBJECTS {
        write((&NONEXECUTING_MESSAGE[0]), 55);
    }

    let unrelated_vm: u64 = create_vm(
        unrelated_world,
        unrelated_owner,
        1,
        1
    );
    let unrelated_vcpu: u64 = create_vcpu(unrelated_vm, 0);
    let unrelated_page: u64 = attach_guest_page(unrelated_vm, 0x8000);
    if unrelated_vm == 0
        || unrelated_vcpu == 0
        || unrelated_page == 0
        || seal_configuration(unrelated_vm) != 1
        || world_state(primary_world) != WORLD_STATE_ADMITTED
        || world_state(unrelated_world) != WORLD_STATE_ADMITTED
        || free_frames() + 5 != baseline_frames
        || current_world_count() != 2
        || active_vm_count() != 2
        || active_vcpu_count() != 3
        || active_guest_page_count() != 5 {
        fail_closed();
    }

    if mode == MODE_KERNEL_WORLD_LIVE {
        run_live_boot_service(
            primary_world,
            primary_vm,
            primary_vcpu_zero,
            primary_page_zero,
            unrelated_world,
            unrelated_vm,
            unrelated_vcpu,
            unrelated_page,
            primary_owner,
            unrelated_owner,
            baseline_frames
        );
    }

    if mode == MODE_KERNEL_WORLD_EXECUTION {
        if svm_init() != 1 {
            fail_closed();
        }
        write((&VIRTUALIZATION_MESSAGE[0]), 44);
        if svm_prepare(
            primary_vcpu_zero,
            primary_page_zero,
            primary_page_one
        ) != 1 {
            fail_closed();
        }
        write((&NPT_MAPPING_MESSAGE[0]), 37);
        if run_to_hypercall() != 1 {
            fail_closed();
        }
        if svm_enter_count() != 1 || svm_exit_count() != 1 {
            fail_closed();
        }
        write((&VCPU_ENTRY_MESSAGE[0]), 33);
        write((&COMPUTATION_MESSAGE[0]), 34);
        write((&HYPERCALL_MESSAGE[0]), 35);
        write((&INTERRUPT_MESSAGE[0]), 36);
        if run_to_isolation_fault() != 1
            || svm_enter_count() != 2
            || svm_exit_count() != 2 {
            fail_closed();
        }
        write((&DENIED_MEMORY_MESSAGE[0]), 42);
        if svm_stop() != 1
            || !npt_is_torn_down()
            || svm_teardown_count() != 1 {
            fail_closed();
        }
        write((&NPT_TEARDOWN_MESSAGE[0]), 34);
        // A second complete entry/exit cycle proves stop/restart before the
        // world generation is revoked and its vCPU handle becomes stale.
        if svm_prepare(
            primary_vcpu_zero,
            primary_page_zero,
            primary_page_one
        ) != 1
            || run_to_hypercall() != 1
            || svm_stop() != 1
            || !npt_is_torn_down()
            || svm_enter_count() != 3
            || svm_exit_count() != 3
            || svm_teardown_count() != 2 {
            fail_closed();
        }
    }

    if revoke_vm_world(primary_world) != 1
        || revoke_admission(primary_world) != 1
        || world_is_current(primary_world)
        || vm_is_current(primary_vm)
        || vcpu_is_current(primary_vcpu_zero)
        || guest_page_is_current(primary_page_zero)
        || (mode == MODE_KERNEL_WORLD_EXECUTION
            && svm_prepare(
                primary_vcpu_zero,
                primary_page_zero,
                primary_page_one
            ) != 0)
        || !vm_is_current(unrelated_vm)
        || !vcpu_is_current(unrelated_vcpu)
        || !guest_page_is_current(unrelated_page)
        || quota_used(PRIMARY_OWNER_SLOT) != 0
        || quota_used(UNRELATED_OWNER_SLOT) != 1
        || free_frames() + 1 != baseline_frames {
        fail_closed();
    }
    if mode == MODE_KERNEL_WORLD_OBJECTS {
        write((&REVOKE_MESSAGE[0]), 59);
    } else {
        write((&RESTART_MESSAGE[0]), 38);
        write((&UNRELATED_SURVIVAL_MESSAGE[0]), 31);
    }

    if revoke_vm_world(unrelated_world) != 1
        || revoke_admission(unrelated_world) != 1
        || active_vm_count() != 0
        || active_vcpu_count() != 0
        || active_guest_page_count() != 0
        || current_world_count() != 0
        || quota_used(UNRELATED_OWNER_SLOT) != 0
        || free_frames() != baseline_frames
        || !record_invariants_hold()
        || !admission_invariants_hold()
        || !vm_invariants_hold() {
        fail_closed();
    }
    if mode == MODE_KERNEL_WORLD_OBJECTS {
        write((&COMPLETE_MESSAGE[0]), 52);
    } else {
        write((&EXECUTABLE_MESSAGE[0]), 39);
    }

    let tick_before: u64 = ticks();
    enable_interrupts();
    while ticks() == tick_before {
        halt();
    }
    if mode == MODE_KERNEL_WORLD_OBJECTS {
        write((&POST_TIMER_MESSAGE[0]), 35);
    } else {
        write((&POST_EXECUTION_TIMER_MESSAGE[0]), 32);
    }
    loop {
        halt();
    }
}

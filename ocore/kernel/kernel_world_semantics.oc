static CANONICAL_RIGHTS_TAIL: [u8; 11] =
    [3, 0, b'r', b'u', b'n', 4, 0, b's', b't', b'o', b'p'];
static NONCANONICAL_RIGHTS_TAIL: [u8; 11] =
    [4, 0, b's', b't', b'o', b'p', 3, 0, b'r', b'u', b'n'];

extern "sysv64" fn ocore_m6_linux_image_end() -> usize;
extern "sysv64" fn ocore_m7_linux_plan9_image_start() -> usize;
extern "sysv64" fn ocore_m7_linux_plan9_image_end() -> usize;

unsafe fn fail_closed() -> never {
    disable_interrupts();
    loop {
        halt();
    }
}

unsafe fn mode25_diagnostic_halt(code: u8) -> never {
    mode25_emit(code);
    fail_closed();
}

unsafe fn management_context() -> bool {
    return ocore_current_cr3() == ocore_management_cr3();
}

unsafe fn bounded_mode() -> bool {
    return ACTIVE_MODE == MODE_BOUNDED_PERSONALITY
        || ACTIVE_MODE == MODE_LINUX_PERSONALITY
        || ACTIVE_MODE == MODE_LINUX_PLAN9;
}

unsafe fn linux_mode() -> bool {
    return ACTIVE_MODE == MODE_LINUX_PERSONALITY
        || ACTIVE_MODE == MODE_LINUX_PLAN9;
}

unsafe fn path_id(index: usize) -> u64 {
    if index >= PROCESS_COUNT {
        return 0;
    }
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        return M7_PATH_IDS[index];
    }
    if ACTIVE_MODE == MODE_LINUX_PERSONALITY {
        return LINUX_PATH_IDS[index];
    }
    return PATH_IDS[index];
}

unsafe fn emit_linux_stream(fd: u64, start: usize, length: usize) -> bool {
    if length == 0 || length > 128 || start > 128 - length {
        return false;
    }
    let mut offset: usize = 0;
    while offset < length {
        let mut value: u64 = 0x100;
        if fd == 1 {
            value = linux_stdout_byte(start + offset);
        }
        if fd == 2 {
            value = linux_stderr_byte(start + offset);
        }
        if value > 0xff {
            return false;
        }
        LINUX_EMIT_BUFFER[offset] = value as u8;
        offset += 1;
    }
    write((&LINUX_EMIT_BUFFER[0]), length);
    while offset != 0 {
        offset -= 1;
        LINUX_EMIT_BUFFER[offset] = 0;
    }
    return true;
}

unsafe fn distinct_four_u64(values: *const u64) -> bool {
    let mut outer: usize = 0;
    while outer < PROCESS_COUNT {
        if volatile_load(values + outer) == 0 {
            return false;
        }
        let mut inner: usize = outer + 1;
        while inner < PROCESS_COUNT {
            if volatile_load(values + outer) == volatile_load(values + inner) {
                return false;
            }
            inner += 1;
        }
        outer += 1;
    }
    return true;
}

unsafe fn distinct_four_usize(values: *const usize) -> bool {
    let mut outer: usize = 0;
    while outer < PROCESS_COUNT {
        if volatile_load(values + outer) == 0 {
            return false;
        }
        let mut inner: usize = outer + 1;
        while inner < PROCESS_COUNT {
            if volatile_load(values + outer) == volatile_load(values + inner) {
                return false;
            }
            inner += 1;
        }
        outer += 1;
    }
    return true;
}

unsafe fn load_plan(namespace_index: usize, path: u64) -> u64 {
    if namespace_index >= PROCESS_COUNT {
        return 0;
    }
    let namespace: u64 = NAMESPACES[namespace_index];
    let object: u64 = vfs_lookup(namespace, path);
    if object == 0 || retain_object(namespace, object) == 0 {
        return 0;
    }
    return validate_elf(object);
}

unsafe fn loaded_protections_all_hold() -> bool {
    let mut index: usize = 0;
    while index < PROCESS_COUNT {
        if !loaded_protections_hold(ADDRESS_SPACES[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

unsafe fn install_endpoint_cap(
    endpoint: u64,
    owner: u64,
    slot: usize,
    rights: u64,
    additional_reference: bool
) -> u64 {
    if endpoint == 0 || owner == 0 {
        return 0;
    }
    if additional_reference && retain_endpoint(endpoint) == 0 {
        return 0;
    }
    let capability: u64 = install_capability_for_owner(
        owner,
        slot,
        endpoint,
        OBJECT_ENDPOINT,
        rights
    );
    if capability == 0 {
        if additional_reference {
            release_endpoint(endpoint);
        }
        return 0;
    }
    return capability;
}

unsafe fn close_endpoint_cap(
    owner: u64,
    capability: u64,
    endpoint: u64
) -> bool {
    return owner != 0
        && capability != 0
        && endpoint != 0
        && validate_for_owner(owner, capability, OBJECT_ENDPOINT, 0)
            == endpoint
        && close_capability_for_owner(owner, capability) != 0
        && release_endpoint(endpoint) != 0;
}

unsafe fn close_generation_endpoints() -> bool {
    let request: u64 = REQUEST_ENDPOINT;
    let direct: u64 = DIRECT_REPLY_ENDPOINT;
    if PERSONALITY_REPLY_CAP == 0
        || validate_for_owner(
            CSPACES[SERVICE],
            PERSONALITY_REPLY_CAP,
            OBJECT_PERSONALITY_REPLY,
            RIGHT_PERSONALITY_REPLY
        ) != PROCESSES[SERVICE]
        || close_capability_for_owner(
            CSPACES[SERVICE],
            PERSONALITY_REPLY_CAP
        ) == 0
        || !close_endpoint_cap(
        CSPACES[SERVICE],
        REQUEST_RECEIVE_CAP,
        request
    ) || !close_endpoint_cap(
        CSPACES[SUPERVISOR],
        REQUEST_SEND_CAP,
        request
    ) || !close_endpoint_cap(
        CSPACES[SUPERVISOR],
        DIRECT_REPLY_RECEIVE_CAP,
        direct
    ) || !close_endpoint_cap(
        CSPACES[SERVICE],
        DIRECT_REPLY_SEND_CAP,
        direct
    ) || endpoint_is_live(request)
        || endpoint_is_draining(request)
        || endpoint_is_live(direct)
        || endpoint_is_draining(direct) {
        return false;
    }
    REQUEST_ENDPOINT = 0;
    DIRECT_REPLY_ENDPOINT = 0;
    REQUEST_RECEIVE_CAP = 0;
    REQUEST_SEND_CAP = 0;
    DIRECT_REPLY_SEND_CAP = 0;
    DIRECT_REPLY_RECEIVE_CAP = 0;
    PERSONALITY_REPLY_CAP = 0;
    return true;
}

unsafe fn create_generation_endpoints() -> bool {
    REQUEST_ENDPOINT = create_endpoint(CSPACES[SERVICE]);
    DIRECT_REPLY_ENDPOINT = create_endpoint(CSPACES[SERVICE]);
    if REQUEST_ENDPOINT == 0
        || DIRECT_REPLY_ENDPOINT == 0
        || REQUEST_ENDPOINT == DIRECT_REPLY_ENDPOINT {
        return false;
    }
    REQUEST_RECEIVE_CAP = install_endpoint_cap(
        REQUEST_ENDPOINT,
        CSPACES[SERVICE],
        1,
        RIGHT_ENDPOINT_RECEIVE | RIGHT_ENDPOINT_CANCEL,
        false
    );
    REQUEST_SEND_CAP = install_endpoint_cap(
        REQUEST_ENDPOINT,
        CSPACES[SUPERVISOR],
        2,
        RIGHT_ENDPOINT_SEND,
        true
    );
    DIRECT_REPLY_RECEIVE_CAP = install_endpoint_cap(
        DIRECT_REPLY_ENDPOINT,
        CSPACES[SUPERVISOR],
        3,
        RIGHT_ENDPOINT_RECEIVE | RIGHT_ENDPOINT_CANCEL,
        false
    );
    DIRECT_REPLY_SEND_CAP = install_endpoint_cap(
        DIRECT_REPLY_ENDPOINT,
        CSPACES[SERVICE],
        3,
        RIGHT_ENDPOINT_SEND,
        true
    );
    PERSONALITY_REPLY_CAP = install_capability_for_owner(
        CSPACES[SERVICE],
        2,
        PROCESSES[SERVICE],
        OBJECT_PERSONALITY_REPLY,
        RIGHT_PERSONALITY_REPLY
    );
    return REQUEST_RECEIVE_CAP != 0
        && REQUEST_SEND_CAP != 0
        && DIRECT_REPLY_RECEIVE_CAP != 0
        && DIRECT_REPLY_SEND_CAP != 0
        && PERSONALITY_REPLY_CAP != 0
        && endpoint_invariants_hold()
        && capability_invariants_hold();
}

unsafe fn reap_loaded_process(index: usize) -> bool {
    if index >= PROCESS_COUNT
        || process_state(PROCESSES[index]) != PROCESS_STATE_REAPABLE
        || begin_reap(PROCESSES[index]) == 0
        || destroy_address_space(ADDRESS_SPACES[index]) == 0
        || drain_cspace(CSPACES[index]) == 0
        || finalize_reap(PROCESSES[index]) == 0
        || process_state(PROCESSES[index]) != 0
        || address_space_is_live(ADDRESS_SPACES[index])
        || cspace_is_live(CSPACES[index]) {
        return false;
    }
    return true;
}

unsafe fn seed_generation_config(generation: u64) -> void {
    volatile_store((PHYSICALS[CLIENT] + 8) as *mut u64, 0);
    volatile_store((PHYSICALS[CLIENT] + 16) as *mut u64, generation);
    volatile_store((PHYSICALS[CLIENT] + 24) as *mut u64, 0);

    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        volatile_store((PHYSICALS[OBSERVER] + 8) as *mut u64, 0);
        volatile_store(
            (PHYSICALS[OBSERVER] + 16) as *mut u64,
            generation
        );
        volatile_store((PHYSICALS[OBSERVER] + 24) as *mut u64, 0);
        volatile_store((PHYSICALS[OBSERVER] + 32) as *mut u64, 0);
    }

    volatile_store((PHYSICALS[SERVICE] + 16) as *mut u64, generation);
    volatile_store((PHYSICALS[SERVICE] + 24) as *mut u64, 0);
    volatile_store(
        (PHYSICALS[SERVICE] + 32) as *mut u64,
        REQUEST_RECEIVE_CAP
    );
    volatile_store(
        (PHYSICALS[SERVICE] + 40) as *mut u64,
        PERSONALITY_REPLY_CAP
    );
    volatile_store(
        (PHYSICALS[SERVICE] + 48) as *mut u64,
        DIRECT_REPLY_SEND_CAP
    );
    volatile_store(
        (PHYSICALS[SERVICE] + 56) as *mut u64,
        PROCESSES[CLIENT]
    );
    volatile_store(
        (PHYSICALS[SERVICE] + 64) as *mut u64,
        PROCESSES[SUPERVISOR]
    );
    volatile_store(
        (PHYSICALS[SERVICE] + 72) as *mut u64,
        PRIOR_REQUEST
    );
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        volatile_store(
            (PHYSICALS[SERVICE] + 80) as *mut u64,
            PROCESSES[OBSERVER]
        );
    }

    volatile_store(
        (PHYSICALS[SUPERVISOR] + 8) as *mut u64,
        SUPERVISION_CAP
    );
    volatile_store(
        (PHYSICALS[SUPERVISOR] + 16) as *mut u64,
        generation
    );
    volatile_store((PHYSICALS[SUPERVISOR] + 24) as *mut u64, 0);
    volatile_store(
        (PHYSICALS[SUPERVISOR] + 32) as *mut u64,
        REQUEST_SEND_CAP
    );
    volatile_store(
        (PHYSICALS[SUPERVISOR] + 40) as *mut u64,
        DIRECT_REPLY_RECEIVE_CAP
    );
    volatile_store(
        (PHYSICALS[SUPERVISOR] + 48) as *mut u64,
        PROCESSES[SERVICE]
    );
}

unsafe fn install_call_capability(generation: u64) -> bool {
    if CALL_CAP != 0
        || generation == 0
        || supervision_generation(SUPERVISION) != generation {
        return false;
    }
    CALL_CAP = install_capability_for_owner(
        CSPACES[CLIENT],
        1,
        PROCESSES[SERVICE],
        OBJECT_PERSONALITY_CALL,
        RIGHT_PERSONALITY_CALL
    );
    if CALL_CAP == 0
        || validate_for_owner(
            CSPACES[CLIENT],
            CALL_CAP,
            OBJECT_PERSONALITY_CALL,
            RIGHT_PERSONALITY_CALL
        ) != PROCESSES[SERVICE] {
        return false;
    }
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        PLAN9_CALL_CAP = install_capability_for_owner(
            CSPACES[OBSERVER],
            1,
            PROCESSES[SERVICE],
            OBJECT_PERSONALITY_CALL,
            RIGHT_PERSONALITY_CALL
        );
        if PLAN9_CALL_CAP == 0
            || validate_for_owner(
                CSPACES[OBSERVER],
                PLAN9_CALL_CAP,
                OBJECT_PERSONALITY_CALL,
                RIGHT_PERSONALITY_CALL
            ) != PROCESSES[SERVICE] {
            return false;
        }
        if generation == 1 {
            PLAN9_G1_CALL_CAP = PLAN9_CALL_CAP;
        } else {
            PLAN9_G2_CALL_CAP = PLAN9_CALL_CAP;
            if PLAN9_G2_CALL_CAP == PLAN9_G1_CALL_CAP {
                return false;
            }
        }
        volatile_store(
            (PHYSICALS[OBSERVER] + 8) as *mut u64,
            PLAN9_CALL_CAP
        );
        volatile_store(
            (PHYSICALS[OBSERVER] + 16) as *mut u64,
            generation
        );
        volatile_store(
            (PHYSICALS[OBSERVER] + 24) as *mut u64,
            generation
        );
    }
    if generation == 1 {
        G1_CALL_CAP = CALL_CAP;
    } else {
        G2_CALL_CAP = CALL_CAP;
        if G2_CALL_CAP == G1_CALL_CAP {
            return false;
        }
    }
    volatile_store((PHYSICALS[CLIENT] + 8) as *mut u64, CALL_CAP);
    volatile_store((PHYSICALS[CLIENT] + 16) as *mut u64, generation);
    volatile_store((PHYSICALS[CLIENT] + 24) as *mut u64, generation);
    volatile_store((PHYSICALS[SERVICE] + 24) as *mut u64, generation);
    volatile_store(
        (PHYSICALS[SUPERVISOR] + 24) as *mut u64,
        generation
    );
    if linux_mode() && generation == 2 {
        LINUX_REBIND_BARRIER = 0;
    }
    return true;
}

unsafe fn revoke_call_capability() -> bool {
    let stale: u64 = CALL_CAP;
    if stale == 0
        || close_capability_for_owner(CSPACES[CLIENT], stale) == 0
        || validate_for_owner(
            CSPACES[CLIENT],
            stale,
            OBJECT_PERSONALITY_CALL,
            RIGHT_PERSONALITY_CALL
        ) != 0 {
        return false;
    }
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        let plan9_stale: u64 = PLAN9_CALL_CAP;
        if plan9_stale == 0
            || close_capability_for_owner(
                CSPACES[OBSERVER],
                plan9_stale
            ) == 0
            || validate_for_owner(
                CSPACES[OBSERVER],
                plan9_stale,
                OBJECT_PERSONALITY_CALL,
                RIGHT_PERSONALITY_CALL
            ) != 0 {
            return false;
        }
        PLAN9_CALL_CAP = 0;
        volatile_store((PHYSICALS[OBSERVER] + 8) as *mut u64, 0);
        volatile_store((PHYSICALS[OBSERVER] + 24) as *mut u64, 0);
    }
    CALL_CAP = 0;
    volatile_store((PHYSICALS[CLIENT] + 8) as *mut u64, 0);
    volatile_store((PHYSICALS[CLIENT] + 24) as *mut u64, 0);
    volatile_store((PHYSICALS[SERVICE] + 24) as *mut u64, 0);
    return true;
}

unsafe fn create_replacement_service() -> bool {
    CSPACES[SERVICE] = create_cspace(SERVICE);
    if CSPACES[SERVICE] == 0
        || set_quota_for_owner(CSPACES[SERVICE], QUOTA) == 0 {
        return false;
    }
    PLANS[SERVICE] = load_plan(SERVICE, path_id(SERVICE));
    if PLANS[SERVICE] == 0 {
        return false;
    }
    ADDRESS_SPACES[SERVICE] = create_loaded_for_owner(
        CSPACES[SERVICE],
        PLANS[SERVICE]
    );
    PHYSICALS[SERVICE] = isolation_physical(ADDRESS_SPACES[SERVICE]);
    if ADDRESS_SPACES[SERVICE] == 0
        || PHYSICALS[SERVICE] == 0
        || !is_loaded(ADDRESS_SPACES[SERVICE])
        || loaded_entry(ADDRESS_SPACES[SERVICE]) == 0
        || loaded_stack_pointer(ADDRESS_SPACES[SERVICE]) == 0
        || loaded_frame_count(ADDRESS_SPACES[SERVICE]) == 0
        || root_cr3(ADDRESS_SPACES[SERVICE]) == ocore_management_cr3()
        || !loaded_protections_hold(ADDRESS_SPACES[SERVICE])
        || release_plan(PLANS[SERVICE]) == 0 {
        return false;
    }
    PROCESSES[SERVICE] = install_process_for_owner(
        SERVICE,
        2802,
        DOMAINS[SERVICE],
        ADDRESS_SPACES[SERVICE],
        CSPACES[SERVICE],
        ocore_process_kernel_stack_top(SERVICE),
        loaded_entry(ADDRESS_SPACES[SERVICE]),
        loaded_stack_pointer(ADDRESS_SPACES[SERVICE])
    );
    if PROCESSES[SERVICE] == 0
        || bind_process(NAMESPACES[SERVICE], PROCESSES[SERVICE]) == 0 {
        return false;
    }
    DEBUG_CAPS[SERVICE] = install_capability_for_owner(
        CSPACES[SERVICE],
        0,
        0x660 + SERVICE as u64,
        OBJECT_DEBUG,
        RIGHT_DEBUG_WRITE
    );
    if DEBUG_CAPS[SERVICE] == 0 || !create_generation_endpoints() {
        return false;
    }
    let stale_supervision: u64 = SUPERVISION;
    let replacement: u64 = install_supervision_replacement(
        stale_supervision,
        PROCESSES[SUPERVISOR],
        STALE_SERVICE_PROCESS,
        PROCESSES[SERVICE]
    );
    if replacement == 0
        || close_capability_for_owner(
            CSPACES[SUPERVISOR],
            SUPERVISION_CAP
        ) == 0 {
        return false;
    }
    SUPERVISION = replacement;
    SUPERVISION_CAP = install_capability_for_owner(
        CSPACES[SUPERVISOR],
        1,
        SUPERVISION,
        OBJECT_PERSONALITY_SUPERVISION,
        RIGHT_PERSONALITY_SUPERVISE
    );
    if SUPERVISION_CAP == 0
        || supervision_state(SUPERVISION)
            != SUPERVISION_STATE_REPLACEMENT_STARTING
        || current_generation_monitor_was_armed(stale_supervision)
        || current_generation_monitor_was_armed(SUPERVISION)
        || install_rpc_replacement(
            STALE_SERVICE_PROCESS,
            1,
            PROCESSES[SERVICE],
            2,
            PROTOCOL_ID,
            REQUEST_ENDPOINT
        ) != 1 {
        return false;
    }
    if linux_mode() {
        let mut stdout_object: u64 = 0;
        let mut stderr_object: u64 = 0;
        if provision_linux_process(
            PROCESSES[CLIENT],
            PROCESSES[SERVICE],
            2,
            (&mut stdout_object),
            (&mut stderr_object)
        ) != 1
            || stdout_object == 0
            || stderr_object == 0
            || stdout_object == LINUX_STDOUT_OBJECT
            || stderr_object == LINUX_STDERR_OBJECT {
            return false;
        }
        if authorize_linux_write(
            LINUX_G1_STDOUT_OBJECT,
            PROCESSES[CLIENT],
            PROCESSES[SERVICE],
            2,
            1
        ) != 0
            || authorize_linux_write(
                LINUX_G1_STDERR_OBJECT,
                PROCESSES[CLIENT],
                PROCESSES[SERVICE],
                2,
                2
            ) != 0
            || linux_fd_stale_denial_count() != 2 {
            return false;
        }
        LINUX_STDOUT_OBJECT = stdout_object;
        LINUX_STDERR_OBJECT = stderr_object;
    }
    seed_generation_config(2);
    THREADS[SERVICE] = install_loaded_thread(
        SERVICE,
        2902,
        PROCESSES[SERVICE],
        loaded_entry(ADDRESS_SPACES[SERVICE]),
        loaded_stack_pointer(ADDRESS_SPACES[SERVICE]),
        ocore_process_kernel_stack_top(SERVICE),
        DEBUG_CAPS[SERVICE],
        2,
        THREAD_ROLE_BLOCKING,
        1
    );
    return THREADS[SERVICE] != 0
        && namespace_process_refs(NAMESPACES[SERVICE]) == 1
        && thread_invariants_hold()
        && capability_invariants_hold()
        && endpoint_invariants_hold()
        && supervision_invariants_hold()
        && personality_rpc_invariants_hold();
}

// The adapter hooks below are linked for every probe mode. ARMED and exact
// capability-object checks keep them inert outside the mode-18 package.
@export
@no_mangle
pub unsafe fn kernel_m6_prepare_bounded_resume(
    thread: u64,
    result_out: *mut u64
) -> u64 {
    if ARMED != 0 && bounded_mode() {
        return prepare_bounded_resume(thread, result_out);
    }
    if result_out as usize != 0 {
        volatile_store(result_out, 0);
    }
    return 0;
}

@export
@no_mangle
pub unsafe fn kernel_m6_commit_bounded_resume(thread: u64) -> u64 {
    if ARMED != 0 && bounded_mode() {
        return commit_bounded_resume(thread);
    }
    return 0;
}

@export
@no_mangle
pub unsafe fn kernel_m6_bounded_call(
    capability_object: u64,
    capability: u64,
    operation: u64,
    foreign_address: u64,
    length: u64,
    direction: u64,
    timeout_ticks: u64
) -> u64 {
    if ARMED == 0 || !bounded_mode() {
        return ERR_NOT_IMPLEMENTED;
    }
    let caller: u64 = current_process_handle();
    let thread: u64 = current_thread_handle();
    let primary_caller: bool = caller == PROCESSES[CLIENT]
        && thread == THREADS[CLIENT]
        && CALL_CAP == capability;
    let plan9_caller: bool = ACTIVE_MODE == MODE_LINUX_PLAN9
        && caller == PROCESSES[OBSERVER]
        && thread == THREADS[OBSERVER]
        && PLAN9_CALL_CAP == capability;
    if (!primary_caller && !plan9_caller)
        || capability_object != PROCESSES[SERVICE]
        || operation == 0
        || operation > 0xff
        || foreign_address == 0
        || length == 0
        || length > 128
        || direction == 0
        || direction > 3
        || (ACTIVE_MODE == MODE_LINUX_PLAN9
            && (!plan9_caller
                || operation != OP_9P
                || length != 128
                || direction != 3)) {
        return ERR_CAPABILITY_DENIED;
    }
    let now: u64 = ticks();
    let mut deadline: u64 = 0;
    if timeout_ticks != 0 {
        if timeout_ticks > 1000000
            || now > INFINITE_DEADLINE - timeout_ticks {
            return ERR_PERSONALITY_UNSUPPORTED;
        }
        deadline = now + timeout_ticks;
    }
    let packed: u64 = (operation << 56) | (length & SCALAR_MASK);
    let mut request: u64 = 0;
    let mut result: u64 = 0;
    let mut committed: usize = 0;
    let mut terminal_kind: u64 = 0;
    let mut wait: u64 = 0;
    let dispatch: u64 = dispatch_bounded_call(
        caller,
        thread,
        process_address_space_for(caller),
        packed,
        deadline,
        foreign_address as usize,
        length as usize,
        direction,
        (&mut request),
        (&mut result),
        (&mut committed),
        (&mut terminal_kind),
        (&mut wait)
    );
    // A bounded request is consumed by the scheduler transaction before CPL3
    // resumes.  Seeing RPC_CONSUMED here would imply an explicit user reissue,
    // which Mode24 deliberately forbids.
    if dispatch == RPC_CONSUMED {
        fail_closed();
    }
    if dispatch != RPC_DISPATCHED {
        return dispatch;
    }
    if operation == OP_HOLD_CANCEL
        || operation == OP_HOLD_UNMAP
        || operation == OP_HOLD_REQUEST_REVOKE
        || operation == OP_HOLD_RESOURCE_REVOKE
        || operation == OP_HOLD_PROCESS_EXIT {
        if PENDING_CANCEL_REQUEST != 0
            || PENDING_LIFECYCLE_OPERATION != 0 {
            fail_closed();
        }
        PENDING_CANCEL_REQUEST = request;
        PENDING_LIFECYCLE_OPERATION = operation;
    }
    if operation == OP_CRASH {
        PENDING_CRASH_REQUEST = request;
    }
    if (wait & 0xff00_0000) != 0xb300_0000 {
        fail_closed();
    }
    if commit_personality_wait(request, wait) != request {
        fail_closed();
    }
    let control: u64 = request_ipc_wait(wait, ERR_IPC_RETRY);
    if control != SYSCALL_CONTROL_SCHEDULE {
        if abort_bounded_wait(request, wait) != 1 {
            fail_closed();
        }
        return control;
    }
    return control;
}

@export
@no_mangle
pub unsafe fn kernel_m6_bounded_lookup(
    capability_object: u64,
    request: u64
) -> u64 {
    let caller: u64 = current_process_handle();
    if ARMED == 0
        || !bounded_mode()
        || caller != PROCESSES[SERVICE]
        || capability_object != caller
        || request == 0 {
        return ERR_CAPABILITY_DENIED;
    }
    return lookup_bounded_view(request);
}

@export
@no_mangle
pub unsafe fn kernel_m6_bounded_read(
    capability: u64,
    offset: u64
) -> u64 {
    if ARMED == 0
        || !bounded_mode()
        || current_process_handle() != PROCESSES[SERVICE]
        || offset > 127 {
        return ERR_CAPABILITY_DENIED;
    }
    let mut value: u8 = 0;
    let read: u64 = read_bounded_byte(
        capability,
        offset as usize,
        (&mut value)
    );
    if read != 1 {
        return read;
    }
    return value as u64;
}

@export
@no_mangle
pub unsafe fn kernel_m6_bounded_write(
    capability: u64,
    offset: u64,
    value: u64
) -> u64 {
    if ARMED == 0
        || !bounded_mode()
        || current_process_handle() != PROCESSES[SERVICE]
        || offset > 127
        || value > 255 {
        return ERR_CAPABILITY_DENIED;
    }
    return write_bounded_byte(capability, offset as usize, value as u8);
}

@export
@no_mangle
pub unsafe fn kernel_m6_bounded_reply(
    capability_object: u64,
    request: u64,
    view_capability: u64,
    committed_length: u64,
    result: u64
) -> u64 {
    let caller: u64 = current_process_handle();
    if ARMED == 0
        || !bounded_mode()
        || caller != PROCESSES[SERVICE]
        || capability_object != caller
        || request == 0
        || committed_length > 128 {
        return ERR_CAPABILITY_DENIED;
    }
    return reply_bounded_request(
        request,
        view_capability,
        committed_length as usize,
        result
    );
}

// The Linux adapter receives architectural Linux arguments, never O-core
// capability arguments. Its hidden call authority is selected solely from the
// current PCB and the supervisor-published service generation.
@export
@no_mangle
pub unsafe fn kernel_m6_linux_syscall(
    number: u64,
    arg0: u64,
    arg1: u64,
    arg2: u64,
    arg3: u64,
    arg4: u64,
    arg5: u64
) -> u64 {
    if ARMED == 0
        || !linux_mode()
        || current_process_handle() != PROCESSES[CLIENT]
        || current_thread_handle() != THREADS[CLIENT]
        || arg3 != 0
        || arg4 != 0
        || arg5 != 0 {
        return LINUX_NEG_EFAULT;
    }
    let mut action: u64 = 0;
    let mut result: u64 = 0;
    if classify_linux_syscall(
        number,
        arg0,
        (&mut action),
        (&mut result)
    ) != 1 {
        return LINUX_NEG_EFAULT;
    }
    if action == LINUX_ACTION_RETURN {
        if linux_enosys_count() == 1 {
            if ACTIVE_MODE == MODE_LINUX_PLAN9 {
                write((&M7_ENOSYS_MESSAGE[0]), 45);
            } else {
                write((&LINUX_ENOSYS_MESSAGE[0]), 36);
            }
        }
        return result;
    }
    if action == LINUX_ACTION_DIRECT_EXIT_GROUP {
        if result != 42
            || LINUX_EXIT_REQUESTED != 0
            || (ACTIVE_MODE == MODE_LINUX_PLAN9
                && bounded_active_count_for_caller(PROCESSES[CLIENT]) != 0)
            || (ACTIVE_MODE != MODE_LINUX_PLAN9
                && bounded_active_count() != 0) {
            return LINUX_NEG_EFAULT;
        }
        LINUX_EXIT_REQUESTED = result;
        return request_process_exit(result);
    }
    if action != LINUX_ACTION_BOUNDED_WRITE
        || (arg0 != 1 && arg0 != 2)
        || arg1 == 0
        || arg2 == 0
        || arg2 > 128
        || CALL_CAP == 0
        || supervision_state(SUPERVISION) != SUPERVISION_STATE_ACTIVE
        || validate_for_owner(
            CSPACES[CLIENT],
            CALL_CAP,
            OBJECT_PERSONALITY_CALL,
            RIGHT_PERSONALITY_CALL
        ) != PROCESSES[SERVICE] {
        return LINUX_NEG_EAGAIN;
    }
    let frame: u64 = make_write_request_frame(arg0, arg2 as usize);
    if frame == 0 {
        return LINUX_NEG_EFAULT;
    }
    let mut request: u64 = 0;
    let mut terminal_result: u64 = 0;
    let mut committed: usize = 0;
    let mut terminal_kind: u64 = 0;
    let mut wait: u64 = 0;
    let dispatch: u64 = dispatch_bounded_call(
        PROCESSES[CLIENT],
        THREADS[CLIENT],
        process_address_space_for(PROCESSES[CLIENT]),
        frame,
        0,
        arg1 as usize,
        arg2 as usize,
        1,
        (&mut request),
        (&mut terminal_result),
        (&mut committed),
        (&mut terminal_kind),
        (&mut wait)
    );
    if dispatch == RPC_CONSUMED {
        mode25_diagnostic_halt(MODE25_DIAG_D1);
    }
    if dispatch != RPC_DISPATCHED {
        return LINUX_NEG_EAGAIN;
    }
    if (wait & 0xff00_0000) != 0xb300_0000
        || commit_personality_wait(request, wait) != request {
        mode25_diagnostic_halt(MODE25_DIAG_D2);
    }
    let control: u64 = request_ipc_wait(wait, ERR_IPC_RETRY);
    if control != SYSCALL_CONTROL_SCHEDULE {
        if abort_bounded_wait(request, wait) != 1 {
            mode25_diagnostic_halt(MODE25_DIAG_D3);
        }
        return LINUX_NEG_EAGAIN;
    }
    return control;
}

@export
@no_mangle
pub unsafe fn kernel_m6_linux_complete(
    capability_object: u64,
    request: u64,
    view: u64,
    fd: u64,
    count: u64
) -> u64 {
    let caller: u64 = current_process_handle();
    if ARMED == 0
        || !linux_mode()
        || caller != PROCESSES[SERVICE]
        || capability_object != caller
        || request == 0
        || view == 0
        || (fd != 1 && fd != 2)
        || count == 0
        || count > 128 {
        return ERR_CAPABILITY_DENIED;
    }
    let stdout_before: usize = linux_stdout_length();
    let stderr_before: usize = linux_stderr_length();
    if complete_linux_write(request, view, fd, count as usize) != 1 {
        return ERR_PERSONALITY_STALE;
    }
    if fd == 1 {
        if linux_stdout_length() != stdout_before + count as usize
            || linux_stderr_length() != stderr_before
            || !emit_linux_stream(fd, stdout_before, count as usize) {
            mode25_diagnostic_halt(MODE25_DIAG_D4);
        }
    } else {
        if linux_stderr_length() != stderr_before + count as usize
            || linux_stdout_length() != stdout_before
            || !emit_linux_stream(fd, stderr_before, count as usize) {
            mode25_diagnostic_halt(MODE25_DIAG_D4);
        }
    }
    if supervision_generation(SUPERVISION) == 1 {
        if LINUX_G1_REQUEST != 0 || linux_write_call_count() != 1 {
            fail_closed();
        }
        LINUX_G1_REQUEST = request;
        LINUX_REBIND_BARRIER = 1;
    }
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        volatile_store(
            (PHYSICALS[OBSERVER] + 32) as *mut u64,
            supervision_generation(SUPERVISION)
        );
    }
    return 1;
}

@export
@no_mangle
pub unsafe fn kernel_m6_defer_thread(thread: u64) -> u64 {
    if !linux_mode() || thread != THREADS[CLIENT] {
        return 0;
    }
    let published: u64 = volatile_load(
        (PHYSICALS[CLIENT] + 24) as *const u64
    );
    if CALL_CAP == 0
        || published == 0
        || (LINUX_REBIND_BARRIER != 0 && published != 2) {
        return 1;
    }
    return 0;
}

@export
@no_mangle
pub unsafe fn kernel_m6_linux_process_exit(
    process: u64,
    status: u64
) -> u64 {
    if ARMED == 0
        || !linux_mode()
        || process != PROCESSES[CLIENT]
        || status != 42
        || LINUX_EXIT_REQUESTED != status
        || LINUX_EXIT_RECORDED != 0
        || linux_process_exited(process) != 2
        || linux_fd_active_count() != 0
        || (ACTIVE_MODE == MODE_LINUX_PLAN9
            && bounded_active_count_for_caller(process) != 0)
        || (ACTIVE_MODE != MODE_LINUX_PLAN9
            && bounded_active_count() != 0)
        || !linux_invariants_hold() {
        return 0;
    }
    LINUX_EXIT_RECORDED = status;
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        write((&M7_EXIT_MESSAGE[0]), 46);
    } else {
        write((&LINUX_EXIT_MESSAGE[0]), 37);
    }
    return 1;
}

@export
@no_mangle
pub unsafe fn kernel_m6_personality_call(
    capability_object: u64,
    capability: u64,
    operation: u64,
    scalar: u64,
    timeout_ticks: u64
) -> u64 {
    if ARMED == 0 || ACTIVE_MODE != MODE_PERSONALITY {
        return ERR_NOT_IMPLEMENTED;
    }
    let caller: u64 = current_process_handle();
    let thread: u64 = current_thread_handle();
    if caller != PROCESSES[CLIENT]
        || thread != THREADS[CLIENT]
        || capability_object != PROCESSES[SERVICE]
        || CALL_CAP != capability
        || operation > 0xff
        || scalar > SCALAR_MASK {
        return ERR_CAPABILITY_DENIED;
    }
    let now: u64 = ticks();
    let mut deadline: u64 = 0;
    if timeout_ticks != 0 {
        if timeout_ticks > 1000000
            || now > INFINITE_DEADLINE - timeout_ticks {
            return ERR_PERSONALITY_UNSUPPORTED;
        }
        deadline = now + timeout_ticks;
    }
    let packed: u64 = (operation << 56) | scalar;
    let mut request: u64 = 0;
    let mut result: u64 = 0;
    let dispatch: u64 = dispatch_personality_call(
        caller,
        thread,
        packed,
        deadline,
        (&mut request),
        (&mut result)
    );
    if dispatch == RPC_CONSUMED {
        if operation == OP_HOLD_CANCEL {
            PENDING_CANCEL_REQUEST = 0;
        }
        return result;
    }
    if dispatch != RPC_DISPATCHED {
        return dispatch;
    }
    if operation == OP_HOLD_CANCEL {
        PENDING_CANCEL_REQUEST = request;
    }
    if operation == OP_CRASH {
        PENDING_CRASH_REQUEST = request;
    }
    let wait: u64 = arm_personality_wait(request);
    if (wait & 0xff00_0000) != 0xb300_0000 {
        return wait;
    }
    if commit_personality_wait(request, wait) != request {
        fail_closed();
    }
    let control: u64 = request_ipc_wait(wait, ERR_IPC_RETRY);
    if control != SYSCALL_CONTROL_SCHEDULE {
        if abort_personality_wait(request, wait) == 0 {
            fail_closed();
        }
        return control;
    }
    return control;
}

@export
@no_mangle
pub unsafe fn kernel_m6_personality_reply(
    capability_object: u64,
    request: u64,
    status: u64,
    scalar: u64
) -> u64 {
    let caller: u64 = current_process_handle();
    if ARMED == 0
        || ACTIVE_MODE != MODE_PERSONALITY
        || caller == 0
        || caller != PROCESSES[SERVICE]
        || capability_object != caller
        || request == 0
        || (status != 0 && status != ERR_PERSONALITY_UNSUPPORTED)
        || (status != 0 && scalar != 0) {
        return ERR_CAPABILITY_DENIED;
    }
    let mut result: u64 = scalar;
    if status != 0 {
        result = status;
    }
    let replied: u64 = reply_personality_request(request, caller, result);
    return replied;
}

@export
@no_mangle
pub unsafe fn kernel_m6_personality_supervise(
    capability_object: u64,
    action: u64,
    generation: u64,
    subject: u64
) -> u64 {
    let caller: u64 = current_process_handle();
    if ARMED == 0
        || caller != PROCESSES[SUPERVISOR]
        || capability_object != SUPERVISION
        || !supervision_is_current(SUPERVISION)
        || supervised_by_process(SUPERVISION) != caller
        || supervised_service_process(SUPERVISION) != PROCESSES[SERVICE]
        || supervision_generation(SUPERVISION) != generation {
        return ERR_PERSONALITY_STALE;
    }
    if action == SUPERVISE_PUBLISH {
        if subject != 0
            || (supervision_state(SUPERVISION)
                    != SUPERVISION_STATE_STARTING
                && supervision_state(SUPERVISION)
                    != SUPERVISION_STATE_REPLACEMENT_STARTING)
            || arm_monitor(
                SUPERVISION,
                caller,
                PROCESSES[SERVICE]
            ) != 1
            || !current_generation_monitor_was_armed(SUPERVISION)
            || (generation == 1
                && publish_personality_rpc(
                    PROCESSES[SERVICE],
                    generation,
                    PROTOCOL_ID,
                    REQUEST_ENDPOINT,
                    CLIENT_WAIT_ENDPOINT
                ) != 1)
            || !install_call_capability(generation) {
            if generation == 2 {
                mode25_diagnostic_halt(MODE25_DIAG_D5);
            }
            fail_closed();
        }
        return 1;
    }
    if action == SUPERVISE_MONITOR {
        if subject == 0 {
            if generation == 1 && SERVICE_FAULT_RECORDED == 1 {
                mode25_emit_post_s2_once(MODE25_DIAG_R0);
            }
            if current_generation_monitor_was_armed(SUPERVISION) {
                if generation == 1 && SERVICE_FAULT_RECORDED == 1 {
                    mode25_emit_post_s2_once(MODE25_DIAG_R0S);
                }
                return 1;
            }
            if supervision_state(SUPERVISION) == SUPERVISION_STATE_STARTING
                || supervision_state(SUPERVISION)
                    == SUPERVISION_STATE_REPLACEMENT_STARTING {
                if generation == 1 && SERVICE_FAULT_RECORDED == 1 {
                    mode25_reset_post_s2();
                    mode25_diagnostic_halt(MODE25_DIAG_R0B);
                }
                return ERR_PERSONALITY_BUSY;
            }
            if generation == 1 && SERVICE_FAULT_RECORDED == 1 {
                mode25_reset_post_s2();
                mode25_diagnostic_halt(MODE25_DIAG_R0B);
            }
            fail_closed();
        }
        if linux_mode()
            && subject == MONITOR_SERVICE_CRASH {
            if generation == 1 && SERVICE_FAULT_RECORDED == 1 {
                mode25_emit_post_s2_once(MODE25_DIAG_R1);
            }
            if generation == 1
                && SERVICE_FAULT_RECORDED == 1
                && supervision_state(SUPERVISION)
                    == SUPERVISION_STATE_CRASHED {
                mode25_emit_post_s2_once(MODE25_DIAG_R2);
                return 1;
            }
            return ERR_PERSONALITY_BUSY;
        }
        if supervision_state(SUPERVISION) != SUPERVISION_STATE_ACTIVE {
            return ERR_PERSONALITY_BUSY;
        }
        if subject == OP_HOLD_CANCEL
            || (ACTIVE_MODE == MODE_BOUNDED_PERSONALITY
                && (subject == OP_HOLD_UNMAP
                    || subject == OP_HOLD_REQUEST_REVOKE
                    || subject == OP_HOLD_RESOURCE_REVOKE
                    || subject == OP_HOLD_PROCESS_EXIT)) {
            if PENDING_CANCEL_REQUEST != 0
                && (ACTIVE_MODE != MODE_BOUNDED_PERSONALITY
                    || PENDING_LIFECYCLE_OPERATION == subject)
                && (ACTIVE_MODE != MODE_BOUNDED_PERSONALITY
                    || bounded_lookup_complete(PENDING_CANCEL_REQUEST))
                && personality_request_state(PENDING_CANCEL_REQUEST)
                    == RPC_STATE_WAITING {
                return PENDING_CANCEL_REQUEST;
            }
            return ERR_PERSONALITY_BUSY;
        }
        if subject == MONITOR_CLIENT_G2_COMPLETE {
            if ACTIVE_MODE == MODE_LINUX_PLAN9 {
                if generation == 2
                    && process_state(PROCESSES[CLIENT])
                        == PROCESS_STATE_REAPABLE
                    && exit_code_for(PROCESSES[CLIENT]) == 42
                    && LINUX_EXIT_RECORDED == 42
                    && linux_write_call_count() == 2
                    && linux_stdout_length() == 20
                    && linux_stderr_length() == 20
                    && volatile_load(
                        PHYSICALS[OBSERVER] as *const u64
                    ) == 4 {
                    return 1;
                }
                return ERR_PERSONALITY_BUSY;
            }
            if ACTIVE_MODE == MODE_LINUX_PERSONALITY {
                if generation == 2
                    && process_state(PROCESSES[CLIENT])
                        == PROCESS_STATE_REAPABLE
                    && exit_code_for(PROCESSES[CLIENT]) == 42
                    && LINUX_EXIT_RECORDED == 42
                    && linux_write_call_count() == 2
                    && linux_stdout_length() == 20
                    && linux_stderr_length() == 20 {
                    return 1;
                }
                return ERR_PERSONALITY_BUSY;
            }
            if generation == 2
                && volatile_load(PHYSICALS[CLIENT] as *const u64) == 7 {
                return 1;
            }
            return ERR_PERSONALITY_BUSY;
        }
        return ERR_PERSONALITY_UNSUPPORTED;
    }
    if action == SUPERVISE_CANCEL {
        if generation != 1 || subject == 0 {
            return ERR_PERSONALITY_STALE;
        }
        if ACTIVE_MODE == MODE_BOUNDED_PERSONALITY {
            let cancelled: u64 = cancel_bounded_request(subject);
            if cancelled == 1
                && PENDING_CANCEL_REQUEST == subject
                && PENDING_LIFECYCLE_OPERATION == OP_HOLD_CANCEL {
                PENDING_CANCEL_REQUEST = 0;
                PENDING_LIFECYCLE_OPERATION = 0;
            }
            return cancelled;
        }
        return cancel_personality_request(subject);
    }
    if action == SUPERVISE_UNMAP
        || action == SUPERVISE_REQUEST_REVOKE
        || action == SUPERVISE_RESOURCE_REVOKE
        || action == SUPERVISE_PROCESS_EXIT {
        if ACTIVE_MODE != MODE_BOUNDED_PERSONALITY
            || generation != 2
            || subject == 0
            || subject != PENDING_CANCEL_REQUEST
            || personality_request_state(subject) != RPC_STATE_WAITING
            || ((action == SUPERVISE_UNMAP
                    && PENDING_LIFECYCLE_OPERATION != OP_HOLD_UNMAP)
                || (action == SUPERVISE_REQUEST_REVOKE
                    && PENDING_LIFECYCLE_OPERATION
                        != OP_HOLD_REQUEST_REVOKE)
                || (action == SUPERVISE_RESOURCE_REVOKE
                    && PENDING_LIFECYCLE_OPERATION
                        != OP_HOLD_RESOURCE_REVOKE)
                || (action == SUPERVISE_PROCESS_EXIT
                    && PENDING_LIFECYCLE_OPERATION
                        != OP_HOLD_PROCESS_EXIT)) {
            return ERR_PERSONALITY_STALE;
        }
        let mut disposition: u64 = 0;
        if action == SUPERVISE_UNMAP {
            disposition = unmap_bounded_request(subject);
        }
        if action == SUPERVISE_REQUEST_REVOKE {
            disposition = revoke_bounded_request(subject);
        }
        if action == SUPERVISE_RESOURCE_REVOKE {
            let mut resource_capability: u64 = 0;
            if delegate_bounded_resource(
                subject,
                DELEGATED_RESOURCE_DEVICE,
                (&mut resource_capability)
            ) != 1
                || resource_capability == 0 {
                fail_closed();
            }
            disposition = revoke_bounded_resource(subject);
        }
        if action == SUPERVISE_PROCESS_EXIT {
            if bounded_caller_exited(PROCESSES[CLIENT]) != 1
                || terminate_process(PROCESSES[CLIENT]) != 1
                || stop_process(PROCESSES[CLIENT], 0x79) != 1
                || process_state(PROCESSES[CLIENT])
                    != PROCESS_STATE_REAPABLE
                || thread_state(THREADS[CLIENT])
                    != THREAD_STATE_EXITED
                || CLIENT_EXIT_TEARDOWNS
                    == 0xffff_ffff_ffff_ffff {
                fail_closed();
            }
            CLIENT_EXIT_TEARDOWNS += 1;
            disposition = 1;
        }
        if disposition != 1 {
            fail_closed();
        }
        PENDING_CANCEL_REQUEST = 0;
        PENDING_LIFECYCLE_OPERATION = 0;
        return 1;
    }
    if action == SUPERVISE_RESTART {
        if generation != 1 || subject != 2 {
            return ERR_PERSONALITY_STALE;
        }
        mode25_emit_post_s2_once(MODE25_DIAG_R3);
        let restarted: u64 = request_restart(
            SUPERVISION,
            caller,
            PROCESSES[SERVICE]
        );
        if restarted == 1 {
            if !current_generation_monitor_was_armed(SUPERVISION) {
                mode25_emit(MODE25_DIAG_C10);
                mode25_reset_post_s2();
                fail_closed();
            }
            mode25_emit(MODE25_DIAG_S3);
        } else {
            mode25_emit(MODE25_DIAG_C10);
        }
        mode25_reset_post_s2();
        return restarted;
    }
    if action == SUPERVISE_STOP {
        if generation != 2 || subject != 0 {
            return ERR_PERSONALITY_STALE;
        }
        let stopped: u64 = request_stop(
            SUPERVISION,
            caller,
            PROCESSES[SERVICE]
        );
        if stopped == 1
            && !current_generation_monitor_was_armed(SUPERVISION) {
            fail_closed();
        }
        return stopped;
    }
    return ERR_PERSONALITY_UNSUPPORTED;
}

@export
@no_mangle
pub unsafe fn kernel_m6_service_fault(process: u64) -> u64 {
    mode25_emit(MODE25_DIAG_S1);
    if ARMED == 0
        || SERVICE_FAULT_RECORDED != 0
        || process != PROCESSES[SERVICE]
        || supervision_state(SUPERVISION) != SUPERVISION_STATE_ACTIVE
        || volatile_load(PHYSICALS[SERVICE] as *const u64) != 7 {
        return 0;
    }
    if linux_mode() {
        PRIOR_REQUEST = LINUX_G1_REQUEST;
        if PRIOR_REQUEST == 0
            || linux_write_call_count() != 1
            || linux_stdout_length() != 20
            || linux_stderr_length() != 0 {
            return 0;
        }
        if bounded_active_count() != 1 {
            return 0;
        }
        if bounded_terminal_count() != 1 {
            return 0;
        }
        if ACTIVE_MODE == MODE_LINUX_PLAN9
            && (bounded_dispatch_count() != 12
                || bounded_lookup_count() != 12
                || bounded_reply_count() != 12
                || bounded_consumed_count() != 11) {
            return 0;
        }
        if bounded_charged_bytes() != 20 {
            return 0;
        }
        if personality_service_died(process) != 0 {
            return 0;
        }
        if linux_service_generation_died(process, 1) != 2
            || linux_fd_active_count() != 0 {
            return 0;
        }
        if ipc_process_died(process) == 0 {
            return 0;
        }
        if record_crash(process) != 1 {
            return 0;
        }
        if !current_generation_monitor_was_armed(SUPERVISION) {
            return 0;
        }
        if !personality_rpc_invariants_hold()
            || !bounded_rpc_invariants_hold()
            || !linux_invariants_hold()
            || !supervision_invariants_hold() {
            return 0;
        }
        volatile_store((PHYSICALS[CLIENT] + 24) as *mut u64, 0);
        volatile_store((PHYSICALS[SERVICE] + 24) as *mut u64, 0);
        volatile_store((PHYSICALS[SUPERVISOR] + 24) as *mut u64, 0);
        SERVICE_FAULT_RECORDED = 1;
        mode25_arm_post_s2();
        mode25_emit(MODE25_DIAG_S2);
        return 1;
    }
    PRIOR_REQUEST = PENDING_CRASH_REQUEST;
    let mut failed_requests: u64 = 0;
    if ACTIVE_MODE == MODE_BOUNDED_PERSONALITY {
        failed_requests = bounded_service_died(process);
    } else {
        failed_requests = personality_service_died(process);
    }
    if PRIOR_REQUEST == 0
        || failed_requests != 1
        || ipc_process_died(process) == 0
        || record_crash(process) != 1
        || !current_generation_monitor_was_armed(SUPERVISION)
        || !personality_rpc_invariants_hold()
        || (ACTIVE_MODE == MODE_BOUNDED_PERSONALITY
            && !bounded_rpc_invariants_hold())
        || !supervision_invariants_hold() {
        return 0;
    }
    volatile_store((PHYSICALS[CLIENT] + 24) as *mut u64, 0);
    volatile_store((PHYSICALS[SUPERVISOR] + 24) as *mut u64, 0);
    SERVICE_FAULT_RECORDED = 1;
    return 1;
}

@export
@no_mangle
pub unsafe fn kernel_m6_expire_requests(now: u64) -> u64 {
    if ARMED == 0 || now == 0 {
        return 0;
    }
    let mut result: u64 = 0;
    if bounded_mode() {
        let next: u64 = bounded_next_deadline();
        if next == INFINITE_DEADLINE {
            if linux_mode() {
                return 1;
            }
            return 0;
        }
        if next == 0 || now < next {
            return 1;
        }
        result = expire_bounded_requests(now);
    } else {
        result = expire_personality_requests(now);
    }
    if result <= 4 {
        return 1;
    }
    return 0;
}


        || rpc_terminal_count() != 9
        || rpc_terminal_wake_count() != 9
        || rpc_consumed_count() != 9
        || rpc_history_count() != 9
        || rpc_history_eviction_count() != 0
        || rpc_reply_count() != 6
        || rpc_cancel_count() != 1
        || rpc_expiry_count() != 1
        || rpc_death_terminal_count() != 1
        || rpc_death_event_count() != 1
        || rpc_stale_count() != 1
        || rpc_late_count() != 2
        || rpc_duplicate_count() != 1
        || rpc_replacement_count() != 1
        || !personality_rpc_invariants_hold()
        || !supervision_invariants_hold() {
        return 0;
    }
    return 1;
}

@export
@no_mangle
pub unsafe fn kernel_m6_crash_continue() -> never {
    mode25_emit(MODE25_DIAG_S4);
    mode25_reset_post_s2();
    if !management_context()
        || scheduler_failed()
        || !scheduler_complete()
        || completion_kind()
            != SCHEDULER_COMPLETION_PERSONALITY_CRASH
        || personality_fault_containments() != 1
        || context_switches() < 4
        || runnable_count() != 3
        || blocked_count() != 0
        || !personality_rpc_invariants_hold()
        || (ACTIVE_MODE == MODE_BOUNDED_PERSONALITY
            && (!bounded_rpc_invariants_hold()
                || bounded_active_count() != 0
                || bounded_charged_bytes() != 0))
        || (linux_mode()
            && (!bounded_rpc_invariants_hold()
                || bounded_active_count() != 1
                || (ACTIVE_MODE == MODE_LINUX_PERSONALITY
                    && bounded_terminal_count() != 1)
                || (ACTIVE_MODE == MODE_LINUX_PLAN9
                    && (bounded_terminal_count() != 1
                        || bounded_dispatch_count() != 12
                        || bounded_lookup_count() != 12
                        || bounded_reply_count() != 12
                        || bounded_consumed_count() != 11))
                || bounded_charged_bytes() != 20
                || !linux_invariants_hold()
                || linux_fd_active_count() != 0))
        || !supervision_invariants_hold() {
        mode25_diagnostic_halt(MODE25_DIAG_C1);
    }
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        write((&M7_FAULT_MESSAGE[0]), 46);
        write((&M7_SURVIVOR_MESSAGE[0]), 49);
    }
    if ACTIVE_MODE == MODE_LINUX_PERSONALITY {
        write((&LINUX_FAULT_MESSAGE[0]), 41);
        write((&LINUX_SURVIVOR_MESSAGE[0]), 40);
    }
    if ACTIVE_MODE == MODE_BOUNDED_PERSONALITY {
        write((&BOUNDED_FAULT_MESSAGE[0]), 41);
        write((&BOUNDED_SURVIVOR_MESSAGE[0]), 40);
    }
    if ACTIVE_MODE == MODE_PERSONALITY {
        write((&FAULT_MESSAGE[0]), 40);
        write((&TERMINAL_MESSAGE[0]), 41);
        write((&SURVIVOR_MESSAGE[0]), 35);
    }

    STALE_SERVICE_PROCESS = PROCESSES[SERVICE];
    STALE_SERVICE_THREAD = THREADS[SERVICE];
    STALE_SERVICE_CSPACE = CSPACES[SERVICE];
    STALE_SERVICE_ADDRESS_SPACE = ADDRESS_SPACES[SERVICE];
    OBSERVER_RESTART_SNAPSHOT = volatile_load(
        PHYSICALS[OBSERVER] as *const u64
    );
    if !revoke_call_capability() {
        mode25_diagnostic_halt(MODE25_DIAG_C2);
    }
    mode25_emit(MODE25_DIAG_S5);
    if ACTIVE_MODE == MODE_LINUX_PLAN9
        && (PLAN9_CALL_CAP != 0
            || capability_handle_at(CSPACES[OBSERVER], 1) != 0) {
        mode25_diagnostic_halt(MODE25_DIAG_C3);
    }
    if !close_generation_endpoints() {
        mode25_diagnostic_halt(MODE25_DIAG_C4);
    }
    mode25_emit(MODE25_DIAG_S6);
    if reap_thread(STALE_SERVICE_THREAD) == 0
        || thread_is_live(STALE_SERVICE_THREAD) {
        mode25_diagnostic_halt(MODE25_DIAG_C5);
    }
    if unbind_process(
            NAMESPACES[SERVICE],
            STALE_SERVICE_PROCESS
        ) == 0 {
        mode25_diagnostic_halt(MODE25_DIAG_C6);
    }
    if !reap_loaded_process(SERVICE) {
        mode25_diagnostic_halt(MODE25_DIAG_C7);
    }
    mode25_emit(MODE25_DIAG_S7);
    if !create_replacement_service()
        || PROCESSES[SERVICE] == STALE_SERVICE_PROCESS
        || THREADS[SERVICE] == STALE_SERVICE_THREAD
        || CSPACES[SERVICE] == STALE_SERVICE_CSPACE
        || ADDRESS_SPACES[SERVICE] == STALE_SERVICE_ADDRESS_SPACE
        || process_state(STALE_SERVICE_PROCESS) != 0
        || thread_is_live(STALE_SERVICE_THREAD)
        || cspace_is_live(STALE_SERVICE_CSPACE)
        || address_space_is_live(STALE_SERVICE_ADDRESS_SPACE)
        || validation_count() != 5
        || commit_count() != 5
        || (linux_mode()
            && (linux_fd_active_count() != 2
                || linux_fd_creation_count() != 4
                || linux_fd_revocation_count() != 2
                || !linux_invariants_hold())) {
        mode25_diagnostic_halt(MODE25_DIAG_C8);
    }
    mode25_emit(MODE25_DIAG_S8);

    disable_interrupts();
    if arm_personality_restart(
        THREADS[CLIENT],
        PROCESSES[CLIENT],
        PHYSICALS[CLIENT],
        THREADS[SERVICE],
        PROCESSES[SERVICE],
        PHYSICALS[SERVICE],
        THREADS[SUPERVISOR],
        PROCESSES[SUPERVISOR],
        PHYSICALS[SUPERVISOR],
        THREADS[OBSERVER],
        PROCESSES[OBSERVER],
        PHYSICALS[OBSERVER]
    ) == 0 {
        mode25_diagnostic_halt(MODE25_DIAG_C9);
    }
    mode25_emit(MODE25_DIAG_S9);
    enable_interrupts();
    loop {
        halt();
    }
}

@export
@no_mangle
pub unsafe fn kernel_m6_complete_continue() -> never {
    mode25_emit(MODE25_DIAG_S10);
    if !management_context()
        || scheduler_failed()
        || !scheduler_complete()
        || completion_kind() != SCHEDULER_COMPLETION_PERSONALITY
        || personality_fault_containments() != 1
        || runnable_count() != 0
        || blocked_count() != 0
        || !loaded_protections_all_hold()
        || !personality_rpc_invariants_hold()
        || (bounded_mode()
            && (!bounded_rpc_invariants_hold()
                || bounded_active_count() != 0
                || bounded_charged_bytes() != 0))
        || (linux_mode()
            && (!linux_invariants_hold()
                || linux_fd_active_count() != 0
                || LINUX_EXIT_RECORDED != 42))
        || !supervision_invariants_hold() {
        mode25_diagnostic_halt(MODE25_DIAG_F1);
    }
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        write((&M7_TERMINAL_MESSAGE[0]), 37);
    }
    if ACTIVE_MODE == MODE_LINUX_PERSONALITY {
        write((&LINUX_TERMINAL_MESSAGE[0]), 44);
    }
    if ACTIVE_MODE == MODE_BOUNDED_PERSONALITY {
        write((&BOUNDED_TERMINAL_MESSAGE[0]), 51);
        write((&BOUNDED_ADMIN_MESSAGE[0]), 58);
    }
    if ACTIVE_MODE == MODE_PERSONALITY {
        write((&REBIND_MESSAGE[0]), 32);
        write((&POLICY_MESSAGE[0]), 37);
        write((&STALE_MESSAGE[0]), 41);
    }

    if !revoke_call_capability()
        || close_capability_for_owner(
            CSPACES[SUPERVISOR],
            SUPERVISION_CAP
        ) == 0
        || !close_generation_endpoints()
        || release_endpoint(CLIENT_WAIT_ENDPOINT) == 0
        || endpoint_is_live(CLIENT_WAIT_ENDPOINT)
        || endpoint_is_draining(CLIENT_WAIT_ENDPOINT)
        {
        mode25_diagnostic_halt(MODE25_DIAG_F2);
    }
    SUPERVISION_CAP = 0;
    CLIENT_WAIT_ENDPOINT = 0;
    mode25_emit(MODE25_DIAG_S11);

    let mut namespace_index: usize = 0;
    while namespace_index < PROCESS_COUNT {
        if begin_namespace_teardown(NAMESPACES[namespace_index]) == 0
            || teardown_mount_namespace(NAMESPACES[namespace_index]) == 0
            || root_mount_for(NAMESPACES[namespace_index]) != 0
            || release_quiescent_processes(
                NAMESPACES[namespace_index]
            ) == 0
            || namespace_process_refs(NAMESPACES[namespace_index]) != 0 {
            mode25_diagnostic_halt(MODE25_DIAG_F3);
        }
        ROOT_MOUNTS[namespace_index] = 0;
        namespace_index += 1;
    }
    mode25_emit(MODE25_DIAG_S12);

    let mut index: usize = 0;
    while index < PROCESS_COUNT {
        if reap_thread(THREADS[index]) == 0
            || thread_is_live(THREADS[index])
            || !reap_loaded_process(index) {
            mode25_diagnostic_halt(MODE25_DIAG_F4);
        }
        index += 1;
    }
    if destroy_image(IMAGE) == 0 || image_id_for(IMAGE) != 0 {
        mode25_diagnostic_halt(MODE25_DIAG_F5);
    }
    mode25_emit(MODE25_DIAG_S13);
    namespace_index = 0;
    while namespace_index < PROCESS_COUNT {
        if finish_namespace_teardown(NAMESPACES[namespace_index]) == 0
            || namespace_is_live(NAMESPACES[namespace_index]) {
            mode25_diagnostic_halt(MODE25_DIAG_F6);
        }
        namespace_index += 1;
    }
    if domain_child_refs(DOMAINS[CLIENT]) != 0
        || domain_child_refs(DOMAINS[SERVICE]) != 0
        || domain_child_refs(DOMAINS[SUPERVISOR]) != 0
        || domain_child_refs(DOMAINS[OBSERVER]) != 0
        || destroy_domain(DOMAINS[CLIENT]) == 0
        || destroy_domain(DOMAINS[SERVICE]) == 0
        || destroy_domain(DOMAINS[SUPERVISOR]) == 0
        || (ACTIVE_MODE == MODE_LINUX_PLAN9
            && destroy_domain(DOMAINS[OBSERVER]) == 0)
        || free_frames() != BASELINE_FREE
        || !page_invariants_hold()
        || !mapping_invariants_hold()
        || !memory_invariants_hold()
        || !capability_invariants_hold()
        || !endpoint_invariants_hold()
        || !thread_invariants_hold()
        || !namespace_invariants_hold()
        || !image_invariants_hold()
        || !elf_invariants_hold() {
        mode25_diagnostic_halt(MODE25_DIAG_F7);
    }
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        write((&M7_CLEANUP_MESSAGE[0]), 38);
    }
    if ACTIVE_MODE == MODE_LINUX_PERSONALITY {
        write((&LINUX_CLEANUP_MESSAGE[0]), 35);
    }
    if ACTIVE_MODE == MODE_BOUNDED_PERSONALITY {
        write((&BOUNDED_CLEANUP_MESSAGE[0]), 41);
    }
    if ACTIVE_MODE == MODE_PERSONALITY {
        write((&RECLAIM_MESSAGE[0]), 30);
        write((&LIVE_MESSAGE[0]), 37);
    }

    let tick_before: u64 = ticks();
    mode25_emit(MODE25_DIAG_S14);
    enable_interrupts();
    while ticks() == tick_before {
        halt();
    }
    if ACTIVE_MODE == MODE_LINUX_PLAN9 {
        write((&M7_POST_TIMER_MESSAGE[0]), 41);
    }
    if ACTIVE_MODE == MODE_LINUX_PERSONALITY {
        write((&LINUX_POST_TIMER_MESSAGE[0]), 38);
    }
    if ACTIVE_MODE == MODE_BOUNDED_PERSONALITY {
        write((&BOUNDED_POST_TIMER_MESSAGE[0]), 38);
    }
    if ACTIVE_MODE == MODE_PERSONALITY {
        write((&POST_TIMER_MESSAGE[0]), 33);
    }
    loop {
        halt();
    }
}

pub unsafe fn start(mode: u64, native_domain: u64) -> never {
    if (mode != MODE_LINUX_PERSONALITY && mode != MODE_LINUX_PLAN9)
        || native_domain == 0
        || ARMED != 0
        || !management_context()
        || threads_init() == 0
        || threads_init() != 0
        || namespaces_init() == 0
        || namespaces_init() != 0
        || image_vfs_init() == 0
        || image_vfs_init() != 0
        || sha256_selftest() != 1
        || elf_loader_init() == 0
        || elf_loader_init() != 0
        || personality_supervision_init() == 0
        || linux_personality_init() != 1
        || !supervision_invariants_hold() {
        fail_closed();
    }
    ACTIVE_MODE = mode;
    mode25_reset_post_s2();
    PENDING_CANCEL_REQUEST = 0;
    PENDING_LIFECYCLE_OPERATION = 0;
    PENDING_CRASH_REQUEST = 0;
    CLIENT_EXIT_TEARDOWNS = 0;
    LINUX_G1_REQUEST = 0;
    LINUX_REBIND_BARRIER = 0;
    LINUX_EXIT_REQUESTED = 0;
    LINUX_EXIT_RECORDED = 0;
    LINUX_STDOUT_OBJECT = 0;
    LINUX_STDERR_OBJECT = 0;
    LINUX_G1_STDOUT_OBJECT = 0;
    LINUX_G1_STDERR_OBJECT = 0;
    CALL_CAP = 0;
    G1_CALL_CAP = 0;
    G2_CALL_CAP = 0;
    PLAN9_CALL_CAP = 0;
    PLAN9_G1_CALL_CAP = 0;
    PLAN9_G2_CALL_CAP = 0;
    DOMAINS[CLIENT] = create_domain(
        1,
        0x601,
        PERSONALITY_LINUX_MINIMAL,
        LINUX_MINIMAL_ABI_V1
    );
    DOMAINS[SERVICE] = create_domain(
        2,
        0x602,
        PERSONALITY_NATIVE,
        NATIVE_ABI_V1
    );
    DOMAINS[SUPERVISOR] = create_domain(
        3,
        0x603,
        PERSONALITY_NATIVE,
        NATIVE_ABI_V1
    );
    if mode == MODE_LINUX_PLAN9 {
        DOMAINS[OBSERVER] = create_domain(
            4,
            0x604,
            PERSONALITY_PLAN9_9P2000,
            PLAN9_9P2000_ABI_V1
        );
    } else {
        DOMAINS[OBSERVER] = native_domain;
    }
    if !distinct_four_u64((&DOMAINS[0])) {
        fail_closed();
    }
    let mut image_start: usize = ocore_m6_linux_image_start();
    let mut image_end: usize = ocore_m6_linux_image_end();
    let mut image_length: usize = LINUX_IMAGE_LENGTH;
    let mut image_id: u64 = LINUX_IMAGE_ID;
    let mut image_digest_0: u64 = LINUX_IMAGE_DIGEST_0;
    let mut image_digest_1: u64 = LINUX_IMAGE_DIGEST_1;
    let mut image_digest_2: u64 = LINUX_IMAGE_DIGEST_2;
    let mut image_digest_3: u64 = LINUX_IMAGE_DIGEST_3;
    let mut image_sha_0: u64 = LINUX_IMAGE_SHA_0;
    let mut image_sha_1: u64 = LINUX_IMAGE_SHA_1;
    let mut image_sha_2: u64 = LINUX_IMAGE_SHA_2;
    let mut image_sha_3: u64 = LINUX_IMAGE_SHA_3;
    if mode == MODE_LINUX_PLAN9 {
        image_start = ocore_m7_linux_plan9_image_start();
        image_end = ocore_m7_linux_plan9_image_end();
        image_length = M7_IMAGE_LENGTH;
        image_id = M7_IMAGE_ID;
        image_digest_0 = M7_IMAGE_DIGEST_0;
        image_digest_1 = M7_IMAGE_DIGEST_1;
        image_digest_2 = M7_IMAGE_DIGEST_2;
        image_digest_3 = M7_IMAGE_DIGEST_3;
        image_sha_0 = M7_IMAGE_SHA_0;
        image_sha_1 = M7_IMAGE_SHA_1;
        image_sha_2 = M7_IMAGE_SHA_2;
        image_sha_3 = M7_IMAGE_SHA_3;
    }
    let mut index: usize = 0;
    if image_start == 0
        || image_end <= image_start
        || image_end - image_start != image_length
        || image_length > IMAGE_BYTE_CAPACITY {
        fail_closed();
    }
    IMAGE = begin_image(
        0,
        image_id,
        image_length,
        image_digest_0,
        image_digest_1,
        image_digest_2,
        image_digest_3
    );
    if IMAGE == 0 {
        fail_closed();
    }
    if append_image_bytes(
        IMAGE,
        image_start as *const u8,
        image_length
    ) == 0 {
        fail_closed();
    }
    if verify_image_sha256(
        IMAGE,
        image_sha_0,
        image_sha_1,
        image_sha_2,
        image_sha_3
    ) != 1 {
        fail_closed();
    }
    if import_ovfs_image(IMAGE) != OVFS_IMPORT_OK {
        fail_closed();
    }
    if publish_image(IMAGE) == 0 {
        fail_closed();
    }
    index = 0;
    while index < PROCESS_COUNT {
        NAMESPACES[index] = create_namespace(index, DOMAINS[index]);
        ROOT_MOUNTS[index] = mount_root(NAMESPACES[index], IMAGE);
        if NAMESPACES[index] == 0
            || ROOT_MOUNTS[index] == 0
            || root_mount_for(NAMESPACES[index]) != ROOT_MOUNTS[index] {
            fail_closed();
        }
        index += 1;
    }
    if image_id_for(IMAGE) != image_id || !image_invariants_hold() {
        fail_closed();
    }
    if mode == MODE_LINUX_PLAN9 {
        write((&M7_IMAGE_MESSAGE[0]), 36);
    } else {
        write((&LINUX_IMAGE_MESSAGE[0]), 33);
    }

    index = 0;
    while index < PROCESS_COUNT {
        PLANS[index] = load_plan(index, path_id(index));
        if PLANS[index] == 0 {
            fail_closed();
        }
        index += 1;
    }
    if !distinct_four_u64((&PLANS[0]))
        || validation_count() != PROCESS_COUNT as u64 {
        fail_closed();
    }

    BASELINE_FREE = free_frames();
    index = 0;
    while index < PROCESS_COUNT {
        CSPACES[index] = cspace_handle_for_slot(index);
        if CSPACES[index] == 0
            || set_quota_for_owner(CSPACES[index], QUOTA) == 0 {
            fail_closed();
        }
        ADDRESS_SPACES[index] = create_loaded_for_owner(
            CSPACES[index],
            PLANS[index]
        );
        PHYSICALS[index] = isolation_physical(ADDRESS_SPACES[index]);
        if ADDRESS_SPACES[index] == 0
            || PHYSICALS[index] == 0
            || !is_loaded(ADDRESS_SPACES[index])
            || loaded_entry(ADDRESS_SPACES[index]) == 0
            || loaded_stack_pointer(ADDRESS_SPACES[index]) == 0
            || loaded_frame_count(ADDRESS_SPACES[index]) == 0
            || root_cr3(ADDRESS_SPACES[index]) == ocore_management_cr3()
            || !loaded_protections_hold(ADDRESS_SPACES[index])
            || release_plan(PLANS[index]) == 0 {
            fail_closed();
        }
        index += 1;
    }
    if !distinct_four_u64((&ADDRESS_SPACES[0]))
        || !distinct_four_usize((&PHYSICALS[0]))
        || commit_count() != PROCESS_COUNT as u64
        || !elf_invariants_hold() {
        fail_closed();
    }
    if mode == MODE_LINUX_PLAN9 {
        write((&M7_LOAD_MESSAGE[0]), 44);
        write((&M7_WX_MESSAGE[0]), 36);
    } else {
        write((&LINUX_LOAD_MESSAGE[0]), 39);
        write((&LINUX_WX_MESSAGE[0]), 40);
    }

    index = 0;
    while index < PROCESS_COUNT {
        PROCESSES[index] = install_process_for_owner(
            index,
            1801 + index as u64,
            DOMAINS[index],
            ADDRESS_SPACES[index],
            CSPACES[index],
            ocore_process_kernel_stack_top(index),
            loaded_entry(ADDRESS_SPACES[index]),
            loaded_stack_pointer(ADDRESS_SPACES[index])
        );
        if PROCESSES[index] == 0
            || bind_process(NAMESPACES[index], PROCESSES[index]) == 0 {
            fail_closed();
        }
        DEBUG_CAPS[index] = install_capability_for_owner(
            CSPACES[index],
            0,
            0x660 + index as u64,
            OBJECT_DEBUG,
            RIGHT_DEBUG_WRITE
        );
        if DEBUG_CAPS[index] == 0
            || capability_handle_at(CSPACES[index], 0)
                != DEBUG_CAPS[index] {
            fail_closed();
        }
        index += 1;
    }

    CLIENT_WAIT_ENDPOINT = create_endpoint(CSPACES[CLIENT]);
    if CLIENT_WAIT_ENDPOINT == 0 || !create_generation_endpoints() {
        fail_closed();
    }
    SUPERVISION = publish_supervision(
        PROCESSES[SUPERVISOR],
        PROCESSES[SERVICE],
        SERVICE_ID,
        PROTOCOL_ID
    );
    SUPERVISION_CAP = install_capability_for_owner(
        CSPACES[SUPERVISOR],
        1,
        SUPERVISION,
        OBJECT_PERSONALITY_SUPERVISION,
        RIGHT_PERSONALITY_SUPERVISE
    );
    if SUPERVISION == 0
        || SUPERVISION_CAP == 0
        || supervision_state(SUPERVISION) != SUPERVISION_STATE_STARTING
        || current_generation_monitor_was_armed(SUPERVISION)
        || publish_count() != 1
        || personality_rpc_init() != 1 {
        fail_closed();
    }
    if bounded_rpc_init() != 1 {
        fail_closed();
    }
    let mut stdout_object: u64 = 0;
    let mut stderr_object: u64 = 0;
    if provision_linux_process(
        PROCESSES[CLIENT],
        PROCESSES[SERVICE],
        1,
        (&mut stdout_object),
        (&mut stderr_object)
    ) != 1
        || stdout_object == 0
        || stderr_object == 0
        || stdout_object == stderr_object {
        fail_closed();
    }
    LINUX_STDOUT_OBJECT = stdout_object;
    LINUX_STDERR_OBJECT = stderr_object;
    LINUX_G1_STDOUT_OBJECT = stdout_object;
    LINUX_G1_STDERR_OBJECT = stderr_object;
    seed_generation_config(1);
    if capability_handle_at(CSPACES[CLIENT], 1) != 0
        || volatile_load((PHYSICALS[CLIENT] + 8) as *const u64) != 0
        || volatile_load((PHYSICALS[CLIENT] + 24) as *const u64) != 0
        || supervision_state(SUPERVISION) != SUPERVISION_STATE_STARTING
        || !personality_rpc_invariants_hold()
        || !bounded_rpc_invariants_hold()
        || !linux_invariants_hold()
        || linux_fd_active_count() != 2
        || !supervision_invariants_hold() {
        fail_closed();
    }
    if mode == MODE_LINUX_PLAN9
        && (capability_handle_at(CSPACES[OBSERVER], 1) != 0
            || volatile_load(
                (PHYSICALS[OBSERVER] + 8) as *const u64
            ) != 0
            || volatile_load(
                (PHYSICALS[OBSERVER] + 24) as *const u64
            ) != 0) {
        fail_closed();
    }
    if mode == MODE_LINUX_PLAN9 {
        write((&M7_CSPACE_MESSAGE[0]), 45);
        write((&M7_PRIVATE_MESSAGE[0]), 46);
    } else {
        write((&LINUX_CSPACE_MESSAGE[0]), 44);
        write((&LINUX_PRIVATE_MESSAGE[0]), 49);
    }

    index = 0;
    while index < PROCESS_COUNT {
        let mut argument: u64 = 0;
        let mut role: u64 = THREAD_ROLE_BLOCKING;
        if index == SERVICE {
            argument = 1;
        }
        if index == SUPERVISOR {
            argument = SUPERVISION_CAP;
        }
        if index == OBSERVER && mode == MODE_LINUX_PERSONALITY {
            role = THREAD_ROLE_CPU;
        }
        THREADS[index] = install_loaded_thread(
            index,
            1901 + index as u64,
            PROCESSES[index],
            loaded_entry(ADDRESS_SPACES[index]),
            loaded_stack_pointer(ADDRESS_SPACES[index]),
            ocore_process_kernel_stack_top(index),
            DEBUG_CAPS[index],
            argument,
            role,
            1
        );
        if THREADS[index] == 0 {
            fail_closed();
        }
        index += 1;
    }
    index = 0;
    while index < PROCESS_COUNT {
        if namespace_process_refs(NAMESPACES[index]) != 1 {
            fail_closed();
        }
        index += 1;
    }
    if !namespace_invariants_hold()
        || !thread_invariants_hold()
        || !capability_invariants_hold()
        || !endpoint_invariants_hold()
        || !personality_rpc_invariants_hold()
        || !bounded_rpc_invariants_hold()
        || !linux_invariants_hold()
        || !supervision_invariants_hold() {
        fail_closed();
    }
    ARMED = 1;

    disable_interrupts();
    if arm_personality(
        THREADS[CLIENT],
        PROCESSES[CLIENT],
        PHYSICALS[CLIENT],
        THREADS[SERVICE],
        PROCESSES[SERVICE],
        PHYSICALS[SERVICE],
        THREADS[SUPERVISOR],
        PROCESSES[SUPERVISOR],
        PHYSICALS[SUPERVISOR],
        THREADS[OBSERVER],
        PROCESSES[OBSERVER],
        PHYSICALS[OBSERVER]
    ) == 0 {
        fail_closed();
    }
    if mode == MODE_LINUX_PLAN9 {
        write((&M7_ARMED_MESSAGE[0]), 37);
    } else {
        write((&LINUX_ARMED_MESSAGE[0]), 42);
    }
    enable_interrupts();
    loop {
        halt();
    }
}

@export
@no_mangle
pub unsafe fn kernel_m6_phase_one_ready() -> u64 { return 0; }

@export
@no_mangle
pub unsafe fn kernel_m6_final_ready() -> u64 { return 0; }

@export
@no_mangle
pub unsafe fn kernel_m6_crash_continue() -> never {
    disable_interrupts();
    loop { halt(); }
}

@export
@no_mangle
pub unsafe fn kernel_m6_complete_continue() -> never {
    disable_interrupts();
    loop { halt(); }
}

pub unsafe fn start(mode: u64, native_domain: u64) -> never {
    let _unused_mode: u64 = mode;
    let _unused_domain: u64 = native_domain;
    disable_interrupts();
    loop { halt(); }
}

module kernel::m6;

use runtime::native_abi::ERR_NOT_IMPLEMENTED;

// Modes 18, 24, and 25 link a packaged personality-supervision harness.
// Scheduler and syscall code retain total, fail-closed adapter symbols in all
// other kernels without pulling those runtimes and oracles into unrelated
// bootstrap images.
@export
@no_mangle
pub unsafe fn kernel_m6_prepare_bounded_resume(
    thread: u64,
    result_out: *mut u64
) -> u64 {
    let _unused_thread: u64 = thread;
    if result_out as usize != 0 {
        volatile_store(result_out, 0);
    }
    return 0;
}

@export
@no_mangle
pub unsafe fn kernel_m6_commit_bounded_resume(thread: u64) -> u64 {
    let _unused_thread: u64 = thread;
    return 0;
}

@export
@no_mangle
pub unsafe fn kernel_m6_bounded_call(
    capability_object: u64,
    capability: u64,
    operation: u64,
    foreign_address: u64,
    length: u64,
    direction: u64,
    timeout_ticks: u64
) -> u64 {
    let _unused_object: u64 = capability_object;
    let _unused_capability: u64 = capability;
    let _unused_operation: u64 = operation;
    let _unused_address: u64 = foreign_address;
    let _unused_length: u64 = length;
    let _unused_direction: u64 = direction;
    let _unused_timeout: u64 = timeout_ticks;
    return ERR_NOT_IMPLEMENTED;
}


static SUPERVISED_UNRELATED_MESSAGE: [u8; 56] =
    b"KW unrelated live service survived VMEXIT failure: PASS\n";
static SUPERVISED_RESTART_MESSAGE: [u8; 57] =
    b"KW generation-2 guest/device rebind + stale denial: PASS\n";
static SUPERVISED_COMPLETE_MESSAGE: [u8; 49] =
    b"KW supervised execution-device reclamation: PASS\n";
static POST_SUPERVISED_TIMER_MESSAGE: [u8; 39] =

const MANIFEST_SHA_2: u64 = 0xf4e2_f313_1c2f_c1dc;
const MANIFEST_SHA_3: u64 = 0x02ee_8874_3acd_d590;

const PRIMARY_OWNER_SLOT: usize = 1;
const UNRELATED_OWNER_SLOT: usize = 2;
const UNRELATED_DIGEST_0: u64 = 0x9101;
const UNRELATED_DIGEST_1: u64 = 0x9102;
const UNRELATED_DIGEST_2: u64 = 0x9103;
const UNRELATED_DIGEST_3: u64 = 0x9104;
const UNRELATED_MANIFEST_0: u64 = 0xa101;
const UNRELATED_MANIFEST_1: u64 = 0xa102;
const UNRELATED_MANIFEST_2: u64 = 0xa103;
const UNRELATED_MANIFEST_3: u64 = 0xa104;
// These exact policy strings are independently compiled kernel policy, not
// pointers or identifiers copied from the record under admission.
static POLICY_DEVICE_NET: [u8; 10] = b"device.net";
static POLICY_RESETTABLE_NETWORK: [u8; 33] =
    b"resettable pilot network provider";
static POLICY_VM_MACHINE: [u8; 10] = b"vm.machine";
static POLICY_CONTAINED_GUEST: [u8; 25] =
    b"contained guest execution";
static UNRELATED_VM_PURPOSE: [u8; 25] =
    b"unrelated guest execution";
static REQUIREMENT_NPT: [u8; 3] = b"npt";
static REQUIREMENT_SVM: [u8; 3] = b"svm";

static RECORD_MESSAGE: [u8; 45] =
    b"KW pinned record hash/tamper rejection: PASS\n";
static POLICY_MESSAGE: [u8; 54] =
    b"KW exact-byte policy + package/manifest binding: PASS\n";
static AUTHORITY_MESSAGE: [u8; 47] =
    b"KW exact export authority + typed rights: PASS\n";
static REQUIREMENT_MESSAGE: [u8; 43] =
    b"KW exact SVM/NPT requirement binding: PASS\n";
static OBJECT_MESSAGE: [u8; 47] =
    b"KW VM/vCPU/guest-page generation + quota: PASS\n";
static SUPERVISED_BIND_MESSAGE: [u8; 42] =
    b"KW exact boot-to-SVM/device binding: PASS\n";
static SUPERVISED_HEALTH_MESSAGE: [u8; 43] =
    b"KW VMEXIT-derived health publication: PASS\n";
static SUPERVISED_DEVICE_MESSAGE: [u8; 49] =
    b"KW guest PIO exit + virtual endpoint reply: PASS\n";
static SUPERVISED_RESET_MESSAGE: [u8; 53] =

use world::identity::IDENTITY_COUNTER_DOMAIN_GENERATION;
use world::identity::IDENTITY_COUNTER_PROCESS_GENERATION;
use world::identity::IDENTITY_COUNTER_RESOURCE_GENERATION;
use world::identity::IDENTITY_COUNTER_OBJECT_VERSION;
use world::identity::IDENTITY_COUNTER_ATTEMPT_GENERATION;

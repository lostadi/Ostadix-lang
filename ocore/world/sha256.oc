module world::sha256;

// Architecture-neutral SHA-256 for canonical World records. Callers own the
// schedule storage explicitly; the implementation keeps no mutable global
// state and places no fixed-size array on the spill-only O-core stack.

const WORD_MASK: u64 = 0xffff_ffff;
pub const SHA256_DIGEST_BYTES: usize = 32;
pub const SHA256_SCHEDULE_WORDS: usize = 64;

static ROUND_CONSTANTS: [u64; 64] = [
    0x428a_2f98, 0x7137_4491, 0xb5c0_fbcf, 0xe9b5_dba5,
    0x3956_c25b, 0x59f1_11f1, 0x923f_82a4, 0xab1c_5ed5,
    0xd807_aa98, 0x1283_5b01, 0x2431_85be, 0x550c_7dc3,
    0x72be_5d74, 0x80de_b1fe, 0x9bdc_06a7, 0xc19b_f174,
    0xe49b_69c1, 0xefbe_4786, 0x0fc1_9dc6, 0x240c_a1cc,
    0x2de9_2c6f, 0x4a74_84aa, 0x5cb0_a9dc, 0x76f9_88da,
    0x983e_5152, 0xa831_c66d, 0xb003_27c8, 0xbf59_7fc7,
    0xc6e0_0bf3, 0xd5a7_9147, 0x06ca_6351, 0x1429_2967,
    0x27b7_0a85, 0x2e1b_2138, 0x4d2c_6dfc, 0x5338_0d13,
    0x650a_7354, 0x766a_0abb, 0x81c2_c92e, 0x9272_2c85,
    0xa2bf_e8a1, 0xa81a_664b, 0xc24b_8b70, 0xc76c_51a3,
    0xd192_e819, 0xd699_0624, 0xf40e_3585, 0x106a_a070,
    0x19a4_c116, 0x1e37_6c08, 0x2748_774c, 0x34b0_bcb5,
    0x391c_0cb3, 0x4ed8_aa4a, 0x5b9c_ca4f, 0x682e_6ff3,
    0x748f_82ee, 0x78a5_636f, 0x84c8_7814, 0x8cc7_0208,
    0x90be_fffa, 0xa450_6ceb, 0xbef9_a3f7, 0xc671_78f2,
];

pub struct Sha256Scratch {
    schedule: *mut u64,
    schedule_words: usize,
}

pub unsafe fn scratch_init(
    scratch: *mut Sha256Scratch,
    schedule: *mut u64,
    schedule_words: usize
) -> u64 {
    if scratch as usize == 0 || schedule as usize == 0
        || schedule_words < SHA256_SCHEDULE_WORDS {
        return 0;
    }
    (*scratch).schedule = schedule;
    (*scratch).schedule_words = schedule_words;
    return 1;
}

fn rotate_right(value: u64, bits: usize) -> u64 {
    return ((value >> bits) | (value << (32 - bits))) & WORD_MASK;
}

unsafe fn source_byte(source: *const u8, offset: usize) -> u64 {
    return volatile_load(source + offset) as u64;
}

unsafe fn put_digest_word(
    output: *mut u8,
    offset: usize,
    value: u64
) -> void {
    volatile_store(output + offset, (value >> 24) as u8);
    volatile_store(output + offset + 1, (value >> 16) as u8);
    volatile_store(output + offset + 2, (value >> 8) as u8);
    volatile_store(output + offset + 3, value as u8);
}

pub unsafe fn compute(
    source: *const u8,
    length: usize,
    output: *mut u8,
    scratch: *mut Sha256Scratch
) -> u64 {
    // PR4 hashes complete canonical OWVALUE records, whose hard maximum is
    // 4096 bytes.  Keeping that public bound also makes padding arithmetic
    // total without target-width overflow.
    if output as usize == 0 || scratch as usize == 0 || length > 4096
        || (length != 0 && source as usize == 0)
        || (*scratch).schedule as usize == 0
        || (*scratch).schedule_words < SHA256_SCHEDULE_WORDS {
        return 0;
    }

    let schedule: *mut u64 = (*scratch).schedule;
    let mut h0: u64 = 0x6a09_e667;
    let mut h1: u64 = 0xbb67_ae85;
    let mut h2: u64 = 0x3c6e_f372;
    let mut h3: u64 = 0xa54f_f53a;
    let mut h4: u64 = 0x510e_527f;
    let mut h5: u64 = 0x9b05_688c;
    let mut h6: u64 = 0x1f83_d9ab;
    let mut h7: u64 = 0x5be0_cd19;
    let block_count: usize = (length + 9 + 63) / 64;
    let padded_length: usize = block_count * 64;
    let bit_length: u64 = (length as u64) * 8;
    let mut block: usize = 0;
    while block < block_count {
        let mut word: usize = 0;
        while word < 16 {
            let mut value: u64 = 0;
            let mut byte: usize = 0;
            while byte < 4 {
                let position: usize = block * 64 + word * 4 + byte;
                let mut part: u64 = 0;
                if position < length {
                    part = source_byte(source, position);
                } else {
                    if position == length {
                        part = 0x80;
                    } else {
                        if position >= padded_length - 8 {
                            let shift: usize = (padded_length - 1 - position) * 8;
                            part = (bit_length >> shift) & 0xff;
                        }
                    }
                }
                volatile_store(schedule + word, value << 8 | part);
                value = volatile_load(schedule + word);
                byte += 1;
            }
            word += 1;
        }
        while word < 64 {
            let prior_fifteen: u64 = volatile_load(schedule + word - 15);
            let prior_two: u64 = volatile_load(schedule + word - 2);
            let sigma_zero: u64 = rotate_right(prior_fifteen, 7)
                ^ rotate_right(prior_fifteen, 18)
                ^ (prior_fifteen >> 3);
            let sigma_one: u64 = rotate_right(prior_two, 17)
                ^ rotate_right(prior_two, 19)
                ^ (prior_two >> 10);
            let next: u64 = (
                volatile_load(schedule + word - 16)
                + sigma_zero
                + volatile_load(schedule + word - 7)
                + sigma_one
            ) & WORD_MASK;
            volatile_store(schedule + word, next);
            word += 1;
        }

        let mut a: u64 = h0;
        let mut b: u64 = h1;
        let mut c: u64 = h2;
        let mut d: u64 = h3;
        let mut e: u64 = h4;
        let mut f: u64 = h5;
        let mut g: u64 = h6;
        let mut h: u64 = h7;
        word = 0;
        while word < 64 {
            let sigma_one: u64 = rotate_right(e, 6)
                ^ rotate_right(e, 11) ^ rotate_right(e, 25);
            let choice: u64 = (e & f) ^ ((e ^ WORD_MASK) & g);
            let temporary_one: u64 = (
                h + sigma_one + choice + ROUND_CONSTANTS[word]
                + volatile_load(schedule + word)
            ) & WORD_MASK;
            let sigma_zero: u64 = rotate_right(a, 2)
                ^ rotate_right(a, 13) ^ rotate_right(a, 22);
            let majority: u64 = (a & b) ^ (a & c) ^ (b & c);
            let temporary_two: u64 = (sigma_zero + majority) & WORD_MASK;
            h = g;
            g = f;
            f = e;
            e = (d + temporary_one) & WORD_MASK;
            d = c;
            c = b;
            b = a;
            a = (temporary_one + temporary_two) & WORD_MASK;
            word += 1;
        }
        h0 = (h0 + a) & WORD_MASK;
        h1 = (h1 + b) & WORD_MASK;
        h2 = (h2 + c) & WORD_MASK;
        h3 = (h3 + d) & WORD_MASK;
        h4 = (h4 + e) & WORD_MASK;
        h5 = (h5 + f) & WORD_MASK;
        h6 = (h6 + g) & WORD_MASK;
        h7 = (h7 + h) & WORD_MASK;
        block += 1;
    }

    // Output is untouched until all input/scratch checks and rounds succeed.
    put_digest_word(output, 0, h0);
    put_digest_word(output, 4, h1);
    put_digest_word(output, 8, h2);
    put_digest_word(output, 12, h3);
    put_digest_word(output, 16, h4);
    put_digest_word(output, 20, h5);
    put_digest_word(output, 24, h6);
    put_digest_word(output, 28, h7);
    return 1;
}

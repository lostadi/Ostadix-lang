module runtime::m6_personalityd;

const SYS_DEBUG_WRITE: u64 = 0;
const SYS_YIELD: u64 = 4;
const SYS_ENDPOINT_SEND: u64 = 9;
const SYS_ENDPOINT_RECEIVE: u64 = 10;
const SYS_PERSONALITY_REPLY: u64 = 15;

const ERR_IPC_RETRY: u64 = 0xffff_ffff_ffff_ffe8;
const ERR_PERSONALITY_STALE: u64 = 0xffff_ffff_ffff_ffd4;
const ERR_PERSONALITY_DUPLICATE: u64 = 0xffff_ffff_ffff_ffd5;
const ERR_PERSONALITY_UNSUPPORTED: u64 = 0xffff_ffff_ffff_ffd7;

const CONFIG_VA: usize = 0x0120_1000;
const PROGRESS_OFFSET: usize = 0;
const GENERATION_OFFSET: usize = 16;
const INBOX_CAP_OFFSET: usize = 32;
const REPLY_CAP_OFFSET: usize = 40;
const DIRECT_REPLY_CAP_OFFSET: usize = 48;
const CLIENT_PROCESS_OFFSET: usize = 56;
const SUPERVISOR_PROCESS_OFFSET: usize = 64;
const PRIOR_REQUEST_OFFSET: usize = 72;
const MESSAGE_OFFSET: usize = 128;
const MESSAGE_SIZE: u64 = 32;

const OP_PING: u64 = 1;
const OP_ADD1: u64 = 2;
const OP_HOLD_CANCEL: u64 = 3;
const OP_HOLD_TIMEOUT: u64 = 4;
const OP_CRASH: u64 = 5;
const OP_UNSUPPORTED: u64 = 0x7f;
const OP_HEALTH: u64 = 0x80;
const OP_HEALTH_WATCH: u64 = 0x81;
const OP_STOP: u64 = 0x82;
const SCALAR_MASK: u64 = 0x00ff_ffff_ffff_ffff;
const PONG: u64 = 0x4d36_4150_4f4e_4701;
const HEALTH_OK: u64 = 0x4d36_4148_4541_4c00;
const STOP_READY: u64 = 0x4d36_4153_544f_5000;

@link_section(".rodata")
static G1_ONLINE: [u8; 42] =
    b"M6A personality RPC daemon ELF g1: online\n";
@link_section(".rodata")
static G2_ONLINE: [u8; 42] =
    b"M6A personality RPC daemon ELF g2: online\n";
@link_section(".rodata")
static G1_CORPUS: [u8; 34] = b"M6A personality g1 RPC loop: PASS\n";
@link_section(".rodata")
static LATE_CANCEL: [u8; 41] =
    b"M6A late cancelled reply rejection: PASS\n";
@link_section(".rodata")
static LATE_TIMEOUT: [u8; 39] =
    b"M6A late timeout reply rejection: PASS\n";
@link_section(".rodata")
static G1_FAULT: [u8; 52] =
    b"M6A personality RPC daemon ELF g1: deliberate fault\n";
@link_section(".rodata")
static STALE_G1: [u8; 43] =
    b"M6A prior-generation reply rejection: PASS\n";
@link_section(".rodata")
static DUPLICATE: [u8; 36] = b"M6A duplicate reply rejection: PASS\n";
@link_section(".rodata")
static G2_CORPUS: [u8; 34] = b"M6A personality g2 RPC loop: PASS\n";
@link_section(".rodata")
static STOPPING: [u8; 43] =
    b"M6A personality g2 cooperative stop: ready\n";

unsafe fn stop() -> never {
    loop {
        asm!("pause", options(nomem, nostack));
    }
}

unsafe fn config(offset: usize) -> u64 {
    return volatile_load((CONFIG_VA + offset) as *const u64);
}

unsafe fn progress(value: u64) -> void {
    volatile_store((CONFIG_VA + PROGRESS_OFFSET) as *mut u64, value);
}

unsafe fn emit(capability: u64, pointer: *const u8, length: usize) -> void {
    if syscall3(
        SYS_DEBUG_WRITE,
        capability,
        pointer as u64,
        length as u64
    ) != length as u64 {
        stop();
    }
}

unsafe fn receive(capability: u64) -> void {
    loop {
        let result: u64 = syscall3(
            SYS_ENDPOINT_RECEIVE,
            capability,
            (CONFIG_VA + MESSAGE_OFFSET) as u64,
            MESSAGE_SIZE
        );
        if result == 1 {
            return;
        }
        if result != ERR_IPC_RETRY {
            stop();
        }
    }
}

unsafe fn word(offset: usize) -> u64 {
    return volatile_load((CONFIG_VA + MESSAGE_OFFSET + offset) as *const u64);
}

unsafe fn direct_reply(
    capability: u64,
    correlation: u64,
    scalar: u64
) -> void {
    loop {
        let result: u64 = syscall4(
            SYS_ENDPOINT_SEND,
            capability,
            correlation,
            scalar,
            0
        );
        if result == 1 {
            return;
        }
        if result != ERR_IPC_RETRY {
            stop();
        }
    }
}

unsafe fn routed_reply(
    capability: u64,
    request: u64,
    status: u64,
    scalar: u64
) -> u64 {
    return syscall4(
        SYS_PERSONALITY_REPLY,
        capability,
        request,
        status,
        scalar
    );
}

unsafe fn wait_nonzero(offset: usize) -> u64 {
    loop {
        let value: u64 = config(offset);
        if value != 0 {
            return value;
        }
        if syscall0(SYS_YIELD) != 0 {
            stop();
        }
    }
}

unsafe fn run_g1(
    report: u64,
    inbox: u64,
    reply: u64,
    direct: u64,
    client: u64,
    supervisor: u64
) -> never {
    let mut corpus: u64 = 0;
    let mut corpus_reported: bool = false;
    let mut cancelled_request: u64 = 0;
    let mut timeout_request: u64 = 0;
    let mut cancelled_checked: bool = false;
    let mut watch_seen: bool = false;
    loop {
        receive(inbox);
        let sender: u64 = word(0);
        let request: u64 = word(8);
        let payload: u64 = word(16);
        let transferred: u64 = word(24);
        let operation: u64 = payload >> 56;
        let scalar: u64 = payload & SCALAR_MASK;
        if request == 0 || transferred != 0 {
            stop();
        }
        if sender == supervisor {
            if operation == OP_HEALTH {
                direct_reply(direct, request, HEALTH_OK | 1);
            } else {
                if operation == OP_HEALTH_WATCH {
                    watch_seen = true;
                } else {
                    stop();
                }
            }
        } else {
            if sender != client {
                stop();
            }
            if cancelled_request != 0 && !cancelled_checked {
                if routed_reply(reply, cancelled_request, 0, PONG)
                    != ERR_PERSONALITY_STALE {
                    stop();
                }
                cancelled_checked = true;
                emit(report, (&LATE_CANCEL[0]), 41);
            }
            if operation == OP_PING {
                if routed_reply(reply, request, 0, PONG) != 1 {
                    stop();
                }
                corpus |= 1;
            } else {
                if operation == OP_ADD1 {
                    if scalar != 41
                        || routed_reply(reply, request, 0, scalar + 1) != 1 {
                        stop();
                    }
                    corpus |= 2;
                } else {
                    if operation == OP_UNSUPPORTED {
                        if routed_reply(
                            reply,
                            request,
                            ERR_PERSONALITY_UNSUPPORTED,
                            0
                        ) != 1 {
                            stop();
                        }
                        corpus |= 4;
                    } else {
                        if operation == OP_HOLD_CANCEL {
                            if cancelled_request != 0 {
                                stop();
                            }
                            cancelled_request = request;
                        } else {
                            if operation == OP_HOLD_TIMEOUT {
                                if timeout_request != 0 || !cancelled_checked {
                                    stop();
                                }
                                timeout_request = request;
                            } else {
                                if operation != OP_CRASH
                                    || timeout_request == 0
                                    || !watch_seen
                                    || corpus != 7
                                    || !cancelled_checked {
                                    stop();
                                }
                                if routed_reply(
                                    reply,
                                    timeout_request,
                                    0,
                                    PONG
                                ) != ERR_PERSONALITY_STALE {
                                    stop();
                                }
                                emit(report, (&LATE_TIMEOUT[0]), 39);
                                emit(report, (&G1_FAULT[0]), 52);
                                progress(7);
                                asm!("ud2", options(nomem, nostack));
                                stop();
                            }
                        }
                    }
                }
            }
            if corpus == 7 && !corpus_reported {
                corpus_reported = true;
                emit(report, (&G1_CORPUS[0]), 34);
                progress(3);
            }
        }
    }
}

unsafe fn run_g2(
    report: u64,
    inbox: u64,
    reply: u64,
    direct: u64,
    client: u64,
    supervisor: u64
) -> never {
    let stale_request: u64 = wait_nonzero(PRIOR_REQUEST_OFFSET);
    if routed_reply(reply, stale_request, 0, PONG) != ERR_PERSONALITY_STALE {
        stop();
    }
    emit(report, (&STALE_G1[0]), 43);
    progress(2);

    let mut corpus: u64 = 0;
    let mut corpus_reported: bool = false;
    let mut duplicate_checked: bool = false;
    loop {
        receive(inbox);
        let sender: u64 = word(0);
        let request: u64 = word(8);
        let payload: u64 = word(16);
        let operation: u64 = payload >> 56;
        let scalar: u64 = payload & SCALAR_MASK;
        if request == 0 || word(24) != 0 {
            stop();
        }
        if sender == supervisor {
            if operation == OP_HEALTH {
                direct_reply(direct, request, HEALTH_OK | 2);
            } else {
                if operation != OP_STOP || corpus != 7 {
                    stop();
                }
                direct_reply(direct, request, STOP_READY | 2);
                emit(report, (&STOPPING[0]), 43);
                progress(7);
                stop();
            }
        } else {
            if sender != client {
                stop();
            }
            if operation == OP_PING {
                if routed_reply(reply, request, 0, PONG) != 1 {
                    stop();
                }
                if !duplicate_checked {
                    if routed_reply(reply, request, 0, PONG)
                        != ERR_PERSONALITY_DUPLICATE {
                        stop();
                    }
                    duplicate_checked = true;
                    emit(report, (&DUPLICATE[0]), 36);
                }
                corpus |= 1;
            } else {
                if operation == OP_ADD1 {
                    if scalar != 41
                        || routed_reply(reply, request, 0, scalar + 1) != 1 {
                        stop();
                    }
                    corpus |= 2;
                } else {
                    if operation != OP_UNSUPPORTED
                        || routed_reply(
                            reply,
                            request,
                            ERR_PERSONALITY_UNSUPPORTED,
                            0
                        ) != 1 {
                        stop();
                    }
                    corpus |= 4;
                }
            }
            if corpus == 7 && duplicate_checked && !corpus_reported {
                corpus_reported = true;
                emit(report, (&G2_CORPUS[0]), 34);
                progress(6);
            }
        }
    }
}

@export
@no_mangle
@link_section(".text.entry")
pub unsafe fn _start(report_capability: u64, boot_generation: u64) -> never {
    let generation: u64 = config(GENERATION_OFFSET);
    let inbox: u64 = wait_nonzero(INBOX_CAP_OFFSET);
    let reply: u64 = wait_nonzero(REPLY_CAP_OFFSET);
    let direct: u64 = wait_nonzero(DIRECT_REPLY_CAP_OFFSET);
    let client: u64 = wait_nonzero(CLIENT_PROCESS_OFFSET);
    let supervisor: u64 = wait_nonzero(SUPERVISOR_PROCESS_OFFSET);
    if report_capability == 0
        || generation == 0
        || generation != boot_generation {
        stop();
    }
    if generation == 1 {
        emit(report_capability, (&G1_ONLINE[0]), 42);
        progress(1);
        run_g1(
            report_capability,
            inbox,
            reply,
            direct,
            client,
            supervisor
        );
    }
    if generation == 2 {
        emit(report_capability, (&G2_ONLINE[0]), 42);
        progress(1);
        run_g2(
            report_capability,
            inbox,
            reply,
            direct,
            client,
            supervisor
        );
    }
    stop();
}

module runtime::m4_personality_alpha;

use runtime::native_abi::SYS_DEBUG_WRITE;

const COMPLETION_VA: usize = 0x01201000;
pub const COMPLETION_VALUE: u64 = 0x4d34_0000_0000_0001;

@link_section(".rodata")
static ONLINE: [u8; 33] = b"M4 personality alpha ELF: online\n";

@export
@no_mangle
@link_section(".text.entry")
pub unsafe fn _start(report_capability: u64) -> never {
    if syscall3(
        SYS_DEBUG_WRITE,
        report_capability,
        (&ONLINE[0]) as u64,
        33
    ) != 33 {
        loop {
            asm!("pause", options(nomem, nostack));
        }
    }
    volatile_store(COMPLETION_VA as *mut u64, COMPLETION_VALUE);
    loop {
        asm!("pause", options(nomem, nostack));
    }
}

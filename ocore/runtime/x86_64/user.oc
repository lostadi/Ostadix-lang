module runtime::user;

use kernel::main::OCORE_KERNEL_ONLY_MARKER;
use runtime::native_abi::ERR_BUFFER_TOO_LARGE;
use runtime::native_abi::ERR_CAPABILITY_DENIED;
use runtime::native_abi::ERR_NOT_IMPLEMENTED;
use runtime::native_abi::ERR_QUOTA_EXCEEDED;
use runtime::native_abi::ERR_INVALID_MEMORY_KIND;
use runtime::native_abi::ERR_UNKNOWN_SYSCALL;
use runtime::native_abi::ERR_USER_POINTER_DENIED;
use runtime::native_abi::ERR_USER_COPY_FAULT;
use runtime::native_abi::SYS_CAP_CLOSE;
use runtime::native_abi::SYS_CAP_COPY;
use runtime::native_abi::SYS_DEBUG_WRITE;
use runtime::native_abi::SYS_PAGE_ALLOC;
use runtime::native_abi::SYS_TICKS;
use runtime::native_abi::SYS_YIELD;
use runtime::native_abi::SYS_EXIT;
use runtime::memory_object::MEMORY_ANONYMOUS;
use runtime::memory_object::MEMORY_DEVICE;
use runtime::memory_object::MEMORY_EXECUTABLE;

const FORGED_DEBUG_HANDLE: u64 = 0x0000000200000001;
const STALE_DEBUG_HANDLE: u64 = 0x0000000100000002;
const WRONG_RIGHTS_HANDLE: u64 = 0x0000000100000003;
const WRONG_TYPE_HANDLE: u64 = 0x0000000100000004;
const PAGE_POOL_HANDLE: u64 = 0x0000000100000004;
const CLOSE_PROBE_HANDLE: u64 = 0x0000000100000005;
const EMPTY_SLOT_HANDLE: u64 = 0x000000010000003f;
const OUT_OF_BOUNDS_HANDLE: u64 = 0x0000000100000040;

@link_section(".rodata.user")
static FORGED_LEAK_PAYLOAD: [u8; 25] = b"FORGED CAPABILITY LEAKED\n";
@link_section(".rodata.user")
static STALE_LEAK_PAYLOAD: [u8; 24] = b"STALE CAPABILITY LEAKED\n";

@link_section(".rodata.user")
static CPL3_MESSAGE: [u8; 23] = b"CPL3 native[0]: online\n";
@link_section(".rodata.user")
static ZERO_FILL_MESSAGE: [u8; 23] = b"user zero-fill: online\n";
@link_section(".rodata.user")
static CAP_BOUNDS_DENIED_MESSAGE: [u8; 26] = b"capability bounds: denied\n";
@link_section(".rodata.user")
static FORGED_DENIED_MESSAGE: [u8; 26] = b"forged capability: denied\n";
@link_section(".rodata.user")
static STALE_DENIED_MESSAGE: [u8; 25] = b"stale capability: denied\n";
@link_section(".rodata.user")
static WRONG_RIGHTS_DENIED_MESSAGE: [u8; 21] = b"wrong rights: denied\n";
@link_section(".rodata.user")
static WRONG_TYPE_DENIED_MESSAGE: [u8; 19] = b"wrong type: denied\n";
@link_section(".rodata.user")
static CLOSED_DENIED_MESSAGE: [u8; 26] = b"closed capability: denied\n";
@link_section(".rodata.user")
static USER_RANGES_DENIED_MESSAGE: [u8; 20] = b"user ranges: denied\n";
@link_section(".rodata.user")
static KERNEL_DENIED_MESSAGE: [u8; 23] = b"kernel pointer: denied\n";
@link_section(".rodata.user")
static UNKNOWN_DENIED_MESSAGE: [u8; 24] = b"unknown syscall: denied\n";
@link_section(".rodata.user")
static RFLAGS_MESSAGE: [u8; 28] = b"RFLAGS sanitization: online\n";
@link_section(".rodata.user")
static TIMER_RETURN_MESSAGE: [u8; 26] = b"timer CPL3 return: online\n";
@link_section(".rodata.user")
static YIELD_MESSAGE: [u8; 19] = b"yield hook: online\n";
@link_section(".rodata.user")
static HEARTBEAT_MESSAGE: [u8; 23] = b"CPL3 heartbeat: online\n";
@link_section(".rodata.user")
static REGISTER_MESSAGE: [u8; 30] = b"register preservation: online\n";
@link_section(".rodata.user")
static CAP_COPY_RESERVED_MESSAGE: [u8; 26] = b"cap_copy reserved: denied\n";
@link_section(".rodata.user")
static EXIT_GATED_MESSAGE: [u8; 27] = b"process exit gated: denied\n";
@link_section(".rodata.user")
static OVERSIZED_MESSAGE: [u8; 25] = b"oversized buffer: denied\n";
@link_section(".rodata.user")
static COPY_SYSCALL_MESSAGE: [u8; 29] = b"user copy syscall: recovered\n";
@link_section(".rodata.user")
static COPY_HEARTBEAT_MESSAGE: [u8; 29] = b"copy-fault heartbeat: online\n";
@link_section(".rodata.user")
static PAGE_ALLOC_MESSAGE: [u8; 34] = b"M03 page_alloc: capability online\n";
@link_section(".rodata.user")
static QUOTA_MESSAGE: [u8; 30] = b"M03 quota: enforced-recovered\n";
@link_section(".rodata.user")
static MEMORY_STALE_MESSAGE: [u8; 31] = b"M03 memory stale close: denied\n";
@link_section(".rodata.user")
static MEMORY_LIFECYCLE_MESSAGE: [u8; 27] = b"M03 memory lifecycle: PASS\n";

extern "sysv64" fn ocore_user_register_probe() -> u64;
extern "sysv64" fn ocore_user_probe_divide(capability: u64) -> never;
extern "sysv64" fn ocore_user_probe_invalid_opcode(capability: u64) -> never;
extern "sysv64" fn ocore_user_probe_nonpresent(capability: u64) -> never;
extern "sysv64" fn ocore_user_probe_supervisor(capability: u64) -> never;
extern "sysv64" fn ocore_user_probe_guard_stack(capability: u64) -> never;
extern "sysv64" fn ocore_user_probe_nx(capability: u64) -> never;
extern "sysv64" fn ocore_user_probe_noncanonical(capability: u64) -> never;
extern "sysv64" fn ocore_user_probe_bad_return(capability: u64) -> never;

pub fn entry_for_probe(mode: u64) -> usize {
    if mode == 1 {
        return ocore_user_probe_divide as usize;
    }
    if mode == 2 {
        return ocore_user_probe_invalid_opcode as usize;
    }
    if mode == 3 {
        return ocore_user_probe_nonpresent as usize;
    }
    if mode == 4 {
        return ocore_user_probe_supervisor as usize;
    }
    if mode == 5 {
        return ocore_user_probe_guard_stack as usize;
    }
    if mode == 6 {
        return ocore_user_probe_nx as usize;
    }
    if mode == 7 {
        return ocore_user_probe_noncanonical as usize;
    }
    if mode == 8 {
        return ocore_user_probe_bad_return as usize;
    }
    if mode == 9 {
        return ocore_user_copy_fault_probe as usize;
    }
    return ocore_user_entry as usize;
}

@link_section(".text.user")
unsafe fn stop() -> never {
    loop {
        asm!("pause", options(nomem, nostack));
    }
}

@link_section(".text.user")
unsafe fn debug_write(capability: u64, pointer: usize, length: usize) -> u64 {
    return syscall3(
        SYS_DEBUG_WRITE,
        capability,
        pointer as u64,
        length as u64
    );
}

@link_section(".text.user")
unsafe fn emit(capability: u64, pointer: *const u8, length: usize) -> void {
    let result: u64 = debug_write(capability, pointer as usize, length);
    if result != length as u64 {
        stop();
    }
}

@link_section(".text.user")
fn valid_capability_shape(handle: u64) -> bool {
    return (handle >> 32) != 0 && (handle & 0xffff_ffff) < 64;
}

@export
@no_mangle
@link_section(".text.user")
pub unsafe fn ocore_user_copy_fault_probe(report_capability: u64) -> never {
    let copy_result: u64 = debug_write(
        report_capability,
        0x011ffff0,
        1
    );
    if copy_result != ERR_USER_COPY_FAULT {
        stop();
    }
    emit(report_capability, (&COPY_SYSCALL_MESSAGE[0]), 29);

    let tick_before: u64 = syscall0(SYS_TICKS);
    let mut tick_after: u64 = tick_before;
    while tick_after == tick_before {
        tick_after = syscall0(SYS_TICKS);
    }
    emit(report_capability, (&COPY_HEARTBEAT_MESSAGE[0]), 29);

    loop {
        if syscall0(SYS_YIELD) != 0 {
            stop();
        }
    }
}

// This is the only first-process entrypoint. Its code and every referenced
// byte string live in the dedicated user image mapping.
@export
@no_mangle
@link_section(".text.user")
pub unsafe fn ocore_user_entry(report_capability: u64) -> never {
    let mut code_selector: u64 = 0;
    asm!(
        "xor rax, rax\nmov ax, cs",
        out("rax") code_selector,
        options(nomem, nostack)
    );
    if (code_selector & 3) != 3 {
        stop();
    }

    let image_tail: u64 = volatile_load(0x011ffff0 as *const u64);
    let stack_bottom: u64 = volatile_load(0x01201000 as *const u64);
    if image_tail != 0 || stack_bottom != 0 {
        stop();
    }
    if ocore_user_register_probe() != 1 {
        stop();
    }

    let out_of_bounds_result: u64 = debug_write(
        OUT_OF_BOUNDS_HANDLE,
        (&FORGED_LEAK_PAYLOAD[0]) as usize,
        25
    );
    let empty_slot_result: u64 = debug_write(
        EMPTY_SLOT_HANDLE,
        (&FORGED_LEAK_PAYLOAD[0]) as usize,
        25
    );
    if out_of_bounds_result != ERR_CAPABILITY_DENIED
        || empty_slot_result != ERR_CAPABILITY_DENIED {
        stop();
    }

    let forged_result: u64 = debug_write(
        FORGED_DEBUG_HANDLE,
        (&FORGED_LEAK_PAYLOAD[0]) as usize,
        25
    );
    if forged_result != ERR_CAPABILITY_DENIED {
        stop();
    }

    let stale_result: u64 = debug_write(
        STALE_DEBUG_HANDLE,
        (&STALE_LEAK_PAYLOAD[0]) as usize,
        24
    );
    if stale_result != ERR_CAPABILITY_DENIED {
        stop();
    }

    let wrong_rights_result: u64 = debug_write(
        WRONG_RIGHTS_HANDLE,
        (&FORGED_LEAK_PAYLOAD[0]) as usize,
        25
    );
    if wrong_rights_result != ERR_CAPABILITY_DENIED {
        stop();
    }
    let wrong_type_result: u64 = debug_write(
        WRONG_TYPE_HANDLE,
        (&FORGED_LEAK_PAYLOAD[0]) as usize,
        25
    );
    if wrong_type_result != ERR_CAPABILITY_DENIED {
        stop();
    }

    let close_result: u64 = syscall1(SYS_CAP_CLOSE, CLOSE_PROBE_HANDLE);
    if close_result != 1 {
        stop();
    }
    let closed_result: u64 = debug_write(
        CLOSE_PROBE_HANDLE,
        (&FORGED_LEAK_PAYLOAD[0]) as usize,
        25
    );
    if closed_result != ERR_CAPABILITY_DENIED {
        stop();
    }

    let crossing_result: u64 = debug_write(
        report_capability,
        0x013ffff8,
        16
    );
    let wrapping_result: u64 = debug_write(
        report_capability,
        (&CPL3_MESSAGE[0]) as usize,
        0xffffffffffffffff
    );
    if crossing_result != ERR_USER_POINTER_DENIED
        || wrapping_result != ERR_USER_POINTER_DENIED {
        stop();
    }

    let kernel_pointer_result: u64 = debug_write(
        report_capability,
        (&OCORE_KERNEL_ONLY_MARKER[0]) as usize,
        22
    );
    if kernel_pointer_result != ERR_USER_POINTER_DENIED {
        stop();
    }

    let unknown_result: u64 = syscall0(0xffff);
    if unknown_result != ERR_UNKNOWN_SYSCALL {
        stop();
    }
    let reserved_copy_result: u64 = syscall0(SYS_CAP_COPY);
    let gated_exit_result: u64 = syscall1(SYS_EXIT, 0);
    let missing_pool_result: u64 = syscall2(
        SYS_PAGE_ALLOC,
        0,
        MEMORY_ANONYMOUS
    );
    if reserved_copy_result != ERR_NOT_IMPLEMENTED
        || gated_exit_result != ERR_NOT_IMPLEMENTED
        || missing_pool_result != ERR_CAPABILITY_DENIED {
        stop();
    }

    let wrong_pool_result: u64 = syscall2(
        SYS_PAGE_ALLOC,
        report_capability,
        MEMORY_ANONYMOUS
    );
    let invalid_kind_result: u64 = syscall2(
        SYS_PAGE_ALLOC,
        PAGE_POOL_HANDLE,
        MEMORY_DEVICE
    );
    let executable_kind_result: u64 = syscall2(
        SYS_PAGE_ALLOC,
        PAGE_POOL_HANDLE,
        MEMORY_EXECUTABLE
    );
    if wrong_pool_result != ERR_CAPABILITY_DENIED
        || invalid_kind_result != ERR_INVALID_MEMORY_KIND
        || executable_kind_result != ERR_INVALID_MEMORY_KIND {
        stop();
    }

    let first_memory: u64 = syscall2(
        SYS_PAGE_ALLOC,
        PAGE_POOL_HANDLE,
        MEMORY_ANONYMOUS
    );
    let second_memory: u64 = syscall2(
        SYS_PAGE_ALLOC,
        PAGE_POOL_HANDLE,
        MEMORY_ANONYMOUS
    );
    if !valid_capability_shape(first_memory)
        || !valid_capability_shape(second_memory)
        || first_memory == second_memory {
        stop();
    }
    let quota_result: u64 = syscall2(
        SYS_PAGE_ALLOC,
        PAGE_POOL_HANDLE,
        MEMORY_ANONYMOUS
    );
    if quota_result != ERR_QUOTA_EXCEEDED {
        stop();
    }
    if syscall1(SYS_CAP_CLOSE, first_memory) != 1 {
        stop();
    }
    let replacement_memory: u64 = syscall2(
        SYS_PAGE_ALLOC,
        PAGE_POOL_HANDLE,
        MEMORY_ANONYMOUS
    );
    if !valid_capability_shape(replacement_memory)
        || replacement_memory == first_memory
        || syscall1(SYS_CAP_CLOSE, first_memory) != ERR_CAPABILITY_DENIED {
        stop();
    }
    if syscall1(SYS_CAP_CLOSE, second_memory) != 1
        || syscall1(SYS_CAP_CLOSE, replacement_memory) != 1 {
        stop();
    }
    let oversized_result: u64 = debug_write(
        report_capability,
        (&CPL3_MESSAGE[0]) as usize,
        257
    );
    if oversized_result != ERR_BUFFER_TOO_LARGE {
        stop();
    }

    // NT is writable by CPL3 but invalid on the kernel's eventual IRETQ path.
    // A successful syscall return proves IA32_FMASK removed it on entry and
    // the sanitized return frame removed it from the resumed user state.
    let mut hostile_flags: u64 = 0;
    asm!(
        "pushfq\nor qword ptr [rsp], 0x4000\npopfq\npushfq\npop rax",
        out("rax") hostile_flags
    );
    if (hostile_flags & 0x4000) == 0 {
        stop();
    }
    let flags_tick: u64 = syscall0(SYS_TICKS);

    // Syscalls run with IF masked. A later tick count can therefore advance
    // only while this loop is back at CPL3. Reaching the marker below proves
    // both the TSS privilege transition and the timer handler's IRETQ return.
    let tick_before: u64 = flags_tick;
    let mut tick_after: u64 = tick_before;
    while tick_after == tick_before {
        tick_after = syscall0(SYS_TICKS);
    }

    let yield_result: u64 = syscall0(SYS_YIELD);
    if yield_result != 0 {
        stop();
    }

    // Nothing is announced until CPL, the complete capability and user-range
    // matrix, hostile-RFLAGS entry, timer return, personality routing,
    // unknown-number denial, and the scheduler hook have all passed.
    emit(report_capability, (&CPL3_MESSAGE[0]), 23);
    emit(report_capability, (&ZERO_FILL_MESSAGE[0]), 23);
    emit(report_capability, (&CAP_BOUNDS_DENIED_MESSAGE[0]), 26);
    emit(report_capability, (&FORGED_DENIED_MESSAGE[0]), 26);
    emit(report_capability, (&STALE_DENIED_MESSAGE[0]), 25);
    emit(report_capability, (&WRONG_RIGHTS_DENIED_MESSAGE[0]), 21);
    emit(report_capability, (&WRONG_TYPE_DENIED_MESSAGE[0]), 19);
    emit(report_capability, (&CLOSED_DENIED_MESSAGE[0]), 26);
    emit(report_capability, (&USER_RANGES_DENIED_MESSAGE[0]), 20);
    emit(report_capability, (&KERNEL_DENIED_MESSAGE[0]), 23);
    emit(report_capability, (&UNKNOWN_DENIED_MESSAGE[0]), 24);
    emit(report_capability, (&REGISTER_MESSAGE[0]), 30);
    emit(report_capability, (&CAP_COPY_RESERVED_MESSAGE[0]), 26);
    emit(report_capability, (&EXIT_GATED_MESSAGE[0]), 27);
    emit(report_capability, (&PAGE_ALLOC_MESSAGE[0]), 34);
    emit(report_capability, (&QUOTA_MESSAGE[0]), 30);
    emit(report_capability, (&MEMORY_STALE_MESSAGE[0]), 31);
    emit(report_capability, (&MEMORY_LIFECYCLE_MESSAGE[0]), 27);
    emit(report_capability, (&OVERSIZED_MESSAGE[0]), 25);
    emit(report_capability, (&RFLAGS_MESSAGE[0]), 28);
    emit(report_capability, (&TIMER_RETURN_MESSAGE[0]), 26);
    emit(report_capability, (&YIELD_MESSAGE[0]), 19);

    let heartbeat_before: u64 = syscall0(SYS_TICKS);
    let mut heartbeat_after: u64 = heartbeat_before;
    while heartbeat_after == heartbeat_before {
        heartbeat_after = syscall0(SYS_TICKS);
    }
    emit(report_capability, (&HEARTBEAT_MESSAGE[0]), 23);

    loop {
        let yielded: u64 = syscall0(SYS_YIELD);
        if yielded != 0 {
            stop();
        }
    }
}

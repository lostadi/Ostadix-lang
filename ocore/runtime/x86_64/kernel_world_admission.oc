pub unsafe fn policy_registration_count() -> u64 {
    return POLICY_REGISTRATIONS;
}

pub unsafe fn policy_allowed_rights(
    package_digest_zero: u64,
    package_digest_one: u64,
    package_digest_two: u64,
    package_digest_three: u64,
    request_kind: *const u8,
    request_kind_length: usize,
    request_purpose: *const u8,
    request_purpose_length: usize
) -> u64 {
    if INITIALIZED == 0
        || POISONED != 0
        || !valid_text(request_kind, request_kind_length)
        || !valid_text(request_purpose, request_purpose_length) {
        return 0;
    }
    let request_kind_id: u64 =
        text_hash(request_kind, request_kind_length);
    let request_purpose_id: u64 =
        text_hash(request_purpose, request_purpose_length);
    if request_kind_id == 0 || request_purpose_id == 0 {
        return 0;
    }
    let mut rule: usize = 0;
    while rule < MAX_POLICY_RULES {
        if POLICY_USED[rule] == 1
            // Hashes reject candidates only. Exact caller bytes are required
            // before this inspection surface can return policy authority.
            && POLICY_KINDS[rule] == request_kind_id
            && POLICY_PURPOSES[rule] == request_purpose_id
            && pointer_text_matches_policy(
                request_kind,
                request_kind_length,
                request_purpose,
                request_purpose_length,
                rule
            )
            && policy_package_digest_matches(
                rule,
                package_digest_zero,
                package_digest_one,
                package_digest_two,
                package_digest_three
            ) {
            return POLICY_ALLOWED_RIGHTS[rule];
        }
        rule += 1;
    }
    return 0;
}

pub unsafe fn admission_begin_count() -> u64 {
    return ADMISSION_BEGINS;
}

pub unsafe fn admission_seal_count() -> u64 {
    return ADMISSION_SEALS;
}

pub unsafe fn revocation_count() -> u64 {
    return REVOCATIONS;
}

pub unsafe fn abort_count() -> u64 {
    return ABORTS;
}

pub unsafe fn denial_count() -> u64 {
    return DENIALS;
}

pub unsafe fn is_poisoned() -> bool {
    return POISONED != 0;
}

pub unsafe fn current_world_count() -> usize {
    if INITIALIZED == 0 || POISONED != 0 {
        return 0;
    }
    let mut count: usize = 0;
    let mut slot: usize = 0;
    while slot < MAX_KERNEL_WORLDS {
        if STATES[slot] == WORLD_ADMITTED {
            count += 1;
        }
        slot += 1;
    }
    return count;
}

pub unsafe fn staging_world_count() -> usize {
    if INITIALIZED == 0 || POISONED != 0 {
        return 0;
    }
    let mut count: usize = 0;
    let mut slot: usize = 0;
    while slot < MAX_KERNEL_WORLDS {
        if STATES[slot] == WORLD_STAGING {
            count += 1;
        }
        slot += 1;
    }
    return count;
}

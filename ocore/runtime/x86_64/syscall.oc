module runtime::syscall;

use runtime::capability::close_in_cspace;
use runtime::capability::validate_in_cspace;
use runtime::capability::OBJECT_DEBUG;
use runtime::capability::RIGHT_DEBUG_WRITE;
use runtime::personality::PERSONALITY_NATIVE_0;
use runtime::interrupts::ticks;
use runtime::process::current_cspace_id;
use runtime::process::current_personality_id;
use runtime::process::current_slot;
use runtime::process::current_user_high;
use runtime::process::current_user_low;
use runtime::process::MAX_PROCESSES;
use runtime::serial::write;
use runtime::user_memory::readable_range_with_bounds;

pub const SYS_DEBUG_WRITE: u64 = 0;
pub const SYS_CAP_CLOSE: u64 = 1;
pub const SYS_CAP_COPY: u64 = 2;
pub const SYS_PAGE_ALLOC: u64 = 3;
pub const SYS_YIELD: u64 = 4;
pub const SYS_TICKS: u64 = 5;

pub const ERR_CAPABILITY_DENIED: u64 = 0xffff_ffff_ffff_fff1;
pub const ERR_USER_POINTER_DENIED: u64 = 0xffff_ffff_ffff_fff2;
pub const ERR_UNKNOWN_SYSCALL: u64 = 0xffff_ffff_ffff_fff3;
pub const ERR_UNKNOWN_PERSONALITY: u64 = 0xffff_ffff_ffff_fff4;
pub const ERR_NO_CURRENT_PROCESS: u64 = 0xffff_ffff_ffff_fff5;

unsafe fn dispatch_native_0(
    cspace_id: usize,
    number: u64,
    capability: u64,
    arg0: u64,
    arg1: u64,
    arg2: u64,
    arg3: u64,
    arg4: u64
) -> u64 {
    if number == SYS_DEBUG_WRITE {
        let object: u64 = validate_in_cspace(
            cspace_id,
            capability,
            OBJECT_DEBUG,
            RIGHT_DEBUG_WRITE
        );
        if object == 0 {
            return ERR_CAPABILITY_DENIED;
        }
        let user_low: usize = current_user_low();
        let user_high: usize = current_user_high();
        if !readable_range_with_bounds(
            arg0 as usize,
            arg1 as usize,
            user_low,
            user_high
        ) {
            return ERR_USER_POINTER_DENIED;
        }
        write(arg0 as *const u8, arg1 as usize);
        return arg1;
    }
    if number == SYS_CAP_CLOSE {
        if close_in_cspace(cspace_id, capability) == 0 {
            return ERR_CAPABILITY_DENIED;
        }
        return 1;
    }
    if number == SYS_YIELD {
        // This is the stable scheduler hook. Milestone 0.1 has no alternate
        // runnable process, so accepting the request returns immediately.
        return 0;
    }
    if number == SYS_TICKS {
        return ticks();
    }
    return ERR_UNKNOWN_SYSCALL;
}

// Architectural entry glue calls only this generic router. The active PCB,
// not any user argument, selects the installed personality dispatcher.
@export
@no_mangle
pub unsafe fn kernel_syscall_dispatch(
    number: u64,
    capability: u64,
    arg0: u64,
    arg1: u64,
    arg2: u64,
    arg3: u64,
    arg4: u64
) -> u64 {
    let process_slot: usize = current_slot();
    if process_slot >= MAX_PROCESSES {
        return ERR_NO_CURRENT_PROCESS;
    }
    let cspace_id: usize = current_cspace_id();
    if cspace_id >= MAX_PROCESSES {
        return ERR_NO_CURRENT_PROCESS;
    }
    let personality_id: u64 = current_personality_id();
    if personality_id == PERSONALITY_NATIVE_0 {
        return dispatch_native_0(
            cspace_id,
            number,
            capability,
            arg0,
            arg1,
            arg2,
            arg3,
            arg4
        );
    }
    return ERR_UNKNOWN_PERSONALITY;
}

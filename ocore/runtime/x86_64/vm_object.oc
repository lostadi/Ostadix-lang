// These report the bounded resident-page pilot selected by create_vm, not the
// complete admitted MiB range exposed by the getters above.
pub unsafe fn vm_minimum_guest_pages(vm: u64) -> usize {
    let slot: usize = checked_vm_local(vm, false);
    if slot >= MAX_VMS {
        return 0;
    }
    return VM_MIN_GUEST_PAGES[slot];
}


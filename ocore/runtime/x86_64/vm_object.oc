pub unsafe fn active_vm_count() -> usize {
    return ACTIVE_VMS;
}

pub unsafe fn active_vcpu_count() -> usize {
    return ACTIVE_VCPUS;
}

pub unsafe fn active_guest_page_count() -> usize {
    return ACTIVE_GUEST_PAGES;
}

pub unsafe fn created_vm_count() -> u64 {
    return CREATED_VMS;
}

pub unsafe fn created_vcpu_count() -> u64 {
    return CREATED_VCPUS;
}

pub unsafe fn attached_guest_page_count() -> u64 {
    return ATTACHED_GUEST_PAGES;
}

pub unsafe fn configured_vm_count() -> u64 {
    return CONFIGURED_VMS;
}

pub unsafe fn destroyed_vm_count() -> u64 {
    return DESTROYED_VMS;
}

pub unsafe fn revoked_world_count() -> u64 {
    return REVOKED_WORLDS;
}

pub unsafe fn denial_count() -> u64 {
    return DENIALS;
}

pub unsafe fn is_poisoned() -> bool {
    return POISONED != 0;
}

pub unsafe fn invariants_hold() -> bool {
    if INITIALIZED == 0 || POISONED != 0 || !memory_invariants_hold() {
        return false;
    }
    let mut vcpus_by_vm: [usize; 2] = [0; 2];
    let mut pages_by_vm: [usize; 2] = [0; 2];
    let mut required_owner_refs: [usize; 4] = [0; 4];
    let mut observed_vms: usize = 0;
    let mut observed_vcpus: usize = 0;
    let mut observed_pages: usize = 0;

    let mut slot: usize = 0;
    while slot < MAX_VMS {
        let state: u8 = VM_STATES[slot];
        if VM_GENERATIONS[slot] == 0 {
            return false;
        }
        if state == VM_EMPTY || state == VM_RETIRED {
            if (state == VM_RETIRED && VM_GENERATIONS[slot] != 0xffff_ffff)
                || VM_WORLDS[slot] != 0
                || VM_WORLD_GENERATIONS[slot] != 0
                || VM_OWNERS[slot] != 0
                || VM_MIN_VCPUS[slot] != 0
                || VM_MAX_VCPUS[slot] != 0
                || VM_MIN_MEMORY_MIB[slot] != 0
                || VM_MAX_MEMORY_MIB[slot] != 0
                || VM_MIN_GUEST_PAGES[slot] != 0
                || VM_MAX_GUEST_PAGES[slot] != 0
                || VM_VCPU_COUNTS[slot] != 0
                || VM_GUEST_PAGE_COUNTS[slot] != 0 {
                return false;
            }
        } else if state == VM_CONFIGURING || state == VM_CONFIGURED {
            let owner_slot: usize = cspace_owner_slot(VM_OWNERS[slot]);
            if VM_WORLDS[slot] == 0
                || VM_WORLD_GENERATIONS[slot] == 0
                || !cspace_is_valid_owner(VM_OWNERS[slot])
                || owner_slot >= MAX_CSPACES
                || VM_MIN_VCPUS[slot] == 0
                || VM_MIN_VCPUS[slot] > VM_MAX_VCPUS[slot]
                || VM_MAX_VCPUS[slot] > MAX_VCPUS_PER_VM
                || VM_MIN_MEMORY_MIB[slot] == 0
                || VM_MIN_MEMORY_MIB[slot] > VM_MAX_MEMORY_MIB[slot]
                || VM_MIN_GUEST_PAGES[slot] == 0
                || VM_MIN_GUEST_PAGES[slot] > VM_MAX_GUEST_PAGES[slot]
                || VM_MAX_GUEST_PAGES[slot] > MAX_GUEST_PAGES_PER_VM
                || VM_VCPU_COUNTS[slot] > VM_MAX_VCPUS[slot]
                || VM_GUEST_PAGE_COUNTS[slot] > VM_MAX_GUEST_PAGES[slot] {
                return false;
            }
            if state == VM_CONFIGURED
                && (VM_VCPU_COUNTS[slot] < VM_MIN_VCPUS[slot]
                    || VM_GUEST_PAGE_COUNTS[slot]
                        < VM_MIN_GUEST_PAGES[slot]) {
                return false;
            }
            required_owner_refs[owner_slot] += 1;
            observed_vms += 1;
            let mut other: usize = slot + 1;
            while other < MAX_VMS {
                if (VM_STATES[other] == VM_CONFIGURING
                        || VM_STATES[other] == VM_CONFIGURED)
                    && VM_WORLDS[other] == VM_WORLDS[slot] {
                    return false;
                }
                other += 1;
            }
        } else {
            return false;
        }
        slot += 1;
    }

    slot = 0;
    while slot < MAX_VCPUS {
        let state: u8 = VCPU_STATES[slot];
        if VCPU_GENERATIONS[slot] == 0 {
            return false;
        }
        if state == CHILD_EMPTY || state == CHILD_RETIRED {
            if (state == CHILD_RETIRED
                    && VCPU_GENERATIONS[slot] != 0xffff_ffff)
                || VCPU_VMS[slot] != 0
                || VCPU_ORDINALS[slot] != 0 {
                return false;
            }
        } else if state == CHILD_LIVE {
            let vm_slot: usize = checked_vm_local(VCPU_VMS[slot], false);
            if vm_slot >= MAX_VMS
                || VCPU_ORDINALS[slot] >= VM_VCPU_COUNTS[vm_slot]
                || VCPU_ORDINALS[slot] >= VM_MAX_VCPUS[vm_slot] {
                return false;
            }
            vcpus_by_vm[vm_slot] += 1;
            observed_vcpus += 1;
            let mut other: usize = slot + 1;
            while other < MAX_VCPUS {
                if VCPU_STATES[other] == CHILD_LIVE
                    && VCPU_VMS[other] == VCPU_VMS[slot]
                    && VCPU_ORDINALS[other] == VCPU_ORDINALS[slot] {
                    return false;
                }
                other += 1;
            }
        } else {
            return false;
        }
        slot += 1;
    }

    slot = 0;
    while slot < MAX_GUEST_PAGES {
        let state: u8 = GUEST_PAGE_STATES[slot];
        if GUEST_PAGE_GENERATIONS[slot] == 0 {
            return false;
        }
        if state == CHILD_EMPTY || state == CHILD_RETIRED {
            if (state == CHILD_RETIRED
                    && GUEST_PAGE_GENERATIONS[slot] != 0xffff_ffff)
                || GUEST_PAGE_VMS[slot] != 0
                || GUEST_PAGE_GPAS[slot] != 0
                || GUEST_PAGE_MEMORY_OBJECTS[slot] != 0 {
                return false;
            }
        } else if state == CHILD_LIVE {
            let vm_slot: usize = checked_vm_local(
                GUEST_PAGE_VMS[slot],
                false
            );
            if vm_slot >= MAX_VMS
                || !guest_page_base_is_valid(GUEST_PAGE_GPAS[slot])
                || memory_object_kind(GUEST_PAGE_MEMORY_OBJECTS[slot])
                    != MEMORY_ANONYMOUS {
                return false;
            }
            let owner_slot: usize = cspace_owner_slot(VM_OWNERS[vm_slot]);
            if owner_slot >= MAX_CSPACES {
                return false;
            }
            required_owner_refs[owner_slot] += 1;
            pages_by_vm[vm_slot] += 1;
            observed_pages += 1;
            let mut other: usize = slot + 1;
            while other < MAX_GUEST_PAGES {
                if GUEST_PAGE_STATES[other] == CHILD_LIVE
                    && (GUEST_PAGE_MEMORY_OBJECTS[other]
                            == GUEST_PAGE_MEMORY_OBJECTS[slot]
                        || (GUEST_PAGE_VMS[other] == GUEST_PAGE_VMS[slot]
                            && guest_pages_overlap(
                                GUEST_PAGE_GPAS[other],
                                GUEST_PAGE_GPAS[slot]
                            ))) {
                    return false;
                }
                other += 1;
            }
        } else {
            return false;
        }
        slot += 1;
    }

    slot = 0;
    while slot < MAX_VMS {
        if (VM_STATES[slot] == VM_CONFIGURING
                || VM_STATES[slot] == VM_CONFIGURED)
            && (VM_VCPU_COUNTS[slot] != vcpus_by_vm[slot]
                || VM_GUEST_PAGE_COUNTS[slot] != pages_by_vm[slot]) {
            return false;
        }
        slot += 1;
    }
    slot = 0;
    while slot < MAX_CSPACES {
        if required_owner_refs[slot] != 0 {
            let mut vm_slot: usize = 0;
            let mut owner: u64 = 0;
            while vm_slot < MAX_VMS {
                if (VM_STATES[vm_slot] == VM_CONFIGURING
                        || VM_STATES[vm_slot] == VM_CONFIGURED)
                    && cspace_owner_slot(VM_OWNERS[vm_slot]) == slot {
                    owner = VM_OWNERS[vm_slot];
                }
                vm_slot += 1;
            }
            if owner == 0
                || cspace_child_refs(owner)
                    < required_owner_refs[slot] as u32 {
                return false;
            }
        }
        slot += 1;
    }
    return observed_vms == ACTIVE_VMS
        && observed_vcpus == ACTIVE_VCPUS
        && observed_pages == ACTIVE_GUEST_PAGES;
}

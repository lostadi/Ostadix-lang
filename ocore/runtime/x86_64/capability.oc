    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_LIVE
        || !generation_is_live(GENERATIONS[index])
        || GENERATIONS[index] != generation {
        return 0;
    }
    return RIGHTS[index];
}

// Teardown code may need to validate the exact rights on capabilities owned by
// either a live or draining CSpace. Ordinary service operations intentionally
// continue to use rights_for_owner so a drain removes their authority.
pub unsafe fn rights_for_valid_owner(cspace_handle: u64, handle: u64) -> u64 {
    let capability_slot: usize = (handle & 0xffff_ffff) as usize;
    let generation: u32 = (handle >> 32) as u32;
    let cspace_id: usize = checked_cspace_owner(cspace_handle);
    if cspace_id >= MAX_CSPACES || capability_slot >= CAPABILITIES_PER_CSPACE {
        return 0;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_LIVE
        || !generation_is_live(GENERATIONS[index])
        || GENERATIONS[index] != generation {
        return 0;
    }
    return RIGHTS[index];
}

pub unsafe fn object_type_during_drain(cspace_handle: u64, handle: u64) -> u64 {
    let capability_slot: usize = (handle & 0xffff_ffff) as usize;
    let generation: u32 = (handle >> 32) as u32;
    let cspace_id: usize = checked_draining_cspace(cspace_handle);
    if cspace_id >= MAX_CSPACES || capability_slot >= CAPABILITIES_PER_CSPACE {
        return 0;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_LIVE
        || !generation_is_live(GENERATIONS[index])
        || GENERATIONS[index] != generation {
        return 0;
    }
    return OBJECT_TYPES[index];
}

pub unsafe fn object_type_in_cspace(cspace_id: usize, handle: u64) -> u64 {
    let cspace_handle: u64 = cspace_handle_for_slot(cspace_id);
    if cspace_handle == 0 {
        return 0;
    }
    return object_type_for_owner(cspace_handle, handle);
}

pub unsafe fn capability_handle_at(cspace_handle: u64, capability_slot: usize) -> u64 {
    let cspace_id: usize = checked_cspace(cspace_handle);
    if cspace_id >= MAX_CSPACES || capability_slot >= CAPABILITIES_PER_CSPACE {
        return 0;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_LIVE
        || !generation_is_live(GENERATIONS[index]) {
        return 0;
    }
    return ((GENERATIONS[index] as u64) << 32) | (capability_slot as u64);
}

pub unsafe fn capability_handle_during_drain(
    cspace_handle: u64,
    capability_slot: usize
) -> u64 {
    let cspace_id: usize = checked_draining_cspace(cspace_handle);
    if cspace_id >= MAX_CSPACES || capability_slot >= CAPABILITIES_PER_CSPACE {
        return 0;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_LIVE
        || !generation_is_live(GENERATIONS[index]) {
        return 0;
    }
    return ((GENERATIONS[index] as u64) << 32) | (capability_slot as u64);
}

pub unsafe fn live_slots_for_owner(cspace_handle: u64) -> usize {
    let cspace_id: usize = checked_cspace_owner(cspace_handle);
    if cspace_id >= MAX_CSPACES {
        return 0;
    }
    let mut capability_slot: usize = 0;
    let mut count: usize = 0;
    while capability_slot < CAPABILITIES_PER_CSPACE {
        if OCCUPIED[table_index(cspace_id, capability_slot)] == SLOT_LIVE {
            count += 1;
        }
        capability_slot += 1;
    }
    return count;
}

pub unsafe fn live_slots_in_cspace(cspace_id: usize) -> usize {
    let cspace_handle: u64 = cspace_handle_for_slot(cspace_id);
    if cspace_handle == 0 {
        return 0;
    }
    return live_slots_for_owner(cspace_handle);
}

pub unsafe fn begin_close_for_owner(
    cspace_handle: u64,
    handle: u64,
    object_id: *mut u64,
    object_type: *mut u64,
    rights: *mut u64
) -> u64 {
    if object_id as usize == 0
        || object_type as usize == 0
        || rights as usize == 0 {
        return 0;
    }
    volatile_store(object_id, 0);
    volatile_store(object_type, 0);
    volatile_store(rights, 0);
    let capability_slot: usize = (handle & 0xffff_ffff) as usize;
    let generation: u32 = (handle >> 32) as u32;
    let cspace_id: usize = checked_cspace(cspace_handle);
    if cspace_id >= MAX_CSPACES
        || capability_slot >= CAPABILITIES_PER_CSPACE
        || CSPACE_CHILD_REFS[cspace_id] == 0xffff_ffff {
        return 0;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_LIVE
        || !generation_is_live(GENERATIONS[index])
        || GENERATIONS[index] != generation {
        return 0;
    }
    volatile_store(object_id, OBJECT_IDS[index]);
    volatile_store(object_type, OBJECT_TYPES[index]);
    volatile_store(rights, RIGHTS[index]);
    OCCUPIED[index] = SLOT_CLOSING;
    CSPACE_CHILD_REFS[cspace_id] += 1;
    return 1;
}

pub unsafe fn abort_close_for_owner(cspace_handle: u64, handle: u64) -> u64 {
    let capability_slot: usize = (handle & 0xffff_ffff) as usize;
    let generation: u32 = (handle >> 32) as u32;
    let cspace_id: usize = checked_cspace_owner(cspace_handle);
    if cspace_id >= MAX_CSPACES || capability_slot >= CAPABILITIES_PER_CSPACE {
        return 0;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_CLOSING
        || !generation_is_live(GENERATIONS[index])
        || GENERATIONS[index] != generation
        || CSPACE_CHILD_REFS[cspace_id] <= CSPACE_LEASE_REFS[cspace_id] {
        return 0;
    }
    OCCUPIED[index] = SLOT_LIVE;
    CSPACE_CHILD_REFS[cspace_id] -= 1;
    return 1;
}

// Read-only validation for kernel subsystems that escrow a complete live
// capability by holding its slot in SLOT_CLOSING. Exact object metadata is
// part of the check, so a stale generation or corrupted escrow record cannot
// be reopened or delivered under a different identity.
pub unsafe fn closing_matches_for_owner(
    cspace_handle: u64,
    handle: u64,
    object_id: u64,
    object_type: u64,
    rights: u64
) -> bool {
    let capability_slot: usize = (handle & 0xffff_ffff) as usize;
    let generation: u32 = (handle >> 32) as u32;
    let cspace_id: usize = checked_cspace_owner(cspace_handle);
    if cspace_id >= MAX_CSPACES
        || capability_slot >= CAPABILITIES_PER_CSPACE
        || object_id == 0
        || object_type == 0
        || rights == 0 {
        return false;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    return OCCUPIED[index] == SLOT_CLOSING
        && generation_is_live(GENERATIONS[index])
        && GENERATIONS[index] == generation
        && OBJECT_IDS[index] == object_id
        && OBJECT_TYPES[index] == object_type
        && RIGHTS[index] == rights;
}

pub unsafe fn commit_close_for_owner(cspace_handle: u64, handle: u64) -> u64 {
    let capability_slot: usize = (handle & 0xffff_ffff) as usize;
    let generation: u32 = (handle >> 32) as u32;
    let cspace_id: usize = checked_cspace_owner(cspace_handle);
    if cspace_id >= MAX_CSPACES || capability_slot >= CAPABILITIES_PER_CSPACE {
        return 0;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_CLOSING
        || !generation_is_live(GENERATIONS[index])
        || GENERATIONS[index] != generation
        || CSPACE_CHILD_REFS[cspace_id] <= CSPACE_LEASE_REFS[cspace_id] {
        return 0;
    }
    if !clear_and_advance_slot(index) {
        return 0;
    }
    CSPACE_CHILD_REFS[cspace_id] -= 1;
    return 1;
}

pub unsafe fn close_for_owner(cspace_handle: u64, handle: u64) -> u64 {
    let capability_slot: usize = (handle & 0xffff_ffff) as usize;
    let generation: u32 = (handle >> 32) as u32;
    let cspace_id: usize = checked_cspace(cspace_handle);
    if cspace_id >= MAX_CSPACES || capability_slot >= CAPABILITIES_PER_CSPACE {
        return 0;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_LIVE
        || !generation_is_live(GENERATIONS[index])
        || GENERATIONS[index] != generation {
        return 0;
    }
    if !clear_and_advance_slot(index) {
        return 0;
    }
    return 1;
}

pub unsafe fn close_during_drain(cspace_handle: u64, handle: u64) -> u64 {
    let capability_slot: usize = (handle & 0xffff_ffff) as usize;
    let generation: u32 = (handle >> 32) as u32;
    let cspace_id: usize = checked_draining_cspace(cspace_handle);
    if cspace_id >= MAX_CSPACES || capability_slot >= CAPABILITIES_PER_CSPACE {
        return 0;
    }
    let index: usize = table_index(cspace_id, capability_slot);
    if OCCUPIED[index] != SLOT_LIVE
        || !generation_is_live(GENERATIONS[index])
        || GENERATIONS[index] != generation {
        return 0;
    }
    if !clear_and_advance_slot(index) {
        return 0;
    }
    return 1;
}

pub unsafe fn close_in_cspace(cspace_id: usize, handle: u64) -> u64 {
    let cspace_handle: u64 = cspace_handle_for_slot(cspace_id);
    if cspace_handle == 0 {
        return 0;
    }
    return close_for_owner(cspace_handle, handle);
}

fn cspace_header_valid(state: u8, generation: u32, child_refs: u32) -> bool {
    if state == CSPACE_EMPTY {
        return generation_is_live(generation) && child_refs == 0;
    }
    if state == CSPACE_LIVE || state == CSPACE_DRAINING {
        return generation_is_live(generation);
    }
    if state == CSPACE_RETIRED {
        return generation_is_retired(generation) && child_refs == 0;
    }
    return false;
}

unsafe fn slot_shape_valid(index: usize, state: u8) -> bool {
    if index >= 256 {
        return false;
    }
    if state == SLOT_EMPTY || state == SLOT_RESERVED {
        return generation_is_live(GENERATIONS[index])
            && OBJECT_IDS[index] == 0
            && OBJECT_TYPES[index] == 0
            && RIGHTS[index] == 0;
    }
    if state == SLOT_LIVE || state == SLOT_CLOSING {
        let permitted: u64 = allowed_rights(OBJECT_TYPES[index]);
        return generation_is_live(GENERATIONS[index])
            && OBJECT_IDS[index] != 0
            && permitted != 0
            && RIGHTS[index] != 0
            && (RIGHTS[index] & permitted) == RIGHTS[index];
    }
    if state == SLOT_RETIRED {
        return generation_is_retired(GENERATIONS[index])
            && OBJECT_IDS[index] == 0
            && OBJECT_TYPES[index] == 0
            && RIGHTS[index] == 0;
    }
    return false;
}

pub unsafe fn invariants_hold() -> bool {
    if INITIALIZED == 0 || SELF_TEST_RAN > 1 {
        return false;
    }
    let mut cspace_id: usize = 0;
    while cspace_id < MAX_CSPACES {
        let cspace_state: u8 = CSPACE_STATES[cspace_id];
        if !cspace_header_valid(
            cspace_state,
            CSPACE_GENERATIONS[cspace_id],
            CSPACE_CHILD_REFS[cspace_id]
        ) {
            return false;
        }
        let mut transaction_refs: u32 = 0;
        let mut capability_slot: usize = 0;
        while capability_slot < CAPABILITIES_PER_CSPACE {
            let index: usize = table_index(cspace_id, capability_slot);
            let state: u8 = OCCUPIED[index];
            if !cspace_slot_state_allowed(cspace_state, state)
                || !slot_shape_valid(index, state) {
                return false;
            }
            if state == SLOT_RESERVED || state == SLOT_CLOSING {
                transaction_refs += 1;
            }
            capability_slot += 1;
        }
        // The aggregate must be exactly explained by external owner-arena
        // leases plus the reservation/close transactions visible above.
        if CSPACE_LEASE_REFS[cspace_id] > CSPACE_CHILD_REFS[cspace_id]
            || CSPACE_CHILD_REFS[cspace_id] - CSPACE_LEASE_REFS[cspace_id]
                != transaction_refs {
            return false;
        }
        cspace_id += 1;
    }
    return true;
}

// This low-level destroy is safe only after type-aware callers have closed all
// live entries. Child references include both process ownership and every live
// memory object, so mapped or kernel-owned objects prevent CSpace reuse.
pub unsafe fn destroy_cspace(handle: u64) -> u64 {
    let cspace_id: usize = checked_cspace_owner(handle);
    if cspace_id >= MAX_CSPACES
        || CSPACE_CHILD_REFS[cspace_id] != 0
        || live_slots_for_owner(handle) != 0
        || !invariants_hold() {
        return 0;
    }
    let next_cspace_generation: u32 = retire_or_advance(
        CSPACE_GENERATIONS[cspace_id]
    );
    if next_cspace_generation == GENERATION_INVALID {
        return 0;
    }
    CSPACE_STATES[cspace_id] = CSPACE_DRAINING;
    let mut capability_slot: usize = 0;
    while capability_slot < CAPABILITIES_PER_CSPACE {
        let index: usize = table_index(cspace_id, capability_slot);
        if generation_is_retired(next_cspace_generation) {
            OBJECT_IDS[index] = 0;
            OBJECT_TYPES[index] = 0;
            RIGHTS[index] = 0;
            GENERATIONS[index] = GENERATION_RETIRED;
            OCCUPIED[index] = SLOT_RETIRED;
        } else if !clear_and_advance_slot(index) {
            return 0;
        }
        capability_slot += 1;
    }
    CSPACE_CHILD_REFS[cspace_id] = 0;
    CSPACE_LEASE_REFS[cspace_id] = 0;
    CSPACE_GENERATIONS[cspace_id] = next_cspace_generation;
    if generation_is_retired(next_cspace_generation) {
        CSPACE_STATES[cspace_id] = CSPACE_RETIRED;
    } else {
        CSPACE_STATES[cspace_id] = CSPACE_EMPTY;
    }
    return 1;
}

@link_section(".text.capability_selftest")
fn generation_lifecycle_model_self_test() -> bool {
    if GENERATION_INVALID != 0
        || GENERATION_LAST_LIVE != 0xffff_fffe
        || GENERATION_RETIRED != 0xffff_ffff
        || generation_is_live(GENERATION_INVALID)
        || generation_is_live(GENERATION_RETIRED)
        || !generation_is_live(1)
        || !generation_is_live(GENERATION_LAST_LIVE)
        || retire_or_advance(GENERATION_LAST_LIVE) != GENERATION_RETIRED {
        return false;
    }

    // Exhaust the reduced-width analogue: 0 is invalid, 1..14 are live, and
    // 15 is permanently retired. This covers every state without billions of
    // production-width transitions.
    let mut generation: u32 = 0;
    while generation <= 16 {
        let actual: u32 = advance_generation_with_bounds(generation, 14, 15);
        let mut expected: u32 = 0;
        if generation == 0 {
            expected = 0;
        } else if generation < 14 {
            expected = generation + 1;
        } else {
            if generation <= 15 {
                expected = 15;
            }
        }
        if actual != expected {
            return false;
        }
        generation += 1;
    }
    return true;
}

@link_section(".text.capability_selftest")
fn cspace_state_matrix_self_test() -> bool {
    // Exhaust the complete byte-sized state relation. The expected predicate
    // is deliberately independent of cspace_slot_state_allowed().
    let mut cspace_value: usize = 0;
    while cspace_value < 256 {
        let cspace_state: u8 = cspace_value as u8;
        let mut expected_mask: u64 = 0;
        if cspace_state == CSPACE_EMPTY {
            expected_mask = 0x05;
        } else if cspace_state == CSPACE_LIVE {
            expected_mask = 0x1f;
        } else {
            if cspace_state == CSPACE_DRAINING {
                expected_mask = 0x17;
            } else if cspace_state == CSPACE_RETIRED {
                expected_mask = 0x04;
            }
        }
        let mut slot_value: usize = 0;
        while slot_value < 256 {
            let slot_state: u8 = slot_value as u8;
            let expected: bool = slot_value < 5
                && (expected_mask & (1 << slot_value)) != 0;
            if cspace_slot_state_allowed(cspace_state, slot_state) != expected {
                return false;
            }
            slot_value += 1;
        }
        cspace_value += 1;
    }

    // Exhaust every CSpace state byte against both usable and retired
    // generations. Focused checks below cover invalid generation/reference
    // combinations without expanding the always-linked kernel text.
    cspace_value = 0;
    while cspace_value < 256 {
        let cspace_state: u8 = cspace_value as u8;
        let live_expected: bool = cspace_state == CSPACE_EMPTY
            || cspace_state == CSPACE_LIVE
            || cspace_state == CSPACE_DRAINING;
        let retired_expected: bool = cspace_state == CSPACE_RETIRED;
        if cspace_header_valid(cspace_state, 1, 0) != live_expected
            || cspace_header_valid(
                cspace_state,
                GENERATION_RETIRED,
                0
            ) != retired_expected {
            return false;
        }
        cspace_value += 1;
    }
    return !cspace_header_valid(CSPACE_EMPTY, 1, 1)
        && !cspace_header_valid(CSPACE_EMPTY, GENERATION_INVALID, 0)
        && cspace_header_valid(CSPACE_LIVE, GENERATION_LAST_LIVE, 1)
        && cspace_header_valid(CSPACE_DRAINING, GENERATION_LAST_LIVE, 1)
        && !cspace_header_valid(CSPACE_RETIRED, GENERATION_RETIRED, 1);
}

// SAFETY: the boot path must call this exactly once, immediately after init
// and before any arena can retain a CSpace or install a capability. Under that
// enforced call order every slot has the uniform generation saved below; all
// deliberate mutations are then restored without consuming capacity.
@link_section(".text.capability_selftest")
pub unsafe fn self_test() -> u64 {
    if SELF_TEST_RAN != 0
        || !generation_lifecycle_model_self_test()
        || !cspace_state_matrix_self_test()
        || INITIALIZED == 0
        || !invariants_hold() {
        return 0;
    }

    // Enforce the documented boot-only contract before the first mutation.
    // Checking the whole arena prevents cleanup below from clearing a live
    // capability or resetting a generation established by another subsystem.
    let mut pristine_cspace: usize = 0;
    while pristine_cspace < MAX_CSPACES {
        if CSPACE_STATES[pristine_cspace] != CSPACE_LIVE
            || CSPACE_GENERATIONS[pristine_cspace] != 1
            || CSPACE_CHILD_REFS[pristine_cspace] != 0
            || CSPACE_LEASE_REFS[pristine_cspace] != 0 {
            return 0;
        }
        let mut pristine_slot: usize = 0;
        while pristine_slot < CAPABILITIES_PER_CSPACE {
            let pristine_index: usize = table_index(
                pristine_cspace,
                pristine_slot
            );
            if OCCUPIED[pristine_index] != SLOT_EMPTY
                || GENERATIONS[pristine_index] != 1
                || OBJECT_IDS[pristine_index] != 0
                || OBJECT_TYPES[pristine_index] != 0
                || RIGHTS[pristine_index] != 0 {
                return 0;
            }
            pristine_slot += 1;
        }
        pristine_cspace += 1;
    }
    SELF_TEST_RAN = 1;

    let cspace_id: usize = MAX_CSPACES - 1;
    let terminal_slot: usize = CAPABILITIES_PER_CSPACE - 1;
    let zero_slot: usize = CAPABILITIES_PER_CSPACE - 2;
    let terminal_index: usize = table_index(cspace_id, terminal_slot);
    let zero_index: usize = table_index(cspace_id, zero_slot);
    let saved_cspace_generation: u32 = CSPACE_GENERATIONS[cspace_id];
    let saved_slot_generation: u32 = GENERATIONS[terminal_index];
    let owner: u64 = cspace_handle_for_slot(cspace_id);
    if owner == 0
        || CSPACE_CHILD_REFS[cspace_id] != 0
        || CSPACE_LEASE_REFS[cspace_id] != 0 {
        return 0;
    }

    GENERATIONS[terminal_index] = GENERATION_LAST_LIVE;
    let terminal_handle: u64 = install_for_owner(
        owner,
        terminal_slot,
        0xcafe,
        OBJECT_DEBUG,
        RIGHT_DEBUG_WRITE
    );
    let mut terminal_passed: bool = terminal_handle != 0
        && (terminal_handle >> 32) as u32 == GENERATION_LAST_LIVE;
    if terminal_passed && close_for_owner(owner, terminal_handle) != 1 {
        terminal_passed = false;
    }
    if terminal_passed {
        let retired_install: u64 = install_for_owner(
            owner,
            terminal_slot,
            0xbeef,
            OBJECT_DEBUG,
            RIGHT_DEBUG_WRITE
        );
        if OCCUPIED[terminal_index] != SLOT_RETIRED
            || GENERATIONS[terminal_index] != GENERATION_RETIRED
            || retired_install != 0
        {
            terminal_passed = false;
        }
    }
    OBJECT_IDS[terminal_index] = 0;
    OBJECT_TYPES[terminal_index] = 0;
    RIGHTS[terminal_index] = 0;
    GENERATIONS[terminal_index] = saved_slot_generation;
    OCCUPIED[terminal_index] = SLOT_EMPTY;
    if !terminal_passed || !invariants_hold() {
        return 0;
    }

    let saved_zero_generation: u32 = GENERATIONS[zero_index];
    GENERATIONS[zero_index] = GENERATION_INVALID;
    let zero_install: u64 = install_for_owner(
        owner,
        zero_slot,
        0xd00d,
        OBJECT_DEBUG,
        RIGHT_DEBUG_WRITE
    );
    let zero_passed: bool = zero_install == 0
        && GENERATIONS[zero_index] == GENERATION_INVALID
        && !invariants_hold();
    GENERATIONS[zero_index] = saved_zero_generation;
    if !zero_passed || !invariants_hold() {
        return 0;
    }

    CSPACE_GENERATIONS[cspace_id] = GENERATION_LAST_LIVE;
    let final_owner: u64 = cspace_handle_for_slot(cspace_id);
    let mut cspace_retirement_passed: bool = final_owner != 0
        && invariants_hold();
    if cspace_retirement_passed && destroy_cspace(final_owner) != 1 {
        cspace_retirement_passed = false;
    }
    if cspace_retirement_passed
        && (CSPACE_STATES[cspace_id] != CSPACE_RETIRED
            || CSPACE_GENERATIONS[cspace_id] != GENERATION_RETIRED
            || CSPACE_CHILD_REFS[cspace_id] != 0
            || CSPACE_LEASE_REFS[cspace_id] != 0
            || !invariants_hold()
            || create_cspace(cspace_id) != 0) {
        cspace_retirement_passed = false;
    }
    let mut capability_slot: usize = 0;
    while capability_slot < CAPABILITIES_PER_CSPACE {
        let index: usize = table_index(cspace_id, capability_slot);
        OBJECT_IDS[index] = 0;
        OBJECT_TYPES[index] = 0;
        RIGHTS[index] = 0;
        GENERATIONS[index] = saved_slot_generation;
        OCCUPIED[index] = SLOT_EMPTY;
        capability_slot += 1;
    }
    CSPACE_GENERATIONS[cspace_id] = saved_cspace_generation;
    CSPACE_CHILD_REFS[cspace_id] = 0;
    CSPACE_LEASE_REFS[cspace_id] = 0;
    CSPACE_STATES[cspace_id] = CSPACE_LIVE;
    if !cspace_retirement_passed || !invariants_hold() {
        return 0;
    }

    return 1;
}

module runtime::m6_linux_supervisord;

const SYS_DEBUG_WRITE: u64 = 0;
const SYS_YIELD: u64 = 4;
const SYS_ENDPOINT_SEND: u64 = 9;
const SYS_ENDPOINT_RECEIVE: u64 = 10;
const SYS_PERSONALITY_SUPERVISE: u64 = 16;

const ERR_IPC_RETRY: u64 = 0xffff_ffff_ffff_ffe8;
const ERR_PERSONALITY_BUSY: u64 = 0xffff_ffff_ffff_ffd6;

const CONFIG_VA: usize = 0x0120_1000;
const PROGRESS_OFFSET: usize = 0;
const SUPERVISE_CAP_OFFSET: usize = 8;
const GENERATION_OFFSET: usize = 16;
const PUBLISHED_GENERATION_OFFSET: usize = 24;
const INBOX_SEND_CAP_OFFSET: usize = 32;
const HEALTH_REPLY_CAP_OFFSET: usize = 40;
const SERVICE_PROCESS_OFFSET: usize = 48;
const MESSAGE_OFFSET: usize = 128;
const MESSAGE_SIZE: u64 = 32;

const SUPERVISE_PUBLISH: u64 = 1;
const SUPERVISE_MONITOR: u64 = 2;
const SUPERVISE_RESTART: u64 = 3;
const SUPERVISE_STOP: u64 = 5;

const MONITOR_SERVICE_CRASH: u64 = 0xfe;
const MONITOR_CLIENT_COMPLETE: u64 = 0xff;
const OP_HEALTH: u64 = 0x80;
const OP_STOP: u64 = 0x82;
const HEALTH_CORRELATION_G1: u64 = 0x4d36_4c00_0000_1101;
const HEALTH_CORRELATION_G2: u64 = 0x4d36_4c00_0000_1201;
const STOP_CORRELATION_G2: u64 = 0x4d36_4c00_0000_1202;
const HEALTH_OK: u64 = 0x4d36_4c48_4541_4c00;
const STOP_READY: u64 = 0x4d36_4c53_544f_5000;

// Keeping this sole marker in the text segment avoids an otherwise empty
// read-only LOAD and leaves deterministic OVFS headroom for the pinned ELF.
@link_section(".text")
static POLICY_PASS: [u8; 38] =
    b"M6 Linux supervisor policy loop: PASS\n";

unsafe fn stop() -> never {
    loop {
        asm!("pause", options(nomem, nostack));
    }
}

unsafe fn config(offset: usize) -> u64 {
    return volatile_load((CONFIG_VA + offset) as *const u64);
}

unsafe fn emit(capability: u64, pointer: *const u8, length: usize) -> void {
    if syscall3(
        SYS_DEBUG_WRITE,
        capability,
        pointer as u64,
        length as u64
    ) != length as u64 {
        stop();
    }
}

unsafe fn yield_once() -> void {
    if syscall0(SYS_YIELD) != 0 {
        stop();
    }
}

unsafe fn supervise(
    capability: u64,
    action: u64,
    generation: u64,
    subject: u64
) -> u64 {
    return syscall4(
        SYS_PERSONALITY_SUPERVISE,
        capability,
        action,
        generation,
        subject
    );
}

unsafe fn send(
    capability: u64,
    correlation: u64,
    operation: u64
) -> void {
    loop {
        let result: u64 = syscall4(
            SYS_ENDPOINT_SEND,
            capability,
            correlation,
            operation << 56,
            0
        );
        if result == 1 {
            return;
        }
        if result != ERR_IPC_RETRY {
            stop();
        }
    }
}

unsafe fn receive(capability: u64) -> u64 {
    loop {
        let result: u64 = syscall3(
            SYS_ENDPOINT_RECEIVE,
            capability,
            (CONFIG_VA + MESSAGE_OFFSET) as u64,
            MESSAGE_SIZE
        );
        if result != ERR_IPC_RETRY {
            return result;
        }
    }
}

unsafe fn word(offset: usize) -> u64 {
    return volatile_load((CONFIG_VA + MESSAGE_OFFSET + offset) as *const u64);
}

unsafe fn health(
    inbox: u64,
    reply: u64,
    expected_process: u64,
    generation: u64,
    correlation: u64
) -> bool {
    send(inbox, correlation, OP_HEALTH);
    return receive(reply) == 1
        && word(0) == expected_process
        && word(8) == correlation
        && word(16) == (HEALTH_OK | generation)
        && word(24) == 0;
}

unsafe fn wait_config_generation(generation: u64) -> void {
    while config(GENERATION_OFFSET) != generation {
        yield_once();
    }
}

unsafe fn wait_monitor(
    capability: u64,
    generation: u64,
    subject: u64
) -> u64 {
    loop {
        let result: u64 = supervise(
            capability,
            SUPERVISE_MONITOR,
            generation,
            subject
        );
        if result != 0 && result != ERR_PERSONALITY_BUSY {
            return result;
        }
        yield_once();
    }
}

@export
@no_mangle
@link_section(".text.entry")
pub unsafe fn _start(
    report_capability: u64,
    bootstrap_supervise_capability: u64
) -> never {
    let mut supervise_capability: u64 = config(SUPERVISE_CAP_OFFSET);
    if supervise_capability == 0 {
        supervise_capability = bootstrap_supervise_capability;
    }
    if report_capability == 0 || supervise_capability == 0 {
        stop();
    }

    wait_config_generation(1);
    if !health(
        config(INBOX_SEND_CAP_OFFSET),
        config(HEALTH_REPLY_CAP_OFFSET),
        config(SERVICE_PROCESS_OFFSET),
        1,
        HEALTH_CORRELATION_G1
    ) || supervise(
        supervise_capability,
        SUPERVISE_PUBLISH,
        1,
        0
    ) != 1
        || wait_monitor(supervise_capability, 1, 0) != 1
        || wait_monitor(
            supervise_capability,
            1,
            MONITOR_SERVICE_CRASH
        ) != 1
        || supervise(
            supervise_capability,
            SUPERVISE_RESTART,
            1,
            2
        ) != 1 {
        stop();
    }

    wait_config_generation(2);
    let replacement_supervise_capability: u64 = config(
        SUPERVISE_CAP_OFFSET
    );
    if replacement_supervise_capability == 0
        || replacement_supervise_capability == supervise_capability
        || config(INBOX_SEND_CAP_OFFSET) == 0
        || config(HEALTH_REPLY_CAP_OFFSET) == 0
        || !health(
            config(INBOX_SEND_CAP_OFFSET),
            config(HEALTH_REPLY_CAP_OFFSET),
            config(SERVICE_PROCESS_OFFSET),
            2,
            HEALTH_CORRELATION_G2
        ) {
        stop();
    }
    supervise_capability = replacement_supervise_capability;
    if supervise(
        supervise_capability,
        SUPERVISE_PUBLISH,
        2,
        0
    ) != 1 {
        stop();
    }
    while config(PUBLISHED_GENERATION_OFFSET) != 2 {
        yield_once();
    }
    if wait_monitor(
        supervise_capability,
        2,
        MONITOR_CLIENT_COMPLETE
    ) != 1 {
        stop();
    }

    send(
        config(INBOX_SEND_CAP_OFFSET),
        STOP_CORRELATION_G2,
        OP_STOP
    );
    if receive(config(HEALTH_REPLY_CAP_OFFSET)) != 1
        || word(0) != config(SERVICE_PROCESS_OFFSET)
        || word(8) != STOP_CORRELATION_G2
        || word(16) != (STOP_READY | 2)
        || word(24) != 0
        || supervise(
            supervise_capability,
            SUPERVISE_STOP,
            2,
            0
        ) != 1 {
        stop();
    }
    emit(report_capability, (&POLICY_PASS[0]), 38);
    volatile_store((CONFIG_VA + PROGRESS_OFFSET) as *mut u64, 8);
    stop();
}

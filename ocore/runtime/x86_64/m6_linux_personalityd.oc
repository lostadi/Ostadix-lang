module runtime::m6_linux_personalityd;

// This daemon serves only the pinned linux_minimal_guest.S corpus.  It is a
// native O-core principal; Linux syscall numbers and fd integers are decoded
// by the kernel-side personality adapter, never as O-core capabilities.
const SYS_DEBUG_WRITE: u64 = 0;
const SYS_YIELD: u64 = 4;
const SYS_ENDPOINT_SEND: u64 = 9;
const SYS_ENDPOINT_RECEIVE: u64 = 10;
const SYS_PERSONALITY_VIEW_LOOKUP: u64 = 18;
const SYS_LINUX_MINIMAL_COMPLETE: u64 = 22;

const ERR_IPC_RETRY: u64 = 0xffff_ffff_ffff_ffe8;
const ERR_PERSONALITY_STALE: u64 = 0xffff_ffff_ffff_ffd4;

const CONFIG_VA: usize = 0x0120_1000;
const PROGRESS_OFFSET: usize = 0;
const GENERATION_OFFSET: usize = 16;
const INBOX_CAP_OFFSET: usize = 32;
const REPLY_CAP_OFFSET: usize = 40;
const DIRECT_REPLY_CAP_OFFSET: usize = 48;
const CLIENT_PROCESS_OFFSET: usize = 56;
const SUPERVISOR_PROCESS_OFFSET: usize = 64;
const PRIOR_REQUEST_OFFSET: usize = 72;
const MESSAGE_OFFSET: usize = 128;
const MESSAGE_SIZE: u64 = 32;

const LINUX_NR_WRITE: u64 = 1;
const LINUX_FD_STDOUT: u64 = 1;
const LINUX_FD_STDERR: u64 = 2;
const PINNED_WRITE_LENGTH: u64 = 20;
const WRITE_FRAME_FD_MASK: u64 = 0x0000_ffff_ffff_ffff;
const WRITE_FRAME_LENGTH_MASK: u64 = 0xff;

const OP_HEALTH: u64 = 0x80;
const OP_STOP: u64 = 0x82;
const HEALTH_OK: u64 = 0x4d36_4c48_4541_4c00;
const STOP_READY: u64 = 0x4d36_4c53_544f_5000;

@link_section(".rodata")
static G1_ONLINE: [u8; 43] =
    b"M6 Linux personality daemon ELF g1: online\n";
@link_section(".rodata")
static G1_WRITE_PASS: [u8; 44] =
    b"M6 Linux stdout bounded completion g1: PASS\n";
@link_section(".rodata")
static G1_FAULT: [u8; 53] =
    b"M6 Linux personality daemon ELF g1: deliberate fault\n";
@link_section(".rodata")
static G2_ONLINE: [u8; 43] =
    b"M6 Linux personality daemon ELF g2: online\n";
@link_section(".rodata")
static STALE_G1: [u8; 50] =
    b"M6 Linux prior-generation request rejection: PASS\n";
@link_section(".rodata")
static G2_WRITE_PASS: [u8; 44] =
    b"M6 Linux stderr bounded completion g2: PASS\n";
@link_section(".rodata")
static STOPPING: [u8; 48] =
    b"M6 Linux personality g2 cooperative stop: ready\n";

unsafe fn stop() -> never {
    loop {
        asm!("pause", options(nomem, nostack));
    }
}

unsafe fn config(offset: usize) -> u64 {
    return volatile_load((CONFIG_VA + offset) as *const u64);
}

unsafe fn progress(value: u64) -> void {
    volatile_store((CONFIG_VA + PROGRESS_OFFSET) as *mut u64, value);
}

unsafe fn emit(capability: u64, pointer: *const u8, length: usize) -> void {
    if syscall3(
        SYS_DEBUG_WRITE,
        capability,
        pointer as u64,
        length as u64
    ) != length as u64 {
        stop();
    }
}

unsafe fn yield_once() -> void {
    if syscall0(SYS_YIELD) != 0 {
        stop();
    }
}

unsafe fn wait_nonzero(offset: usize) -> u64 {
    loop {
        let value: u64 = config(offset);
        if value != 0 {
            return value;
        }
        yield_once();
    }
}

unsafe fn receive(capability: u64) -> void {
    loop {
        let result: u64 = syscall3(
            SYS_ENDPOINT_RECEIVE,
            capability,
            (CONFIG_VA + MESSAGE_OFFSET) as u64,
            MESSAGE_SIZE
        );
        if result == 1 {
            return;
        }
        if result != ERR_IPC_RETRY {
            stop();
        }
    }
}

unsafe fn word(offset: usize) -> u64 {
    return volatile_load((CONFIG_VA + MESSAGE_OFFSET + offset) as *const u64);
}

unsafe fn direct_reply(
    capability: u64,
    correlation: u64,
    scalar: u64
) -> void {
    loop {
        let result: u64 = syscall4(
            SYS_ENDPOINT_SEND,
            capability,
            correlation,
            scalar,
            0
        );
        if result == 1 {
            return;
        }
        if result != ERR_IPC_RETRY {
            stop();
        }
    }
}

unsafe fn lookup(reply_capability: u64, request: u64) -> u64 {
    let view: u64 = syscall2(
        SYS_PERSONALITY_VIEW_LOOKUP,
        reply_capability,
        request
    );
    // Live capability generations never use the all-ones high word reserved
    // by the native errno range.
    if view == 0 || (view >> 32) == 0xffff_ffff {
        stop();
    }
    return view;
}

unsafe fn complete_write(
    reply_capability: u64,
    request: u64,
    view: u64,
    linux_fd: u64,
    length: u64
) -> void {
    if syscall5(
        SYS_LINUX_MINIMAL_COMPLETE,
        reply_capability,
        request,
        view,
        linux_fd,
        length
    ) != 1 {
        stop();
    }
}

unsafe fn run_g1(
    report: u64,
    inbox: u64,
    reply: u64,
    direct: u64,
    client: u64,
    supervisor: u64
) -> never {
    loop {
        receive(inbox);
        let sender: u64 = word(0);
        let request: u64 = word(8);
        let frame: u64 = word(16);
        if request == 0 || word(24) != 0 {
            stop();
        }
        if sender == supervisor {
            if (frame >> 56) != OP_HEALTH {
                stop();
            }
            direct_reply(direct, request, HEALTH_OK | 1);
        } else {
            if sender != client
                || (frame >> 56) != LINUX_NR_WRITE
                || ((frame >> 8) & WRITE_FRAME_FD_MASK)
                    != LINUX_FD_STDOUT
                || (frame & WRITE_FRAME_LENGTH_MASK)
                    != PINNED_WRITE_LENGTH {
                stop();
            }
            let linux_fd: u64 = (frame >> 8) & WRITE_FRAME_FD_MASK;
            let length: u64 = frame & WRITE_FRAME_LENGTH_MASK;
            let view: u64 = lookup(reply, request);
            complete_write(reply, request, view, linux_fd, length);
            emit(report, (&G1_WRITE_PASS[0]), 44);
            progress(3);
            emit(report, (&G1_FAULT[0]), 53);
            progress(7);
            asm!("ud2", options(nomem, nostack));
            stop();
        }
    }
}

unsafe fn run_g2(
    report: u64,
    inbox: u64,
    reply: u64,
    direct: u64,
    client: u64,
    supervisor: u64
) -> never {
    let stale_request: u64 = wait_nonzero(PRIOR_REQUEST_OFFSET);
    if syscall2(
        SYS_PERSONALITY_VIEW_LOOKUP,
        reply,
        stale_request
    ) != ERR_PERSONALITY_STALE {
        stop();
    }
    emit(report, (&STALE_G1[0]), 50);
    progress(2);

    let mut stderr_complete: bool = false;
    loop {
        receive(inbox);
        let sender: u64 = word(0);
        let correlation: u64 = word(8);
        let frame: u64 = word(16);
        let operation: u64 = frame >> 56;
        if correlation == 0 || word(24) != 0 {
            stop();
        }
        if sender == client {
            if stderr_complete
                || operation != LINUX_NR_WRITE
                || ((frame >> 8) & WRITE_FRAME_FD_MASK)
                    != LINUX_FD_STDERR
                || (frame & WRITE_FRAME_LENGTH_MASK)
                    != PINNED_WRITE_LENGTH {
                stop();
            }
            let linux_fd: u64 = (frame >> 8) & WRITE_FRAME_FD_MASK;
            let length: u64 = frame & WRITE_FRAME_LENGTH_MASK;
            let view: u64 = lookup(reply, correlation);
            complete_write(reply, correlation, view, linux_fd, length);
            stderr_complete = true;
            emit(report, (&G2_WRITE_PASS[0]), 44);
            progress(6);
        } else {
            if sender != supervisor {
                stop();
            }
            if operation == OP_HEALTH {
                direct_reply(direct, correlation, HEALTH_OK | 2);
            } else {
                if operation != OP_STOP || !stderr_complete {
                    stop();
                }
                emit(report, (&STOPPING[0]), 48);
                progress(7);
                direct_reply(direct, correlation, STOP_READY | 2);
                stop();
            }
        }
    }
}

@export
@no_mangle
@link_section(".text.entry")
pub unsafe fn _start(report_capability: u64, boot_generation: u64) -> never {
    let generation: u64 = config(GENERATION_OFFSET);
    let inbox: u64 = wait_nonzero(INBOX_CAP_OFFSET);
    let reply: u64 = wait_nonzero(REPLY_CAP_OFFSET);
    let direct: u64 = wait_nonzero(DIRECT_REPLY_CAP_OFFSET);
    let client: u64 = wait_nonzero(CLIENT_PROCESS_OFFSET);
    let supervisor: u64 = wait_nonzero(SUPERVISOR_PROCESS_OFFSET);
    if report_capability == 0
        || generation == 0
        || generation != boot_generation {
        stop();
    }
    if generation == 1 {
        emit(report_capability, (&G1_ONLINE[0]), 43);
        progress(1);
        run_g1(
            report_capability,
            inbox,
            reply,
            direct,
            client,
            supervisor
        );
    }
    if generation == 2 {
        emit(report_capability, (&G2_ONLINE[0]), 43);
        progress(1);
        run_g2(
            report_capability,
            inbox,
            reply,
            direct,
            client,
            supervisor
        );
    }
    stop();
}

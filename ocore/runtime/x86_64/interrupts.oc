module runtime::interrupts;

use runtime::serial::write_byte;
use runtime::scheduler::on_timer as scheduler_on_timer;

@packed
struct IdtEntry {
    offset_low: u16,
    selector: u16,
    ist: u8,
    attributes: u8,
    offset_mid: u16,
    offset_high: u32,
    zero: u32,
}

@packed
struct Idtr {
    limit: u16,
    base: usize,
}

static mut IDT: [IdtEntry; 256] = [IdtEntry {
    offset_low: 0,
    selector: 0,
    ist: 0,
    attributes: 0,
    offset_mid: 0,
    offset_high: 0,
    zero: 0,
}; 256];

static mut TICKS: u64 = 0;
static mut FAULT_MONITOR_MODE: u64 = 0;
static mut FAULT_MONITOR_REPORTED: u8 = 0;
static POST_FAULT_TIMER_MESSAGE: [u8; 29] = b"M02 post-fault timer: online\n";
static FAULT_CONTAINMENT_MESSAGE: [u8; 28] = b"M02 fault containment: PASS\n";

extern "sysv64" fn ocore_exception_stub_address(vector: usize) -> usize;
extern "sysv64" fn ocore_timer_interrupt_entry() -> void;

unsafe fn set_gate(
    vector: usize,
    handler: usize,
    ist: u8,
    attributes: u8
) -> void {
    IDT[vector].offset_low = handler as u16;
    IDT[vector].selector = 0x08;
    IDT[vector].ist = ist;
    IDT[vector].attributes = attributes;
    IDT[vector].offset_mid = (handler >> 16) as u16;
    IDT[vector].offset_high = (handler >> 32) as u32;
    IDT[vector].zero = 0;
}

@export
@no_mangle
pub unsafe fn kernel_timer_dispatch(frame: *mut u64) -> usize {
    let previous: u64 = atomic_fetch_add((&mut TICKS), 1, seq_cst);
    if previous == 0 {
        write_byte(b'T');
        write_byte(b'\n');
    }
    if FAULT_MONITOR_MODE != 0 && FAULT_MONITOR_REPORTED == 0 {
        FAULT_MONITOR_REPORTED = 1;
        let mut index: usize = 0;
        while index < 29 {
            write_byte(POST_FAULT_TIMER_MESSAGE[index]);
            index += 1;
        }
        index = 0;
        while index < 28 {
            write_byte(FAULT_CONTAINMENT_MESSAGE[index]);
            index += 1;
        }
    }
    if frame as usize == 0 {
        return 0;
    }
    let from_user: bool = (volatile_load(frame + 18) & 3) == 3;
    return scheduler_on_timer(frame, previous + 1, from_user);
}

unsafe fn remap_pic() -> void {
    outb(0x20, 0x11);
    outb(0xa0, 0x11);
    outb(0x21, 0x20);
    outb(0xa1, 0x28);
    outb(0x21, 0x04);
    outb(0xa1, 0x02);
    outb(0x21, 0x01);
    outb(0xa1, 0x01);
    outb(0x21, 0xfe);
    outb(0xa1, 0xff);
}

unsafe fn configure_pit() -> void {
    let divisor: u16 = 1193;
    // Channel 0, low/high byte, interrupt-on-terminal-count one-shot.
    outb(0x43, 0x30);
    outb(0x40, (divisor & 0xff) as u8);
    outb(0x40, (divisor >> 8) as u8);
}

// Assembly calls this after either the selected return frame has passed every
// validation or the timer dispatcher has selected management completion.
// Starting the next one-shot interval there, with interrupts still masked,
// prevents scheduler and return-validation work from consuming the next
// nominal one-millisecond execution budget. Ticks are service-paced, not a
// wall-clock guarantee under arbitrarily accelerated virtual time.
@export
@no_mangle
pub unsafe fn kernel_timer_rearm() -> void {
    // Retire the completed IRQ before lowering channel 0's OUT signal and
    // starting its next count. If host execution pauses between these two
    // operations, the already-terminal one-shot cannot accumulate timer debt.
    outb(0x20, 0x20);
    configure_pit();
}

pub unsafe fn init() -> void {
    let mut vector: usize = 0;
    while vector < 32 {
        let handler: usize = ocore_exception_stub_address(vector);
        if handler == 0 {
            return;
        }
        let mut ist: u8 = 0;
        if vector == 8 {
            ist = 1;
        }
        let mut attributes: u8 = 0x8e;
        if vector == 3 || vector == 4 {
            attributes = 0xee;
        }
        set_gate(vector, handler, ist, attributes);
        vector += 1;
    }
    set_gate(32, ocore_timer_interrupt_entry as usize, 0, 0x8e);
    let idtr: Idtr = Idtr {
        limit: 4095,
        base: (&IDT) as usize,
    };
    asm!("lidt [rax]", in("rax") (&idtr), options(readonly, nostack));
    remap_pic();
    configure_pit();
}

pub unsafe fn arm_fault_monitor(mode: u64) -> void {
    FAULT_MONITOR_REPORTED = 0;
    FAULT_MONITOR_MODE = mode;
}

pub unsafe fn ticks() -> u64 {
    return atomic_load((&TICKS), acquire);
}

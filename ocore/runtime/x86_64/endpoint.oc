module runtime::endpoint;

use runtime::capability::abort_close_for_owner;
use runtime::capability::begin_close_for_owner;
use runtime::capability::closing_matches_for_owner;
use runtime::capability::cspace_child_refs;
use runtime::capability::cspace_is_live;
use runtime::capability::cspace_is_valid_owner;
use runtime::capability::invariants_hold as capability_invariants_hold;
use runtime::capability::release_cspace;
use runtime::capability::retain_cspace;
use runtime::capability::CAPABILITIES_PER_CSPACE;
use runtime::process::can_issue_operations;
use runtime::process::MAX_PROCESSES;

// The first native IPC registry is intentionally small and auditable. Queue
// entries contain values and generation-tagged identities only. In particular,
// there is no address-sized buffer field that could be mistaken for a kernel
// pointer or dereferenced by this module.
pub const MAX_ENDPOINTS: usize = 8;
pub const ENDPOINT_QUEUE_CAPACITY: usize = 4;
pub const MAX_BLOCKED_SENDERS: usize = 4;

pub const ENDPOINT_CLOSE_NONE: u64 = 0;
pub const ENDPOINT_CLOSE_NORMAL: u64 = 1;
pub const ENDPOINT_CLOSE_CRASH: u64 = 2;

pub const ENDPOINT_WAITER_NONE: u64 = 0;
pub const ENDPOINT_WAITER_RECEIVER: u64 = 1;
pub const ENDPOINT_WAITER_SENDER: u64 = 2;

const ENDPOINT_EMPTY: u8 = 0;
const ENDPOINT_LIVE: u8 = 1;
const ENDPOINT_DRAINING: u8 = 2;
const ENDPOINT_RETIRED: u8 = 3;

const ENDPOINT_HANDLE_TAG: u64 = 0xe300_0000;
const PROCESS_HANDLE_TAG: u64 = 0xe100_0000;
const THREAD_HANDLE_TAG: u64 = 0xe200_0000;
const HANDLE_TAG_MASK: u64 = 0xff00_0000;
const HANDLE_INDEX_MASK: u64 = 0x00ff_ffff;
const THREAD_HANDLE_SLOTS: usize = 4;

static mut INITIALIZED: u8 = 0;
static mut POISONED: u8 = 0;
static mut STATES: [u8; 8] = [0; 8];
static mut GENERATIONS: [u32; 8] = [0; 8];
static mut RECEIVER_CSPACE_OWNERS: [u64; 8] = [0; 8];
static mut REFERENCES: [u32; 8] = [0; 8];
static mut CLOSE_REASONS: [u8; 8] = [0; 8];
static mut DISCARDED_MESSAGES: [u32; 8] = [0; 8];
static mut CAPABILITY_CLEANUP_HEADS: [usize; 8] = [0; 8];
static mut CAPABILITY_CLEANUP_LENGTHS: [usize; 8] = [0; 8];
static mut CAPABILITY_CLEANUP: [u64; 32] = [0; 32];
static mut CAPABILITY_CLEANUP_OBJECTS: [u64; 32] = [0; 32];
static mut CAPABILITY_CLEANUP_TYPES: [u64; 32] = [0; 32];
static mut CAPABILITY_CLEANUP_RIGHTS: [u64; 32] = [0; 32];

// Each endpoint owns a four-element message ring. The destination capability
// is created by the capability-transfer transaction before enqueue and is
// therefore a handle in the receiver's exact CSpace generation. Zero means
// that the message transfers no capability.
static mut MESSAGE_HEADS: [usize; 8] = [0; 8];
static mut MESSAGE_LENGTHS: [usize; 8] = [0; 8];
static mut MESSAGE_SENDERS: [u64; 32] = [0; 32];
static mut MESSAGE_CORRELATIONS: [u64; 32] = [0; 32];
static mut MESSAGE_PAYLOADS: [u64; 32] = [0; 32];
static mut MESSAGE_DESTINATION_CAPS: [u64; 32] = [0; 32];
static mut MESSAGE_DESTINATION_OBJECTS: [u64; 32] = [0; 32];
static mut MESSAGE_DESTINATION_TYPES: [u64; 32] = [0; 32];
static mut MESSAGE_DESTINATION_RIGHTS: [u64; 32] = [0; 32];

// Wait lists also store complete generation-tagged thread handles. Endpoint
// code never changes thread state and never calls the scheduler. The caller
// takes a handle and performs the wake or cancellation transition separately.
static mut RECEIVER_WAITERS: [u64; 8] = [0; 8];
static mut SENDER_WAITER_HEADS: [usize; 8] = [0; 8];
static mut SENDER_WAITER_LENGTHS: [usize; 8] = [0; 8];
static mut SENDER_WAITERS: [u64; 32] = [0; 32];

fn endpoint_index(handle: u64) -> usize {
    return (handle & HANDLE_INDEX_MASK) as usize;
}

fn endpoint_generation(handle: u64) -> u32 {
    return (handle >> 32) as u32;
}

fn queue_index(slot: usize, physical: usize) -> usize {
    return slot * ENDPOINT_QUEUE_CAPACITY + physical;
}

unsafe fn make_handle(slot: usize) -> u64 {
    return ((GENERATIONS[slot] as u64) << 32)
        | ENDPOINT_HANDLE_TAG
        | slot as u64;
}

unsafe fn checked_endpoint(handle: u64) -> usize {
    if INITIALIZED == 0
        || POISONED != 0
        || (handle & HANDLE_TAG_MASK) != ENDPOINT_HANDLE_TAG {
        return MAX_ENDPOINTS;
    }
    let slot: usize = endpoint_index(handle);
    if slot >= MAX_ENDPOINTS
        || (STATES[slot] != ENDPOINT_LIVE
            && STATES[slot] != ENDPOINT_DRAINING)
        || GENERATIONS[slot] != endpoint_generation(handle) {
        return MAX_ENDPOINTS;
    }
    return slot;
}

unsafe fn checked_live_endpoint(handle: u64) -> usize {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS || STATES[slot] != ENDPOINT_LIVE {
        return MAX_ENDPOINTS;
    }
    return slot;
}

fn process_handle_shape_valid(handle: u64) -> bool {
    return handle != 0
        && (handle & HANDLE_TAG_MASK) == PROCESS_HANDLE_TAG
        && (handle & HANDLE_INDEX_MASK) < MAX_PROCESSES as u64
        && endpoint_generation(handle) != 0;
}

// Importing runtime::thread here would create the dependency cycle this
// registry is intended to avoid. The kind tag, bounded index, and nonzero
// generation establish that a waiter is a complete TCB identity; the caller
// remains responsible for the exact live-thread transition.
fn thread_handle_shape_valid(handle: u64) -> bool {
    return handle != 0
        && (handle & HANDLE_TAG_MASK) == THREAD_HANDLE_TAG
        && (handle & HANDLE_INDEX_MASK) < THREAD_HANDLE_SLOTS as u64
        && endpoint_generation(handle) != 0;
}

fn capability_handle_shape_valid(handle: u64) -> bool {
    if handle == 0 {
        return true;
    }
    return (handle & 0xffff_ffff) < CAPABILITIES_PER_CSPACE as u64
        && (handle >> 32) != 0;
}

unsafe fn escrow_record_valid(
    owner: u64,
    capability: u64,
    object: u64,
    object_type: u64,
    rights: u64
) -> bool {
    if capability == 0 {
        return object == 0 && object_type == 0 && rights == 0;
    }
    return capability_handle_shape_valid(capability)
        && closing_matches_for_owner(
            owner,
            capability,
            object,
            object_type,
            rights
        );
}

unsafe fn message_physical_active(slot: usize, physical: usize) -> bool {
    let mut position: usize = 0;
    while position < MESSAGE_LENGTHS[slot] {
        if (MESSAGE_HEADS[slot] + position) % ENDPOINT_QUEUE_CAPACITY
            == physical {
            return true;
        }
        position += 1;
    }
    return false;
}

unsafe fn sender_waiter_physical_active(slot: usize, physical: usize) -> bool {
    let mut position: usize = 0;
    while position < SENDER_WAITER_LENGTHS[slot] {
        if (SENDER_WAITER_HEADS[slot] + position) % MAX_BLOCKED_SENDERS
            == physical {
            return true;
        }
        position += 1;
    }
    return false;
}

unsafe fn capability_cleanup_physical_active(
    slot: usize,
    physical: usize
) -> bool {
    let mut position: usize = 0;
    while position < CAPABILITY_CLEANUP_LENGTHS[slot] {
        if (CAPABILITY_CLEANUP_HEADS[slot] + position)
            % ENDPOINT_QUEUE_CAPACITY == physical {
            return true;
        }
        position += 1;
    }
    return false;
}

unsafe fn message_at(slot: usize, position: usize) -> usize {
    if position >= MESSAGE_LENGTHS[slot] {
        return ENDPOINT_QUEUE_CAPACITY;
    }
    return (MESSAGE_HEADS[slot] + position) % ENDPOINT_QUEUE_CAPACITY;
}

unsafe fn sender_waiter_at(slot: usize, position: usize) -> u64 {
    if position >= SENDER_WAITER_LENGTHS[slot] {
        return 0;
    }
    let physical: usize =
        (SENDER_WAITER_HEADS[slot] + position) % MAX_BLOCKED_SENDERS;
    return SENDER_WAITERS[queue_index(slot, physical)];
}

unsafe fn clear_message_cell(slot: usize, physical: usize) -> void {
    let index: usize = queue_index(slot, physical);
    MESSAGE_SENDERS[index] = 0;
    MESSAGE_CORRELATIONS[index] = 0;
    MESSAGE_PAYLOADS[index] = 0;
    MESSAGE_DESTINATION_CAPS[index] = 0;
    MESSAGE_DESTINATION_OBJECTS[index] = 0;
    MESSAGE_DESTINATION_TYPES[index] = 0;
    MESSAGE_DESTINATION_RIGHTS[index] = 0;
}

unsafe fn clear_slot(slot: usize) -> void {
    RECEIVER_CSPACE_OWNERS[slot] = 0;
    REFERENCES[slot] = 0;
    CLOSE_REASONS[slot] = ENDPOINT_CLOSE_NONE as u8;
    DISCARDED_MESSAGES[slot] = 0;
    CAPABILITY_CLEANUP_HEADS[slot] = 0;
    CAPABILITY_CLEANUP_LENGTHS[slot] = 0;
    MESSAGE_HEADS[slot] = 0;
    MESSAGE_LENGTHS[slot] = 0;
    RECEIVER_WAITERS[slot] = 0;
    SENDER_WAITER_HEADS[slot] = 0;
    SENDER_WAITER_LENGTHS[slot] = 0;
    let mut physical: usize = 0;
    while physical < ENDPOINT_QUEUE_CAPACITY {
        clear_message_cell(slot, physical);
        let index: usize = queue_index(slot, physical);
        CAPABILITY_CLEANUP[index] = 0;
        CAPABILITY_CLEANUP_OBJECTS[index] = 0;
        CAPABILITY_CLEANUP_TYPES[index] = 0;
        CAPABILITY_CLEANUP_RIGHTS[index] = 0;
        SENDER_WAITERS[index] = 0;
        physical += 1;
    }
}

unsafe fn capability_cleanup_enqueue(
    slot: usize,
    cap: u64,
    object: u64,
    object_type: u64,
    rights: u64
) -> bool {
    if cap == 0 {
        return object == 0 && object_type == 0 && rights == 0;
    }
    if slot >= MAX_ENDPOINTS
        || !escrow_record_valid(
            RECEIVER_CSPACE_OWNERS[slot],
            cap,
            object,
            object_type,
            rights
        )
        || CAPABILITY_CLEANUP_LENGTHS[slot] >= ENDPOINT_QUEUE_CAPACITY {
        return false;
    }
    let physical: usize =
        (CAPABILITY_CLEANUP_HEADS[slot]
            + CAPABILITY_CLEANUP_LENGTHS[slot])
            % ENDPOINT_QUEUE_CAPACITY;
    let index: usize = queue_index(slot, physical);
    if CAPABILITY_CLEANUP[index] != 0
        || CAPABILITY_CLEANUP_OBJECTS[index] != 0
        || CAPABILITY_CLEANUP_TYPES[index] != 0
        || CAPABILITY_CLEANUP_RIGHTS[index] != 0 {
        return false;
    }
    CAPABILITY_CLEANUP[index] = cap;
    CAPABILITY_CLEANUP_OBJECTS[index] = object;
    CAPABILITY_CLEANUP_TYPES[index] = object_type;
    CAPABILITY_CLEANUP_RIGHTS[index] = rights;
    CAPABILITY_CLEANUP_LENGTHS[slot] += 1;
    return true;
}

unsafe fn capability_cleanup_pop(slot: usize) -> u64 {
    if slot >= MAX_ENDPOINTS || CAPABILITY_CLEANUP_LENGTHS[slot] == 0 {
        return 0;
    }
    let physical: usize = CAPABILITY_CLEANUP_HEADS[slot];
    let index: usize = queue_index(slot, physical);
    let cap: u64 = CAPABILITY_CLEANUP[index];
    CAPABILITY_CLEANUP[index] = 0;
    CAPABILITY_CLEANUP_OBJECTS[index] = 0;
    CAPABILITY_CLEANUP_TYPES[index] = 0;
    CAPABILITY_CLEANUP_RIGHTS[index] = 0;
    CAPABILITY_CLEANUP_LENGTHS[slot] -= 1;
    if CAPABILITY_CLEANUP_LENGTHS[slot] == 0 {
        CAPABILITY_CLEANUP_HEADS[slot] = 0;
    } else {
        CAPABILITY_CLEANUP_HEADS[slot] =
            (CAPABILITY_CLEANUP_HEADS[slot] + 1)
                % ENDPOINT_QUEUE_CAPACITY;
    }
    return cap;
}

unsafe fn message_remove_at(slot: usize, position: usize) -> bool {
    if position >= MESSAGE_LENGTHS[slot] {
        return false;
    }
    let mut cursor: usize = position;
    while cursor + 1 < MESSAGE_LENGTHS[slot] {
        let target_physical: usize = message_at(slot, cursor);
        let source_physical: usize = message_at(slot, cursor + 1);
        let target: usize = queue_index(slot, target_physical);
        let source: usize = queue_index(slot, source_physical);
        MESSAGE_SENDERS[target] = MESSAGE_SENDERS[source];
        MESSAGE_CORRELATIONS[target] = MESSAGE_CORRELATIONS[source];
        MESSAGE_PAYLOADS[target] = MESSAGE_PAYLOADS[source];
        MESSAGE_DESTINATION_CAPS[target] = MESSAGE_DESTINATION_CAPS[source];
        MESSAGE_DESTINATION_OBJECTS[target] =
            MESSAGE_DESTINATION_OBJECTS[source];
        MESSAGE_DESTINATION_TYPES[target] =
            MESSAGE_DESTINATION_TYPES[source];
        MESSAGE_DESTINATION_RIGHTS[target] =
            MESSAGE_DESTINATION_RIGHTS[source];
        cursor += 1;
    }
    let old_tail: usize =
        (MESSAGE_HEADS[slot] + MESSAGE_LENGTHS[slot] - 1)
            % ENDPOINT_QUEUE_CAPACITY;
    clear_message_cell(slot, old_tail);
    MESSAGE_LENGTHS[slot] -= 1;
    if MESSAGE_LENGTHS[slot] == 0 {
        MESSAGE_HEADS[slot] = 0;
    }
    return true;
}

unsafe fn sender_waiter_pop(slot: usize) -> u64 {
    if SENDER_WAITER_LENGTHS[slot] == 0 {
        return 0;
    }
    let physical: usize = SENDER_WAITER_HEADS[slot];
    let index: usize = queue_index(slot, physical);
    let waiter: u64 = SENDER_WAITERS[index];
    SENDER_WAITERS[index] = 0;
    SENDER_WAITER_LENGTHS[slot] -= 1;
    if SENDER_WAITER_LENGTHS[slot] == 0 {
        SENDER_WAITER_HEADS[slot] = 0;
    } else {
        SENDER_WAITER_HEADS[slot] =
            (SENDER_WAITER_HEADS[slot] + 1) % MAX_BLOCKED_SENDERS;
    }
    return waiter;
}

// Remove one logical sender-waiter position without changing the FIFO order of
// any surviving waiter. The ring is deliberately compacted toward its head so
// exact cancellation cannot let a younger sender overtake an older one.
unsafe fn sender_waiter_remove_at(slot: usize, position: usize) -> u64 {
    if slot >= MAX_ENDPOINTS || position >= SENDER_WAITER_LENGTHS[slot] {
        return 0;
    }
    let removed: u64 = sender_waiter_at(slot, position);
    let mut cursor: usize = position;
    while cursor + 1 < SENDER_WAITER_LENGTHS[slot] {
        let target_physical: usize =
            (SENDER_WAITER_HEADS[slot] + cursor) % MAX_BLOCKED_SENDERS;
        let source_physical: usize =
            (SENDER_WAITER_HEADS[slot] + cursor + 1) % MAX_BLOCKED_SENDERS;
        SENDER_WAITERS[queue_index(slot, target_physical)] =
            SENDER_WAITERS[queue_index(slot, source_physical)];
        cursor += 1;
    }
    let old_tail: usize =
        (SENDER_WAITER_HEADS[slot] + SENDER_WAITER_LENGTHS[slot] - 1)
            % MAX_BLOCKED_SENDERS;
    SENDER_WAITERS[queue_index(slot, old_tail)] = 0;
    SENDER_WAITER_LENGTHS[slot] -= 1;
    if SENDER_WAITER_LENGTHS[slot] == 0 {
        SENDER_WAITER_HEADS[slot] = 0;
    }
    return removed;
}

unsafe fn waiter_occurrences(waiter: u64) -> usize {
    let mut found: usize = 0;
    let mut slot: usize = 0;
    while slot < MAX_ENDPOINTS {
        if STATES[slot] == ENDPOINT_LIVE || STATES[slot] == ENDPOINT_DRAINING {
            if RECEIVER_WAITERS[slot] == waiter {
                found += 1;
            }
            let mut position: usize = 0;
            while position < SENDER_WAITER_LENGTHS[slot] {
                if sender_waiter_at(slot, position) == waiter {
                    found += 1;
                }
                position += 1;
            }
        }
        slot += 1;
    }
    return found;
}

unsafe fn discard_messages(slot: usize) -> u32 {
    let discarded: u32 = MESSAGE_LENGTHS[slot] as u32;
    let mut position: usize = 0;
    while position < MESSAGE_LENGTHS[slot] {
        let physical: usize = message_at(slot, position);
        let index: usize = queue_index(slot, physical);
        let cap: u64 = MESSAGE_DESTINATION_CAPS[index];
        if cap != 0 && !capability_cleanup_enqueue(
            slot,
            cap,
            MESSAGE_DESTINATION_OBJECTS[index],
            MESSAGE_DESTINATION_TYPES[index],
            MESSAGE_DESTINATION_RIGHTS[index]
        ) {
            return 0xffff_ffff;
        }
        position += 1;
    }
    let mut physical: usize = 0;
    while physical < ENDPOINT_QUEUE_CAPACITY {
        clear_message_cell(slot, physical);
        physical += 1;
    }
    MESSAGE_HEADS[slot] = 0;
    MESSAGE_LENGTHS[slot] = 0;
    return discarded;
}

unsafe fn begin_drain(slot: usize, reason: u64) -> bool {
    if slot >= MAX_ENDPOINTS
        || STATES[slot] != ENDPOINT_LIVE
        || (reason != ENDPOINT_CLOSE_NORMAL && reason != ENDPOINT_CLOSE_CRASH) {
        return false;
    }
    let discarded: u32 = discard_messages(slot);
    if discarded == 0xffff_ffff {
        return false;
    }
    DISCARDED_MESSAGES[slot] = discarded;
    CLOSE_REASONS[slot] = reason as u8;
    STATES[slot] = ENDPOINT_DRAINING;
    return true;
}

// Retirement waits for both external references and deterministic waiter
// extraction. This lets the closer retrieve every cancelled full TCB handle
// before the endpoint generation advances.
unsafe fn try_retire(slot: usize) -> bool {
    if slot >= MAX_ENDPOINTS || STATES[slot] != ENDPOINT_DRAINING {
        return false;
    }
    if REFERENCES[slot] != 0
        || RECEIVER_WAITERS[slot] != 0
        || SENDER_WAITER_LENGTHS[slot] != 0
        || MESSAGE_LENGTHS[slot] != 0
        || CAPABILITY_CLEANUP_LENGTHS[slot] != 0 {
        return true;
    }
    let owner: u64 = RECEIVER_CSPACE_OWNERS[slot];
    if owner == 0 || release_cspace(owner) == 0 {
        return false;
    }
    clear_slot(slot);
    if GENERATIONS[slot] == 0xffff_ffff {
        STATES[slot] = ENDPOINT_RETIRED;
    } else {
        GENERATIONS[slot] += 1;
        STATES[slot] = ENDPOINT_EMPTY;
    }
    return true;
}

// This check is exhaustive across all eight endpoints, all 32 message cells,
// and all waiter cells. It verifies ring shape, zeroed inactive storage, handle
// kind/generation shape, globally unique waiters, exact owner liveness, and
// lifecycle-specific reference and drain rules.
pub unsafe fn invariants_hold() -> bool {
    if INITIALIZED == 0 || POISONED != 0 || !capability_invariants_hold() {
        return false;
    }
    let mut slot: usize = 0;
    while slot < MAX_ENDPOINTS {
        let state: u8 = STATES[slot];
        if GENERATIONS[slot] == 0
            || MESSAGE_LENGTHS[slot] > ENDPOINT_QUEUE_CAPACITY
            || SENDER_WAITER_LENGTHS[slot] > MAX_BLOCKED_SENDERS
            || CAPABILITY_CLEANUP_LENGTHS[slot]
                > ENDPOINT_QUEUE_CAPACITY
            || MESSAGE_LENGTHS[slot] + CAPABILITY_CLEANUP_LENGTHS[slot]
                > ENDPOINT_QUEUE_CAPACITY {
            return false;
        }
        if (MESSAGE_LENGTHS[slot] == 0 && MESSAGE_HEADS[slot] != 0)
            || (MESSAGE_LENGTHS[slot] != 0
                && MESSAGE_HEADS[slot] >= ENDPOINT_QUEUE_CAPACITY)
            || (SENDER_WAITER_LENGTHS[slot] == 0
                && SENDER_WAITER_HEADS[slot] != 0)
            || (SENDER_WAITER_LENGTHS[slot] != 0
                && SENDER_WAITER_HEADS[slot] >= MAX_BLOCKED_SENDERS) {
            return false;
        }
        if (CAPABILITY_CLEANUP_LENGTHS[slot] == 0
                && CAPABILITY_CLEANUP_HEADS[slot] != 0)
            || (CAPABILITY_CLEANUP_LENGTHS[slot] != 0
                && CAPABILITY_CLEANUP_HEADS[slot]
                    >= ENDPOINT_QUEUE_CAPACITY) {
            return false;
        }

        if state == ENDPOINT_EMPTY || state == ENDPOINT_RETIRED {
            if (state == ENDPOINT_RETIRED
                    && GENERATIONS[slot] != 0xffff_ffff)
                || RECEIVER_CSPACE_OWNERS[slot] != 0
                || REFERENCES[slot] != 0
                || CLOSE_REASONS[slot] != ENDPOINT_CLOSE_NONE as u8
                || DISCARDED_MESSAGES[slot] != 0
                || CAPABILITY_CLEANUP_HEADS[slot] != 0
                || CAPABILITY_CLEANUP_LENGTHS[slot] != 0
                || MESSAGE_HEADS[slot] != 0
                || MESSAGE_LENGTHS[slot] != 0
                || RECEIVER_WAITERS[slot] != 0
                || SENDER_WAITER_HEADS[slot] != 0
                || SENDER_WAITER_LENGTHS[slot] != 0 {
                return false;
            }
        } else if state == ENDPOINT_LIVE || state == ENDPOINT_DRAINING {
            let owner: u64 = RECEIVER_CSPACE_OWNERS[slot];
            if owner == 0
                || !cspace_is_valid_owner(owner)
                || cspace_child_refs(owner) == 0 {
                return false;
            }
            if state == ENDPOINT_LIVE {
                if REFERENCES[slot] == 0
                    || CLOSE_REASONS[slot] != ENDPOINT_CLOSE_NONE as u8
                    || DISCARDED_MESSAGES[slot] != 0 {
                    return false;
                }
            } else if (CLOSE_REASONS[slot] != ENDPOINT_CLOSE_NORMAL as u8
                    && CLOSE_REASONS[slot] != ENDPOINT_CLOSE_CRASH as u8)
                || MESSAGE_LENGTHS[slot] != 0
                || MESSAGE_HEADS[slot] != 0
                || DISCARDED_MESSAGES[slot] > ENDPOINT_QUEUE_CAPACITY as u32 {
                return false;
            }
            if RECEIVER_WAITERS[slot] != 0 {
                if !thread_handle_shape_valid(RECEIVER_WAITERS[slot])
                    || waiter_occurrences(RECEIVER_WAITERS[slot]) != 1 {
                    return false;
                }
            }
        } else {
            return false;
        }

        let mut physical: usize = 0;
        while physical < ENDPOINT_QUEUE_CAPACITY {
            let index: usize = queue_index(slot, physical);
            if message_physical_active(slot, physical) {
                if state != ENDPOINT_LIVE
                    || !process_handle_shape_valid(MESSAGE_SENDERS[index])
                    || !escrow_record_valid(
                        RECEIVER_CSPACE_OWNERS[slot],
                        MESSAGE_DESTINATION_CAPS[index],
                        MESSAGE_DESTINATION_OBJECTS[index],
                        MESSAGE_DESTINATION_TYPES[index],
                        MESSAGE_DESTINATION_RIGHTS[index]
                    ) {
                    return false;
                }
            } else if MESSAGE_SENDERS[index] != 0
                || MESSAGE_CORRELATIONS[index] != 0
                || MESSAGE_PAYLOADS[index] != 0
                || MESSAGE_DESTINATION_CAPS[index] != 0
                || MESSAGE_DESTINATION_OBJECTS[index] != 0
                || MESSAGE_DESTINATION_TYPES[index] != 0
                || MESSAGE_DESTINATION_RIGHTS[index] != 0 {
                return false;
            }

            if capability_cleanup_physical_active(slot, physical) {
                if (state != ENDPOINT_LIVE && state != ENDPOINT_DRAINING)
                    || !escrow_record_valid(
                        RECEIVER_CSPACE_OWNERS[slot],
                        CAPABILITY_CLEANUP[index],
                        CAPABILITY_CLEANUP_OBJECTS[index],
                        CAPABILITY_CLEANUP_TYPES[index],
                        CAPABILITY_CLEANUP_RIGHTS[index]
                    ) {
                    return false;
                }
            } else if CAPABILITY_CLEANUP[index] != 0
                || CAPABILITY_CLEANUP_OBJECTS[index] != 0
                || CAPABILITY_CLEANUP_TYPES[index] != 0
                || CAPABILITY_CLEANUP_RIGHTS[index] != 0 {
                return false;
            }

            if sender_waiter_physical_active(slot, physical) {
                let waiter: u64 = SENDER_WAITERS[index];
                if (state != ENDPOINT_LIVE && state != ENDPOINT_DRAINING)
                    || !thread_handle_shape_valid(waiter)
                    || waiter_occurrences(waiter) != 1 {
                    return false;
                }
            } else if SENDER_WAITERS[index] != 0 {
                return false;
            }
            physical += 1;
        }
        slot += 1;
    }
    return true;
}

pub unsafe fn init() -> u64 {
    if INITIALIZED != 0 {
        return 0;
    }
    let mut slot: usize = 0;
    while slot < MAX_ENDPOINTS {
        clear_slot(slot);
        GENERATIONS[slot] = 1;
        STATES[slot] = ENDPOINT_EMPTY;
        slot += 1;
    }
    POISONED = 0;
    INITIALIZED = 1;
    if !invariants_hold() {
        INITIALIZED = 0;
        return 0;
    }
    return 1;
}

// Creation binds the object to the receiver's exact CSpace generation and
// takes one CSpace child reference before publishing a reusable endpoint slot.
pub unsafe fn create(receiver_cspace_owner: u64) -> u64 {
    if INITIALIZED == 0
        || !cspace_is_live(receiver_cspace_owner)
        || !invariants_hold() {
        return 0;
    }
    let mut slot: usize = 0;
    while slot < MAX_ENDPOINTS && STATES[slot] != ENDPOINT_EMPTY {
        slot += 1;
    }
    if slot >= MAX_ENDPOINTS || retain_cspace(receiver_cspace_owner) == 0 {
        return 0;
    }
    clear_slot(slot);
    RECEIVER_CSPACE_OWNERS[slot] = receiver_cspace_owner;
    REFERENCES[slot] = 1;
    STATES[slot] = ENDPOINT_LIVE;
    if !invariants_hold() {
        clear_slot(slot);
        STATES[slot] = ENDPOINT_EMPTY;
        release_cspace(receiver_cspace_owner);
        return 0;
    }
    return make_handle(slot);
}

pub unsafe fn is_live(handle: u64) -> bool {
    return checked_live_endpoint(handle) < MAX_ENDPOINTS;
}

// Bounded kernel lifecycle scans use this accessor instead of reconstructing
// an endpoint identity from a reusable raw slot. Draining generations remain
// addressable until their final reference, waiter, and cleanup record retire.
pub unsafe fn handle_for_slot(slot: usize) -> u64 {
    if INITIALIZED == 0
        || POISONED != 0
        || slot >= MAX_ENDPOINTS
        || (STATES[slot] != ENDPOINT_LIVE
            && STATES[slot] != ENDPOINT_DRAINING) {
        return 0;
    }
    return make_handle(slot);
}

pub unsafe fn is_draining(handle: u64) -> bool {
    let slot: usize = checked_endpoint(handle);
    return slot < MAX_ENDPOINTS && STATES[slot] == ENDPOINT_DRAINING;
}

pub unsafe fn receiver_cspace_owner(handle: u64) -> u64 {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS {
        return 0;
    }
    return RECEIVER_CSPACE_OWNERS[slot];
}

pub unsafe fn reference_count(handle: u64) -> u32 {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS {
        return 0;
    }
    return REFERENCES[slot];
}

pub unsafe fn retain(handle: u64) -> u64 {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || !cspace_is_live(RECEIVER_CSPACE_OWNERS[slot])
        || REFERENCES[slot] == 0xffff_ffff
        || !invariants_hold() {
        return 0;
    }
    REFERENCES[slot] += 1;
    return 1;
}

// Releasing the final reference implicitly begins a normal drain. If waiters
// exist, the generation remains addressable only through cancellation APIs
// until every waiter has been taken. No new reference can be acquired then.
pub unsafe fn release(handle: u64) -> u64 {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || REFERENCES[slot] == 0
        || !invariants_hold() {
        return 0;
    }
    REFERENCES[slot] -= 1;
    if REFERENCES[slot] == 0 && STATES[slot] == ENDPOINT_LIVE {
        if !begin_drain(slot, ENDPOINT_CLOSE_NORMAL) {
            REFERENCES[slot] += 1;
            return 0;
        }
    }
    if STATES[slot] == ENDPOINT_DRAINING && !try_retire(slot) {
        return 0;
    }
    return 1;
}

// close and crash start deterministic draining but do not consume a caller's
// reference. Every retained reference must still be paired with release.
pub unsafe fn close(handle: u64) -> u64 {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS || !invariants_hold() {
        return 0;
    }
    if !begin_drain(slot, ENDPOINT_CLOSE_NORMAL) {
        return 0;
    }
    return 1;
}

pub unsafe fn crash(handle: u64) -> u64 {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS || !invariants_hold() {
        return 0;
    }
    if !begin_drain(slot, ENDPOINT_CLOSE_CRASH) {
        return 0;
    }
    return 1;
}

pub unsafe fn close_reason(handle: u64) -> u64 {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS || STATES[slot] != ENDPOINT_DRAINING {
        return ENDPOINT_CLOSE_NONE;
    }
    return CLOSE_REASONS[slot] as u64;
}

pub unsafe fn discarded_message_count(handle: u64) -> usize {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS || STATES[slot] != ENDPOINT_DRAINING {
        return 0;
    }
    return DISCARDED_MESSAGES[slot] as usize;
}

pub unsafe fn message_count(handle: u64) -> usize {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS {
        return 0;
    }
    return MESSAGE_LENGTHS[slot];
}

// Cancelled or close-discarded messages can own an already-created receiver
// capability. Such handles are never silently lost. They occupy bounded queue
// capacity until the lifecycle caller takes each one and closes it through the
// capability module.
pub unsafe fn pending_capability_cleanup_count(handle: u64) -> usize {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS {
        return 0;
    }
    return CAPABILITY_CLEANUP_LENGTHS[slot];
}

pub unsafe fn has_queue_capacity(handle: u64) -> bool {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS {
        return false;
    }
    return MESSAGE_LENGTHS[slot] + CAPABILITY_CLEANUP_LENGTHS[slot]
        < ENDPOINT_QUEUE_CAPACITY;
}

pub unsafe fn take_capability_cleanup(handle: u64) -> u64 {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || CAPABILITY_CLEANUP_LENGTHS[slot] == 0
        || !invariants_hold() {
        return 0;
    }
    let physical: usize = CAPABILITY_CLEANUP_HEADS[slot];
    let index: usize = queue_index(slot, physical);
    let cap: u64 = CAPABILITY_CLEANUP[index];
    if !escrow_record_valid(
        RECEIVER_CSPACE_OWNERS[slot],
        cap,
        CAPABILITY_CLEANUP_OBJECTS[index],
        CAPABILITY_CLEANUP_TYPES[index],
        CAPABILITY_CLEANUP_RIGHTS[index]
    ) || abort_close_for_owner(RECEIVER_CSPACE_OWNERS[slot], cap) == 0 {
        POISONED = 1;
        return 0;
    }
    if capability_cleanup_pop(slot) != cap {
        POISONED = 1;
        return 0;
    }
    if STATES[slot] == ENDPOINT_DRAINING && !try_retire(slot) {
        POISONED = 1;
        return 0;
    }
    if !invariants_hold() {
        POISONED = 1;
        return 0;
    }
    return cap;
}

pub unsafe fn enqueue(
    handle: u64,
    sender_process: u64,
    correlation: u64,
    scalar_payload: u64,
    destination_capability: u64
) -> u64 {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || MESSAGE_LENGTHS[slot] + CAPABILITY_CLEANUP_LENGTHS[slot]
            >= ENDPOINT_QUEUE_CAPACITY
        || !cspace_is_live(RECEIVER_CSPACE_OWNERS[slot])
        || !can_issue_operations(sender_process)
        || !process_handle_shape_valid(sender_process)
        || !capability_handle_shape_valid(destination_capability)
        || !invariants_hold() {
        return 0;
    }
    let mut destination_object: u64 = 0;
    let mut destination_type: u64 = 0;
    let mut destination_rights: u64 = 0;
    if destination_capability != 0
        && begin_close_for_owner(
            RECEIVER_CSPACE_OWNERS[slot],
            destination_capability,
            (&mut destination_object),
            (&mut destination_type),
            (&mut destination_rights)
        ) == 0 {
        return 0;
    }
    let physical: usize =
        (MESSAGE_HEADS[slot] + MESSAGE_LENGTHS[slot])
            % ENDPOINT_QUEUE_CAPACITY;
    let index: usize = queue_index(slot, physical);
    if MESSAGE_SENDERS[index] != 0
        || MESSAGE_CORRELATIONS[index] != 0
        || MESSAGE_PAYLOADS[index] != 0
        || MESSAGE_DESTINATION_CAPS[index] != 0
        || MESSAGE_DESTINATION_OBJECTS[index] != 0
        || MESSAGE_DESTINATION_TYPES[index] != 0
        || MESSAGE_DESTINATION_RIGHTS[index] != 0 {
        if destination_capability != 0
            && abort_close_for_owner(
                RECEIVER_CSPACE_OWNERS[slot],
                destination_capability
            ) == 0 {
            POISONED = 1;
        }
        return 0;
    }
    MESSAGE_SENDERS[index] = sender_process;
    MESSAGE_CORRELATIONS[index] = correlation;
    MESSAGE_PAYLOADS[index] = scalar_payload;
    MESSAGE_DESTINATION_CAPS[index] = destination_capability;
    MESSAGE_DESTINATION_OBJECTS[index] = destination_object;
    MESSAGE_DESTINATION_TYPES[index] = destination_type;
    MESSAGE_DESTINATION_RIGHTS[index] = destination_rights;
    MESSAGE_LENGTHS[slot] += 1;
    if !invariants_hold() {
        MESSAGE_LENGTHS[slot] -= 1;
        clear_message_cell(slot, physical);
        if destination_capability != 0
            && abort_close_for_owner(
                RECEIVER_CSPACE_OWNERS[slot],
                destination_capability
            ) == 0 {
            POISONED = 1;
        }
        return 0;
    }
    return 1;
}

// Read the current FIFO head without publishing its escrowed destination
// capability or mutating queue state. A syscall may therefore copy these four
// scalar words to user memory first; a recoverable copy fault leaves the exact
// message queued and the transferred capability inaccessible.
pub unsafe fn peek_head(
    handle: u64,
    sender_process: *mut u64,
    correlation: *mut u64,
    scalar_payload: *mut u64,
    destination_capability: *mut u64
) -> u64 {
    if sender_process as usize == 0
        || correlation as usize == 0
        || scalar_payload as usize == 0
        || destination_capability as usize == 0 {
        return 0;
    }
    volatile_store(sender_process, 0);
    volatile_store(correlation, 0);
    volatile_store(scalar_payload, 0);
    volatile_store(destination_capability, 0);
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || MESSAGE_LENGTHS[slot] == 0
        || !cspace_is_live(RECEIVER_CSPACE_OWNERS[slot])
        || !invariants_hold() {
        return 0;
    }
    let physical: usize = message_at(slot, 0);
    if physical >= ENDPOINT_QUEUE_CAPACITY {
        return 0;
    }
    let index: usize = queue_index(slot, physical);
    let sender: u64 = MESSAGE_SENDERS[index];
    let request_correlation: u64 = MESSAGE_CORRELATIONS[index];
    let payload: u64 = MESSAGE_PAYLOADS[index];
    let cap: u64 = MESSAGE_DESTINATION_CAPS[index];
    if cap != 0 && !escrow_record_valid(
        RECEIVER_CSPACE_OWNERS[slot],
        cap,
        MESSAGE_DESTINATION_OBJECTS[index],
        MESSAGE_DESTINATION_TYPES[index],
        MESSAGE_DESTINATION_RIGHTS[index]
    ) {
        POISONED = 1;
        return 0;
    }
    volatile_store(sender_process, sender);
    volatile_store(correlation, request_correlation);
    volatile_store(scalar_payload, payload);
    volatile_store(destination_capability, cap);
    return 1;
}

// Commit the exact current head after a successful peek/copyout transaction.
// The kernel is single-CPU with interrupts masked across the syscall, so no
// other queue mutation can occur between peek_head and this publication step.
pub unsafe fn commit_head(handle: u64) -> u64 {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || MESSAGE_LENGTHS[slot] == 0
        || !cspace_is_live(RECEIVER_CSPACE_OWNERS[slot])
        || !invariants_hold() {
        return 0;
    }
    let physical: usize = message_at(slot, 0);
    if physical >= ENDPOINT_QUEUE_CAPACITY {
        return 0;
    }
    let index: usize = queue_index(slot, physical);
    let cap: u64 = MESSAGE_DESTINATION_CAPS[index];
    if cap != 0
        && (!escrow_record_valid(
            RECEIVER_CSPACE_OWNERS[slot],
            cap,
            MESSAGE_DESTINATION_OBJECTS[index],
            MESSAGE_DESTINATION_TYPES[index],
            MESSAGE_DESTINATION_RIGHTS[index]
        ) || abort_close_for_owner(
            RECEIVER_CSPACE_OWNERS[slot],
            cap
        ) == 0) {
        POISONED = 1;
        return 0;
    }
    if !message_remove_at(slot, 0) {
        POISONED = 1;
        return 0;
    }
    if !invariants_hold() {
        POISONED = 1;
        return 0;
    }
    return 1;
}

// Compatibility wrapper retained for the Milestone 3 foundation harness.
pub unsafe fn dequeue(
    handle: u64,
    sender_process: *mut u64,
    correlation: *mut u64,
    scalar_payload: *mut u64,
    destination_capability: *mut u64
) -> u64 {
    if sender_process as usize == 0
        || correlation as usize == 0
        || scalar_payload as usize == 0
        || destination_capability as usize == 0 {
        return 0;
    }
    volatile_store(sender_process, 0);
    volatile_store(correlation, 0);
    volatile_store(scalar_payload, 0);
    volatile_store(destination_capability, 0);
    let mut sender: u64 = 0;
    let mut request_correlation: u64 = 0;
    let mut payload: u64 = 0;
    let mut cap: u64 = 0;
    if peek_head(
        handle,
        (&mut sender),
        (&mut request_correlation),
        (&mut payload),
        (&mut cap)
    ) == 0 || commit_head(handle) == 0 {
        return 0;
    }
    volatile_store(sender_process, sender);
    volatile_store(correlation, request_correlation);
    volatile_store(scalar_payload, payload);
    volatile_store(destination_capability, cap);
    return 1;
}

// Cancellation removes every matching queued message while preserving FIFO
// order among survivors. A process generation that has already exited remains
// a valid cancellation key, so these functions check handle shape, not liveness.
pub unsafe fn cancel_by_sender(handle: u64, sender_process: u64) -> usize {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || !process_handle_shape_valid(sender_process)
        || !invariants_hold() {
        return 0;
    }
    let mut removed: usize = 0;
    let mut position: usize = 0;
    while position < MESSAGE_LENGTHS[slot] {
        let physical: usize = message_at(slot, position);
        let index: usize = queue_index(slot, physical);
        if MESSAGE_SENDERS[index] == sender_process {
            if !capability_cleanup_enqueue(
                slot,
                MESSAGE_DESTINATION_CAPS[index],
                MESSAGE_DESTINATION_OBJECTS[index],
                MESSAGE_DESTINATION_TYPES[index],
                MESSAGE_DESTINATION_RIGHTS[index]
            ) {
                return 0;
            }
            if !message_remove_at(slot, position) {
                return 0;
            }
            removed += 1;
        } else {
            position += 1;
        }
    }
    return removed;
}

pub unsafe fn cancel_by_correlation(handle: u64, correlation: u64) -> usize {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS || !invariants_hold() {
        return 0;
    }
    let mut removed: usize = 0;
    let mut position: usize = 0;
    while position < MESSAGE_LENGTHS[slot] {
        let physical: usize = message_at(slot, position);
        let index: usize = queue_index(slot, physical);
        if MESSAGE_CORRELATIONS[index] == correlation {
            if !capability_cleanup_enqueue(
                slot,
                MESSAGE_DESTINATION_CAPS[index],
                MESSAGE_DESTINATION_OBJECTS[index],
                MESSAGE_DESTINATION_TYPES[index],
                MESSAGE_DESTINATION_RIGHTS[index]
            ) {
                return 0;
            }
            if !message_remove_at(slot, position) {
                return 0;
            }
            removed += 1;
        } else {
            position += 1;
        }
    }
    return removed;
}

pub unsafe fn cancel_by_sender_correlation(
    handle: u64,
    sender_process: u64,
    correlation: u64
) -> usize {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || !process_handle_shape_valid(sender_process)
        || !invariants_hold() {
        return 0;
    }
    let mut removed: usize = 0;
    let mut position: usize = 0;
    while position < MESSAGE_LENGTHS[slot] {
        let physical: usize = message_at(slot, position);
        let index: usize = queue_index(slot, physical);
        if MESSAGE_SENDERS[index] == sender_process
            && MESSAGE_CORRELATIONS[index] == correlation {
            if !capability_cleanup_enqueue(
                slot,
                MESSAGE_DESTINATION_CAPS[index],
                MESSAGE_DESTINATION_OBJECTS[index],
                MESSAGE_DESTINATION_TYPES[index],
                MESSAGE_DESTINATION_RIGHTS[index]
            ) {
                return 0;
            }
            if !message_remove_at(slot, position) {
                return 0;
            }
            removed += 1;
        } else {
            position += 1;
        }
    }
    return removed;
}

// A receiver can block only after observing an empty message queue. Registration
// is global-unique: the same full TCB generation cannot wait on two endpoints
// or appear in both the receive and send wait sets.
pub unsafe fn register_receiver_waiter(handle: u64, thread_handle: u64) -> u64 {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || !cspace_is_live(RECEIVER_CSPACE_OWNERS[slot])
        || MESSAGE_LENGTHS[slot] != 0
        || RECEIVER_WAITERS[slot] != 0
        || !thread_handle_shape_valid(thread_handle)
        || waiter_occurrences(thread_handle) != 0
        || !invariants_hold() {
        return 0;
    }
    RECEIVER_WAITERS[slot] = thread_handle;
    if !invariants_hold() {
        RECEIVER_WAITERS[slot] = 0;
        return 0;
    }
    return 1;
}

pub unsafe fn take_receiver_waiter(handle: u64) -> u64 {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS || !invariants_hold() {
        return 0;
    }
    let waiter: u64 = RECEIVER_WAITERS[slot];
    RECEIVER_WAITERS[slot] = 0;
    return waiter;
}

// A sender waiter is accepted only after the bounded queue is observed full.
// Dequeue/cancel opens capacity but does not wake a waiter implicitly.
pub unsafe fn register_sender_waiter(handle: u64, thread_handle: u64) -> u64 {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || !cspace_is_live(RECEIVER_CSPACE_OWNERS[slot])
        || MESSAGE_LENGTHS[slot] + CAPABILITY_CLEANUP_LENGTHS[slot]
            != ENDPOINT_QUEUE_CAPACITY
        || SENDER_WAITER_LENGTHS[slot] >= MAX_BLOCKED_SENDERS
        || !thread_handle_shape_valid(thread_handle)
        || waiter_occurrences(thread_handle) != 0
        || !invariants_hold() {
        return 0;
    }
    let physical: usize =
        (SENDER_WAITER_HEADS[slot] + SENDER_WAITER_LENGTHS[slot])
            % MAX_BLOCKED_SENDERS;
    let index: usize = queue_index(slot, physical);
    if SENDER_WAITERS[index] != 0 {
        return 0;
    }
    SENDER_WAITERS[index] = thread_handle;
    SENDER_WAITER_LENGTHS[slot] += 1;
    if !invariants_hold() {
        SENDER_WAITER_LENGTHS[slot] -= 1;
        SENDER_WAITERS[index] = 0;
        return 0;
    }
    return 1;
}

pub unsafe fn take_sender_waiter(handle: u64) -> u64 {
    let slot: usize = checked_live_endpoint(handle);
    if slot >= MAX_ENDPOINTS || !invariants_hold() {
        return 0;
    }
    return sender_waiter_pop(slot);
}

pub unsafe fn sender_waiter(handle: u64) -> u64 {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS || SENDER_WAITER_LENGTHS[slot] == 0 {
        return 0;
    }
    return sender_waiter_at(slot, 0);
}

// Exact waiter lookup is generation-aware because both the endpoint and TCB
// arguments are complete handles. It is valid during drain so cancellation can
// prove that it is unlinking the same request that originally blocked.
pub unsafe fn waiter_matches(
    handle: u64,
    kind: u64,
    thread_handle: u64
) -> bool {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || !thread_handle_shape_valid(thread_handle)
        || (kind != ENDPOINT_WAITER_RECEIVER
            && kind != ENDPOINT_WAITER_SENDER) {
        return false;
    }
    if kind == ENDPOINT_WAITER_RECEIVER {
        return RECEIVER_WAITERS[slot] == thread_handle;
    }
    let mut position: usize = 0;
    while position < SENDER_WAITER_LENGTHS[slot] {
        if sender_waiter_at(slot, position) == thread_handle {
            return true;
        }
        position += 1;
    }
    return false;
}

// Remove one exact waiter while preserving the FIFO order of all other blocked
// senders. Unlike take_cancelled_waiter this works before or during endpoint
// drain and never selects a different TCB merely because it is at the head.
pub unsafe fn remove_waiter(
    handle: u64,
    kind: u64,
    thread_handle: u64
) -> u64 {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || !waiter_matches(handle, kind, thread_handle)
        || !invariants_hold() {
        return 0;
    }
    let mut removed: u64 = 0;
    if kind == ENDPOINT_WAITER_RECEIVER {
        RECEIVER_WAITERS[slot] = 0;
        removed = thread_handle;
    } else {
        let mut position: usize = 0;
        while position < SENDER_WAITER_LENGTHS[slot]
            && sender_waiter_at(slot, position) != thread_handle {
            position += 1;
        }
        removed = sender_waiter_remove_at(slot, position);
    }
    if removed != thread_handle {
        POISONED = 1;
        return 0;
    }
    if STATES[slot] == ENDPOINT_DRAINING && !try_retire(slot) {
        POISONED = 1;
        return 0;
    }
    if !invariants_hold() {
        POISONED = 1;
        return 0;
    }
    return removed;
}

pub unsafe fn receiver_waiter(handle: u64) -> u64 {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS {
        return 0;
    }
    return RECEIVER_WAITERS[slot];
}

pub unsafe fn sender_waiter_count(handle: u64) -> usize {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS {
        return 0;
    }
    return SENDER_WAITER_LENGTHS[slot];
}

pub unsafe fn cancelled_waiter_count(handle: u64) -> usize {
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS || STATES[slot] != ENDPOINT_DRAINING {
        return 0;
    }
    let mut count: usize = SENDER_WAITER_LENGTHS[slot];
    if RECEIVER_WAITERS[slot] != 0 {
        count += 1;
    }
    return count;
}

// Cancellation order is fixed: the sole receiver first, then blocked senders
// in FIFO order. kind_out tells the caller which blocked operation to finish.
// Taking the last waiter may retire the endpoint if all references are gone.
pub unsafe fn take_cancelled_waiter(
    handle: u64,
    kind_out: *mut u64
) -> u64 {
    volatile_store(kind_out, ENDPOINT_WAITER_NONE);
    let slot: usize = checked_endpoint(handle);
    if slot >= MAX_ENDPOINTS
        || STATES[slot] != ENDPOINT_DRAINING
        || !invariants_hold() {
        return 0;
    }
    let mut waiter: u64 = RECEIVER_WAITERS[slot];
    if waiter != 0 {
        RECEIVER_WAITERS[slot] = 0;
        volatile_store(kind_out, ENDPOINT_WAITER_RECEIVER);
    } else {
        waiter = sender_waiter_pop(slot);
        if waiter != 0 {
            volatile_store(kind_out, ENDPOINT_WAITER_SENDER);
        }
    }
    if waiter != 0 && !try_retire(slot) {
        return 0;
    }
    return waiter;
}

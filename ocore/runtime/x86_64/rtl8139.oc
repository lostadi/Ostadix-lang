module runtime::rtl8139;

// Bounded polling RTL8139 C-mode driver for the explicit native QEMU profile.
// DMA buffers live in identity-mapped, supervisor-owned low memory. This is
// not a physical-device isolation, IOMMU, hotplug, or shared-driver contract.
// Register behavior is checked against QEMU hw/net/rtl8139.c.
const RX_BYTES: usize = 8192;
const FRAME_BYTES: usize = 1536;
static mut RX: [u8; 10256] = [0; 10256];
static mut TX: [u8; 6144] = [0; 6144];
static mut IO: u16 = 0;
static mut PCI: u32 = 0;
static mut READ_OFFSET: usize = 0;
static mut NEXT_TX: usize = 0;
static mut READY: u8 = 0;
static mut CONFIGURED: u8 = 0;

unsafe fn pci_read(address: u32, offset: u32) -> u32 {
    outl(0xcf8, 0x8000_0000 | address | offset);
    return inl(0xcfc);
}

unsafe fn pci_write(address: u32, offset: u32, value: u32) -> void {
    outl(0xcf8, 0x8000_0000 | address | offset);
    outl(0xcfc, value);
}

pub unsafe fn init(mac: *mut u8) -> u64 {
    if READY != 0 || mac as usize == 0 { return 0; }
    let mut device: u32 = 0;
    let mut found: u8 = 0;
    while device < 32 && found == 0 {
        let mut function: u32 = 0;
        while function < 8 && found == 0 {
            let address: u32 = (device << 11) | (function << 8);
            if pci_read(address, 0) == 0x8139_10ec {
                PCI = address;
                found = 1;
            }
            function += 1;
        }
        device += 1;
    }
    if found == 0 { return 0; }
    let bar: u32 = pci_read(PCI, 0x10);
    if (bar & 1) == 0 || (bar & 0xffff_fffc) == 0
        || (bar & 0xffff_fffc) > 0xff00 { return 0; }
    IO = (bar & 0xfffc) as u16;
    // Only the command half is written; status is write-one-to-clear.
    pci_write(PCI, 4, (pci_read(PCI, 4) & 0xffff) | 5);
    CONFIGURED = 1;
    outb(IO + 0x52, 0);
    outb(IO + 0x37, 0x10);
    let mut retry: usize = 0;
    while (inb(IO + 0x37) & 0x10) != 0 && retry < 100000 {
        retry += 1;
    }
    if (inb(IO + 0x37) & 0x10) != 0 { return 0; }
    let rx_address: usize = (&mut RX[0]) as usize;
    let tx_address: usize = (&mut TX[0]) as usize;
    if rx_address > 0xffff_d7ef || tx_address > 0xffff_e7ff { return 0; }
    let mut index: usize = 0;
    while index < 6 {
        volatile_store(mac + index, inb(IO + index as u16));
        index += 1;
    }
    outw(IO + 0x3c, 0);
    outw(IO + 0x3e, 0xffff);
    outl(IO + 0x30, rx_address as u32);
    outw(IO + 0x38, 0xfff0);
    // 8 KiB wrapping RX ring, unlimited DMA burst, no FIFO threshold,
    // accept own unicast and broadcast; malformed frames are not admitted.
    outl(IO + 0x44, 0x0000_e70a);
    outl(IO + 0x40, 0x0300_0700);
    index = 0;
    while index < 4 {
        outl(IO + 0x20 + (index * 4) as u16,
            (tx_address + index * FRAME_BYTES) as u32);
        index += 1;
    }
    READ_OFFSET = 0;
    NEXT_TX = 0;
    outb(IO + 0x37, 0x0c);
    READY = 1;
    return 1;
}

// 1 means the device accepted this transmission; it is not peer receipt.
pub unsafe fn send(frame: *const u8, length: usize) -> u64 {
    if READY == 0 || frame as usize == 0 || length < 60
        || length > 1514 { return 0; }
    let slot: usize = NEXT_TX;
    let status_port: u16 = IO + 0x10 + (slot * 4) as u16;
    if (inl(status_port) & 0x2000) == 0 { return 0; }
    let mut index: usize = 0;
    while index < length {
        TX[slot * FRAME_BYTES + index] = volatile_load(frame + index);
        index += 1;
    }
    outl(status_port, length as u32);
    NEXT_TX = (slot + 1) & 3;
    return 1;
}

unsafe fn ring_byte(offset: usize) -> u8 {
    return volatile_load((&RX[0]) + (offset & (RX_BYTES - 1)));
}

// Copies one complete CRC-stripped Ethernet frame. Every ring access remains
// bounded even when the descriptor or payload straddles the ring boundary.
pub unsafe fn receive(frame: *mut u8, capacity: usize) -> usize {
    if READY == 0 || frame as usize == 0 || capacity < 1514
        || (inb(IO + 0x37) & 1) != 0 { return 0; }
    let status: u16 = (ring_byte(READ_OFFSET) as u16)
        | ((ring_byte(READ_OFFSET + 1) as u16) << 8);
    let length: usize = (ring_byte(READ_OFFSET + 2) as usize)
        | ((ring_byte(READ_OFFSET + 3) as usize) << 8);
    if length < 4 || length > 1518 {
        // Invalid ring length cannot be used to advance a DMA cursor.
        abort();
        return 0;
    }
    let payload: usize = length - 4;
    let mut index: usize = 0;
    if (status & 1) != 0 {
        while index < payload {
            volatile_store(frame + index, ring_byte(READ_OFFSET + 4 + index));
            index += 1;
        }
    }
    READ_OFFSET = (READ_OFFSET + length + 7) & 0xffff_fffc;
    READ_OFFSET = READ_OFFSET & (RX_BYTES - 1);
    outw(IO + 0x38, (READ_OFFSET as u16) - 16);
    outw(IO + 0x3e, 0x0053);
    if (status & 1) == 0 { return 0; }
    return payload;
}

pub unsafe fn online() -> bool { return READY != 0; }
pub unsafe fn was_configured() -> bool { return CONFIGURED != 0; }

// Idempotent failure retirement, including partial initialization or a broken
// RX ring. This disables this dedicated emulated device; it does not claim
// successful application drain, physical reset, or IOMMU/DMA containment.
pub unsafe fn abort() -> u64 {
    READY = 0;
    if CONFIGURED == 0 { return 1; }
    outw(IO + 0x3c, 0);
    outb(IO + 0x37, 0);
    pci_write(PCI, 4, (pci_read(PCI, 4) & 0xffff) & 0xfffb);
    if (inb(IO + 0x37) & 0x0c) != 0 || (pci_read(PCI, 4) & 4) != 0 {
        return 0;
    }
    return 1;
}

// Called only after the explicit application-level drain confirmation.
pub unsafe fn quiesce() -> u64 {
    if READY == 0 { return 0; }
    let mut retry: usize = 0;
    let mut complete: u8 = 0;
    while retry < 100000 && complete == 0 {
        complete = 1;
        let mut slot: usize = 0;
        while slot < 4 {
            if (inl(IO + 0x10 + (slot * 4) as u16) & 0x2000) == 0 {
                complete = 0;
            }
            slot += 1;
        }
        retry += 1;
    }
    if complete == 0 { return 0; }
    return abort();
}

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "~/.config/opencode/instructions/ostadix.md"
  ],
  "permission": {
    "skill": {
      "*": "allow",
      "olang*": "allow",
      "ostadix*": "allow"
    }
  },

  "mcp": {
    "olang": {
      "type": "local",
      "command": ["/Users/ustad/.local/bin/ostadix-mcp-compat"],
      "enabled": true,
      "timeout": 600000,
      "env": {
        "O_LANG_ROOT": "/Users/ustad/Ostadix-lang",
        "O_BACKENDS_DIR": "/Users/ustad/Ostadix-lang/backends",
        "PATH": "/Users/ustad/.local/bin:/Users/ustad/Ostadix-lang/target/release:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  },
}
